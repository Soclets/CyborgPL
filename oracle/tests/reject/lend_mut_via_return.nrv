fn grow [@y] [lent.mut @y 'xs': list[int32]] -> lent.mut @y list[int32] { list.append[lend.mut 'xs', value 9]; return lend.mut 'xs'; }
fn two [lent.mut 'a': list[int32], lent 'b': list[int32]] {
    cord::print.useful[list.length[lend 'a'] plus list.length[lend 'b'], newln];
}
MAIN {
    let mut 'u': list[int32] = [1, 2];
    two[grow[lend.mut 'u'], lend 'u'];
}
