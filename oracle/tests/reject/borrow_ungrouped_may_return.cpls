# Without `@x`, a call's result borrows whatever the body may hand back, on any path (Precog reads
# the body). This run returns 'a', but 'b' could have been returned, so giving 't' away is refused.
fn longer [lent 'a': list[int32], lent 'b': list[int32]] --> lent list[int32] {
    if list.length[lend 'a'] >/== list.length[lend 'b'] { return lend 'a'; }
    return lend 'b';
}
MAIN {
    let 's': list[int32] = [1, 2, 3];
    let 't': list[int32] = [4,];
    let 'r' := longer[lend 's', lend 't'];
    let 'g' := give 't';
    std::print.useful.stdout[list.length[lend 'r'], \n];
}
