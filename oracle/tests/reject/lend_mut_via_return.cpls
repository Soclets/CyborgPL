fn grow @y [lent.mut@y 'xs': list[int32]] --> lent.mut@y list[int32] { list.append[lend.mut 'xs', 9]; return lend.mut 'xs'; }
fn two [lent.mut 'a': list[int32], lent 'b': list[int32]] {
    std::print.useful.stdout[list.length[lend 'a'] + list.length[lend 'b'], \n];
}
MAIN {
    let mut 'u': list[int32] = [1, 2];
    two[grow[lend.mut 'u'], lend 'u'];
}
