# A lend satisfies a pointer in an asm binding (owner, 2026-09-30: a): it checks, then the oracle
# refuses to run assembly, as for any asm block.
MAIN {
    'text' := "Hello, world!" ++ \n;
    'fd': int64 = 1;
    'len': int64 = 14;
    nocheck inline.ASM {
        mov x16, #4
        svc #0x80
    } with ['fd' -> x0, lend 'text' -> x1, 'len' -> x2, 'n' <- x0, clobber x16];
}
