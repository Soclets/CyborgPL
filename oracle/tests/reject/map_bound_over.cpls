MAIN {
    mut 'small': map[str.utf8[1, 3 bytes], int32[0, 10]][0, 2] = map.empty;
    map.set[lend.mut 'small', "ab", 5];
    map.set[lend.mut 'small', "cd", 7];
    'n' := map.length[lend 'small'];
    'tiny': int8 = 'n';                          # proven by the bound: at most 2
    std::printu.stdout['tiny', \n];
    map.set[lend.mut 'small', "ef", 1];              # a third: does not fit [0, 2]
}
