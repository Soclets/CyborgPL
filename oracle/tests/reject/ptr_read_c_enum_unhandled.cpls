# ptr.read of a C enum from C can fail out_of_range (2026-09-28)
layout.c enum Mode { emacs = 0 }
extern fn malloc ['bytes': uint64] -> ptr.mut[Mode];
fn f ['p': ptr[Mode]] -> int32 {
    nocheck 'm' := ptr.read['p'];
    return 0;
}
MAIN {
    nocheck 'mem' := malloc[4];
    nocheck 'x' := f['mem'];
}
