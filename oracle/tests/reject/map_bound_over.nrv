MAIN {
    let mut 'small': map[str.utf8[min 1, max 3 bytes], int32[min 0, max 10]][min 0, max 2] = map.empty;
    map.set[lend.mut 'small', "ab", 5];
    map.set[lend.mut 'small', "cd", 7];
    let 'n' := map.length[lend 'small'];
    let 'tiny': int8 = 'n';                          # proven by the bound: at most 2
    cord::print.useful['tiny', newln];
    map.set[lend.mut 'small', "ef", 1];              # a third: does not fit [0, 2]
}
