        errors::error[name = "bound_not_kept", means = "A value can fall outside the `min:` and `max:` bounds of its type.", tests = ["bin_bound_printed", "c_struct_range_out", "map_value_out_of_range", "one_ended_below", "percent_out_of_bounds", "range_assign_out", "range_field_out", "range_reassign_out",]],
        errors::error[name = "bound_outside_type", means = "A bound written on a type lies outside what the type itself holds.", tests = ["range_bound_below_unsigned", "range_bound_outside_type",]],
        errors::error[name = "bound_wrong_type", means = "A bound is written in another type's values, such as fractions on an integer.", tests = ["range_bin_bounds_on_int",]],
        errors::error[name = "length_bound_not_kept", means = "A list, map or text can be longer or shorter than its length bound allows.", tests = ["bound_append_over", "bound_too_short", "map_bound_over", "text_bound_graphemes", "text_bound_over",]],
        errors::error[name = "length_bound_on_array", means = "A length bound is put on an array; it belongs on a list.", tests = ["bound_on_array",]],
        errors::error[name = "bound_unit_unsaid", means = "A text's length bound does not say what it counts.", tests = ["text_bound_no_unit",]],
        errors::error[name = "check_not_enough", means = "A `check` does not cover what the statement needs; the guardrail is not enough.", tests = ["check_fails",]],
        errors::error[name = "check_misplaced", means = "`check` or `no_cheat` stands somewhere other than in front of a statement.", tests = ["check_bare", "check_in_value", "check_on_fn", "check_on_fn_in_body", "no_cheat_in_value",]],
        errors::error[name = "two_tiers", means = "A statement has two check tiers; it takes one.", tests = ["check_nocheck",]],
        errors::error[name = "tier_words_order", means = "Check words in front of a statement are in the wrong order.", tests = ["for_no_cheat_order", "no_cheat_before_check", "no_cheat_beside_tier",]],
        errors::error[name = "needs_no_check", means = "Something nothing can be proven about, such as assembly or a raw pointer read, is not marked `no_check`.", tests = ["asm_signatar_unmarked", "asm_without_nocheck", "print_format_nonliteral", "ptr_cast_needs_nocheck", "ptr_read_without_nocheck", "union_read_unchecked",]],
        errors::error[name = "no_check_lied", means = "Code marked `no_check` did what it was vouched never to do, such as dividing by zero.", tests = ["no_checks_lied", "nocheck_lied", "ptr_read_null_lied", "ptr_read_past_end_lied",]],
        errors::error[name = "cnc::needs_no_check", means = "A C call, or a read or write of C's variable, is not marked `no_check`.", tests = ["c_header_call_needs_no_check", "extern_read_checked", "extern_without_nocheck", "extern_write_checked",]],
        errors::error[name = "cnc::c_capitalized", means = "`C` is written in lowercase in `incl.C`, `extern.C` or `layout.C`.", tests = ["c_header_lowercase", "extern_lowercase_c", "layout_lowercase_c",]],
        errors::error[name = "cnc::header_not_found", means = "A C header named by `incl.C` cannot be found or read.", tests = ["c_header_missing_local", "c_header_missing_system",]],
        errors::error[name = "cnc::opaque_struct_held", means = "An opaque C struct is held, built or measured; it is only pointed at.", tests = ["c_header_opaque_built", "c_header_opaque_held", "c_header_opaque_size",]],
        errors::error[name = "cnc::pointer_target_wrong", means = "A C function is given a pointer to a different type than it wants.", tests = ["c_header_opaque_mixed",]],
        errors::error[name = "cnc::c_lib_name_form", means = "A C library in the manifest is named without `lib` or a file ending.", tests = ["c_lib_named_file",]],
        errors::error[name = "cnc::extern_language_unsaid", means = "An `extern` does not name its language, as `extern.C` does.", tests = ["c_rename_needs_c", "extern_no_language",]],
        errors::error[name = "cnc::c_str_unknown", means = "A C string operation is named that does not exist.", tests = ["c_str_unknown",]],
        errors::error[name = "cnc::c_str_counted_in_bytes", means = "A C string's bound counts graphemes; C strings are counted in bytes.", tests = ["cstr_bound_graphemes",]],
        errors::error[name = "cnc::c_str_zero_unsaid", means = "A C string's bound does not say whether its closing zero counts.", tests = ["cstr_bound_needs_zero",]],
        errors::error[name = "cnc::c_type_unknown", means = "A `C.` type is named that is not one of C's machine-sized types.", tests = ["c_type_unknown",]],
        errors::error[name = "cnc::c_enum_carries_data", means = "A `layout.C` enum case carries data; C's cases carry none.", tests = ["c_enum_data",]],
        errors::error[name = "cnc::c_enum_number_missing", means = "A `layout.C` enum case does not say its number.", tests = ["c_enum_number_missing",]],
        errors::error[name = "cnc::c_enum_number_twice", means = "Two cases of a `layout.C` enum have the same number.", tests = ["c_enum_same_number",]],
        errors::error[name = "cnc::numbered_enum_not_c", means = "A plain enum gives its cases numbers; only a `layout.C` enum has them.", tests = ["enum_number_not_c",]],
        errors::error[name = "cnc::cannot_cross_to_c", means = "A type that cannot cross to C, such as a generic, a bounded number or a C enum, is given to C.", tests = ["c_var_c_enum", "callback_c_enum", "generic_to_c", "range_to_c",]],
        errors::error[name = "cnc::not_c_shaped", means = "A value given to or from C is not C-shaped, such as text or a non-C field.", tests = ["callback_str_param", "extern_not_c_shaped", "extern_str_param", "layout_c_bad_field",]],
        errors::error[name = "cnc::not_layout_c", means = "A struct or enum given to C is not `layout.C`.", tests = ["enum_not_c", "extern_struct_not_layout",]],
        errors::error[name = "cnc::unknown_layout", means = "A layout other than `layout.C` is named.", tests = ["layout_not_c",]],
        errors::error[name = "cnc::lent_across_c", means = "A C function or callback takes a `lent` parameter; C passes values or pointers.", tests = ["callback_lent_param", "extern_lent_param",]],
        errors::error[name = "cnc::c_cannot_fail", means = "A C function or callback is declared to fail; C has no failures.", tests = ["callback_fails", "extern_fail",]],
        errors::error[name = "cnc::callback_captures", means = "A function given to C as a callback captures variables; C has nowhere to keep them.", tests = ["callback_with_capture",]],
        errors::error[name = "cnc::extern_with_definition", means = "An `extern.C` declaration has a body or a value; C defines it.", tests = ["extern_with_body", "extern_with_value",]],
        errors::error[name = "cnc::c_variable_read_only", means = "A read-only C variable is written.", tests = ["extern_write_readonly",]],
        errors::error[name = "cnc::bits_outside_layout", means = "A bit-field is used outside a `layout.C` struct's fields.", tests = ["bits_outside_layout",]],
        errors::error[name = "cnc::bit_field_too_wide", means = "A bit-field is wider than its type.", tests = ["bits_too_wide",]],
        errors::error[name = "unicode::case_mark_kind_unknown", means = "A `case` mark names a kind it does not cover.", tests = ["case_bad_kind",]],
        errors::error[name = "unicode::names_differ_only_in_case", means = "Two names differ only in case where one is `case.any`, so they would be one name.", tests = ["case_differ_only",]],
        errors::error[name = "unicode::case_marks_disagree", means = "One item is marked both `case.any` and `case.exact`.", tests = ["case_disagree",]],
        errors::error[name = "unicode::case_mark_misplaced", means = "A `case` mark is not where it belongs: a file's at its top, a kind mark in `kit.cy`.", tests = ["case_file_not_first", "case_kinds_in_module",]],
        errors::error[name = "unicode::case_mark_order", means = "A `case` mark comes before `pub`; `pub` comes first.", tests = ["case_pub_after",]],
        errors::error[name = "unicode::no_single_code", means = "A grapheme is made from a code that makes no single grapheme.", tests = ["grapheme_from_code",]],
        errors::error[name = "mcps::channel_form", means = "A channel is not made as `channel.empty` into a declared `channel[T]`.", tests = ["channel_empty_untyped", "channel_type_as_value",]],
        errors::error[name = "mcps::task_returns", means = "A `concur` task uses `return`; a task is a block, not a function.", tests = ["concur_return",]],
        errors::error[name = "mcps::detached_lend", means = "A detached task borrows something; no scope protects a detached task.", tests = ["detached_lend",]],
        errors::error[name = "mcps::send_needs_give", means = "A value sent on a channel is lent; it is given, never lent.", tests = ["send_lend",]],
        errors::error[name = "mcps::seq_and_para", means = "A loop says both `seq` and `para`.", tests = ["for_seq_and_para",]],
        errors::error[name = "money::deci_mixed", means = "A deci meets another number family, or a deci of another width, without a conversion.", tests = ["deci_family_mix", "deci_widths_mix",]],
        errors::error[name = "money::power_not_whole", means = "A deci is raised to a fractional or deci exponent; the exponent is whole.", tests = ["deci_fractional_power", "deci_power_deci_exponent",]],
        errors::error[name = "money::bin_to_deci_unsaid", means = "A bin converts to a deci without saying which value it means.", tests = ["deci_from_bin_bare",]],
        errors::error[name = "money::too_many_digits", means = "A deci literal has more digits than its width holds.", tests = ["deci_literal_digits", "typed_deci_too_many_digits",]],
        errors::error[name = "money::too_many_places", means = "A value has more decimal places than its type keeps; round it on purpose.", tests = ["places_literal_over", "places_not_rounded",]],
        errors::error[name = "money::places_on_bin", means = "Decimal places are asked of a bin; only a deci or percent keeps places.", tests = ["places_on_bin",]],
        errors::error[name = "money::exact_into_bin", means = "An `exactly` literal goes into a bin, which cannot hold it exactly.", tests = ["exact_into_bin",]],
        errors::error[name = "money::exactly_form", means = "`exactly` is followed by something other than a number.", tests = ["exactly_text",]],
        errors::error[name = "money::exactly_needed", means = "A decimal literal for a deci is written without `exactly`.", tests = ["typed_literal_bin_as_deci",]],
        errors::error[name = "money::percent_mixed", means = "A percent meets another number family; it is a family of its own.", tests = ["percent_mixed",]],
        errors::error[name = "money::percent_unsized", means = "A written percent does not name its number type.", tests = ["percent_unsized",]],
        errors::error[name = "ai::brain_mixed", means = "A brain float meets another number family without a conversion.", tests = ["brain_into_bin", "brain_mixed_bin",]],
        errors::error[name = "ai::brain_width", means = "A brain float is named in a width other than `brain16`.", tests = ["brain_width",]],
        errors::error[name = "wsmw::no_such_width", means = "A `not_std.` type names no integer, or one past the widest there is.", tests = ["std_not_a_type", "std_too_wide",]],
        errors::error[name = "wsmw::standard_width", means = "A `not_std.` type names a standard width, which is written plainly.", tests = ["std_on_standard",]],
