# Error names, one per kind of error (owner, 2026-10-22/24). DRAFT by compiler claude, for design claude's review.
errors::table[
    errors = [
        errors::error[name = "old_spelling", means = "The program uses a spelling the language has replaced; the message names the one to write.", tests = ["bare_int_old", "base_word_old", "bit_ampersand", "bound_max_as_value", "bound_old_spelling", "case_old_spelling", "collection_old_word", "compound_change_old", "decimals_old", "div_trunc_std_moved", "duration_seconds_old", "else_if_bare", "empty_quotes", "for_loop_chain", "for_no_cheat_inside", "func_keyword", "generic_old_form", "gives_renamed", "increment_old", "level_old_spelling", "limb_root_old", "lte_retired", "neg_word_old", "neuron_word_old", "no_cheat_old", "not_glued", "old_auto_newline", "old_backslash_n", "old_bang_cheat", "old_bang_check", "old_bang_mut", "old_bang_not", "old_bang_shadow", "old_cord_path", "old_ge", "old_inline_assembly", "old_inline_s", "old_le", "old_long_arrow", "old_ne", "old_nocheck", "old_rust_name", "old_std_i", "old_two_long_arrows", "op_amp_undeclared", "op_bang_undeclared", "op_chevron_reserved", "op_pipe_undeclared", "op_symbol_decl", "op_value_minus", "pow_symbol_old", "printf_renamed", "printu_renamed", "pub_limb_old_spelling", "range_old_spelling", "round_bare", "round_floor_old", "simd_count_bare", "slice_old_spelling", "std_underscore_old", "stdkit_old_spelling", "strike_word_old", "sym_and_old", "sym_and_then_old", "sym_at_least_old", "sym_at_most_old", "sym_div_old", "sym_equal_old", "sym_exact_old", "sym_lend_mut_old", "sym_lend_old", "sym_mod_old", "sym_not_equal_old", "sym_or_else_old", "sym_ptr_const_old", "sym_ptr_mut_old", "sym_ptr_read_old", "sym_ptr_write_old", "times_symbol_old", "type_name_old", "while_keyword", "wrap_old",]],
        errors::error[name = "old_file_name", means = "A file has a name from an earlier version of the language; the message names what to rename it to.", tests = ["cyr_manifest_old", "old_build_name", "old_ending_cpls", "old_ending_nrv", "old_ending_zg", "old_manifest_kinesin", "old_manifest_name", "old_manifest_ricochet", "old_root_neuron", "old_root_strike",]],
        errors::error[name = "spelling_removed", means = "The spelling was taken out of the language and is not written any more.", tests = ["bare_marks_gone", "lang_prefix", "strict_gone", "var_keyword",]],
        errors::error[name = "foreign_spelling", means = "The program uses another language's spelling; CyborgPL writes it differently, as the message shows.", tests = ["base_prefix_0x", "module_include_line", "module_mod_keyword", "rust_string", "rust_usize",]],
        errors::error[name = "unexpected_text", means = "The text here does not fit the language's grammar; the message says what was expected.", tests = ["concise_decoded_error", "for_without_in", "range_bound_markers", "seq_after_perm", "size_of_alone", "temp_after_name",]],
        errors::error[name = "call_in_brackets", means = "A call is written with `[ ]`; a call takes `( )`, and `[ ]` describes or holds something.", tests = ["call_in_brackets", "fill_in_brackets", "kit_call_in_brackets",]],
        errors::error[name = "parens_for_brackets", means = "`( )` is written where `[ ]` belongs, as for parameters, positions or building a struct.", tests = ["definition_in_parens", "position_in_parens", "struct_in_parens",]],
        errors::error[name = "call_without_parens", means = "A call is written without its `( )`.", tests = ["call_without_bracket",]],
        errors::error[name = "braces_need_commas", means = "Items inside braces, such as enum cases or struct fields, are not separated by `,`.", tests = ["c_enum_no_comma", "enum_no_comma", "level_no_comma", "struct_no_comma",]],
        errors::error[name = "bad_comment", means = "A `#` starts something that is not one of the comment forms.", tests = ["bad_comment_form", "bad_comment_suffix",]],
        errors::error[name = "unclosed_block", means = "A block opened with `{` is never closed with `}`.", tests = ["extern_block_unclosed",]],
        errors::error[name = "space_missing", means = "A space the grammar needs, such as after `->` or before a borrow group, is missing.", tests = ["generic_no_space_arrow", "lifetime_glued",]],
        errors::error[name = "needs_parentheses", means = "Operators with no settled order between them are mixed; parentheses must say how they group.", tests = ["bit_mixed_needs_parens", "mod_beside_cmp", "mod_mixed", "mod_trunc_beside", "no_precedence", "not_cmp", "op_next_to_plus", "op_no_precedence",]],
        errors::error[name = "comparisons_chained", means = "Comparisons are chained, as in `1 < 2 < 3`; they do not chain.", tests = ["chained_cmp",]],
        errors::error[name = "values_side_by_side", means = "Two values stand next to each other with no operator between them.", tests = ["number_next_to_text", "two_bare_numbers",]],
        errors::error[name = "text_joined_without_concat", means = "Two texts are written side by side; text is joined with `concat`.", tests = ["join_outside_bracket", "join_outside_bracket_newline",]],
        errors::error[name = "assignment_in_value", means = "`=` appears inside a value; assignment is a statement and equality is `equal_to`.", tests = ["eq_in_value",]],
        errors::error[name = "bad_digit", means = "A number has a digit its base does not have, such as 2 in binary.", tests = ["base_binary_bad_digit", "base_hex_bad_digit", "base_octal_bad_digit",]],
        errors::error[name = "digit_grouping", means = "Digits are grouped wrongly; only a single `_` between digits groups them.", tests = ["base_grouping", "comma_grouping",]],
        errors::error[name = "leading_zero", means = "A number is written with leading zeros.", tests = ["leading_zero",]],
        errors::error[name = "declaration_form", means = "A declaration is written in the wrong shape, such as a missing `let` or the type before the name.", tests = ["let_chain", "let_missing", "mut_after_name", "type_before_name", "walrus_with_type",]],
        errors::error[name = "change_unmarked", means = "A variable is changed without the word `change`.", tests = ["assign_needs_change", "eq_without_type",]],
        errors::error[name = "variable_name_form", means = "A variable's name is not written `$name`, with `$` directly in front.", tests = ["const_bare_name", "dollar_alone", "old_shadow_eq", "old_shadow_walrus",]],
        errors::error[name = "name_quoted", means = "A name that is written bare, such as a function, field or case, is put in quotes.", tests = ["collection_name_quoted", "construct_quoted_field", "enum_quoted_case", "fail_quoted_name", "generic_quoted_var", "quoted_func_name", "quoted_main", "struct_quoted_field",]],
        errors::error[name = "quoted_name_form", means = "A quoted name breaks its rules, such as a stray backslash or doubled space.", tests = ["name_bad_escape", "name_double_space",]],
        errors::error[name = "name_not_english", means = "A name uses letters outside English letters, digits and `_`, which the base allows.", tests = ["wstn_emoji_fn", "wstn_thai_name",]],
        errors::error[name = "name_reserved", means = "A name belongs to the language, such as `any`, `optional` or a number type, and cannot be reused.", tests = ["iface_named_any", "optional_taken", "struct_keyword_field", "struct_named_rust_alias",]],
        errors::error[name = "keyword_name_bare", means = "A function named like a keyword is reached bare; it is reached through a path.", tests = ["c_header_keyword_fn_bare", "keyword_fn_bare",]],
        errors::error[name = "label_needs_colon", means = "A word inside `[ ]` is not followed by `:` before its value.", tests = ["label_needs_colon",]],
        errors::error[name = "belongs_at_top_level", means = "An item that sits at the top level of a file, such as an enum or module, is inside a body.", tests = ["c_header_in_body", "enum_in_body", "module_in_body", "pub_in_body",]],
        errors::error[name = "belongs_in_body", means = "A statement that runs, such as inline assembly or `on.machine`, is outside any body.", tests = ["asm_top_level", "on_machine_top_level",]],
        errors::error[name = "top_level_needs_const", means = "A value at kit level is written as a variable; it is a `const`.", tests = ["let_top_level", "pub_let",]],
        errors::error[name = "concise_form", means = "A concise file holds something besides `0`, `1`, spaces and line breaks, or a group is not 8 digits.", tests = ["concise_plain_braces", "concise_short_group",]],
        errors::error[name = "inline_block_form", means = "An inline language block is not written `inline.NAME { … }`.", tests = ["asm_bare_word", "asm_strings",]],
        errors::error[name = "inline_language_capitals", means = "An inline language's name is not in capitals, as in `inline.ASM`.", tests = ["asm_lowercase", "asm_s_lowercase",]],
        errors::error[name = "asm_binding_form", means = "An inline assembly binding is written wrongly, such as an `in` word or a lend coming out of a register.", tests = ["asm_in_word", "asm_lend_out",]],
        errors::error[name = "on_form", means = "An `on` choice is not narrowed or its chain does not go on with `else on.…`.", tests = ["on_bare", "on_else_if",]],
        errors::error[name = "unknown_target", means = "A target or chip named in `on.target` is not one the language knows.", tests = ["on_target_half", "on_target_unknown_chip",]],
        errors::error[name = "table_bytes_form", means = "`table_bytes` is misplaced or not a whole number of bytes.", tests = ["table_bytes_negative", "table_bytes_not_fn",]],
        errors::error[name = "not_declared", means = "A variable is used that is not declared where it is used.", tests = ["asm_unknown_var", "const_from_variable", "fnval_silent_capture", "local_const_out_of_block", "single_quote_char", "temp_after_loop", "wl_removes_code",]],
        errors::error[name = "already_declared", means = "A variable is declared twice in the same scope.", tests = ["assign_with_colon",]],
        errors::error[name = "shadow_unsaid", means = "A name already declared in an enclosing scope is declared again without `shadow`.", tests = ["let_over_name_unrun", "let_over_param_uncalled", "shadow",]],
        errors::error[name = "shadow_form", means = "`shadow` is written wrongly; it takes `let`'s place.", tests = ["shadow_with_let",]],
        errors::error[name = "nothing_to_shadow", means = "`shadow` is used where no earlier name of that name is visible.", tests = ["shadow_nothing",]],
        errors::error[name = "shadow_sealed", means = "A name marked `no_shadow` is shadowed.", tests = ["shadow_sealed",]],
        errors::error[name = "unknown_function", means = "No function of that name is reachable from here.", tests = ["c_header_macro_skipped", "case_sensitive_default", "coll_pointer_missing", "enum_prefix_never_bare", "fnval_unknown_name", "module_bare_name_from_root", "module_relative_from_inside",]],
        errors::error[name = "unknown_struct", means = "No struct of that name is reachable from here.", tests = ["bare_type_never", "struct_undeclared",]],
        errors::error[name = "unknown_type", means = "No type of that name is declared.", tests = ["type_name_unknown",]],
        errors::error[name = "unknown_field", means = "A struct has no field of that name.", tests = ["struct_unknown_field",]],
        errors::error[name = "unknown_case", means = "An enum has no case of that name.", tests = ["enum_match_unknown_case", "enum_unknown_case",]],
        errors::error[name = "unknown_interface", means = "A bound names an interface that does not exist.", tests = ["iface_unknown_in_bound",]],
        errors::error[name = "unknown_operator", means = "A word or symbol is used as an operator but no such operator exists here.", tests = ["op_path_wrong_kit", "op_run_no_space", "op_word_undefined", "wrap_amp_form", "wrap_percent_form",]],
        errors::error[name = "unknown_std_name", means = "A name under `std::` does not exist.", tests = ["unknown_std",]],
        errors::error[name = "defined_twice", means = "The same name is defined twice, or as two different things.", tests = ["c_header_clash", "dir_file_and_block", "enum_name_clash", "module_twice", "module_type_clash",]],
        errors::error[name = "not_public", means = "An item is private to its module or kit and is reached from outside it.", tests = ["dir_private_across_files", "extern_block_line_private", "kit_private", "kit_pub_kit", "module_private_const", "module_private_fn", "module_private_nested", "module_private_struct",]],
        errors::error[name = "unknown_pub_narrowing", means = "`pub` is narrowed with a word it does not take.", tests = ["pub_narrowing_bad",]],
        errors::error[name = "kit_name_needs_path", means = "Another kit's name is written bare; it takes that kit's path, as in `greet::hello(…)`.", tests = ["bare_never_without_path", "kit_name_needs_path",]],
        errors::error[name = "std_name_needs_path", means = "A name of std's is written bare; it is written `std::name`.", tests = ["std_duration_needs_path", "std_list_needs_path", "std_name_needs_path",]],
        errors::error[name = "name_ambiguous", means = "A name could be any of several kits'; the path says which.", tests = ["word_op_two_kits",]],
        errors::error[name = "kit_not_listed", means = "The program names a kit its manifest does not list.", tests = ["kit_unlisted", "other_kit",]],
        errors::error[name = "kit_prefix_clash", means = "Two kits share a prefix, or a kit takes the prefix `std`.", tests = ["kit_prefix_clash", "kit_prefix_std",]],
        errors::error[name = "my_needs_path", means = "`my` is written alone; it is followed by `.` and a name.", tests = ["my_alone",]],
        errors::error[name = "use_form", means = "A `use` line is misplaced, names its own kit, or lacks `as`.", tests = ["use_needs_as", "use_not_at_top", "use_own_kit",]],
        errors::error[name = "use_name_taken", means = "A `use` line gives a name that is already this file's name for something else.", tests = ["use_name_taken",]],
        errors::error[name = "bad_file_name", means = "A file's name cannot name a module, such as a reserved device name or one with `-`.", tests = ["dir_badname", "dir_device_name",]],
        errors::error[name = "module_name_lowercase", means = "A module's name has capitals; module names are lowercase.", tests = ["module_uppercase",]],
        errors::error[name = "root_file_missing", means = "A kit has no root file `kit.cy`.", tests = ["dir_no_root",]],
        errors::error[name = "main_not_at_root", means = "`MAIN` is inside a module; it lives at the kit's root.", tests = ["dir_main_in_module", "module_main_inside",]],
        errors::error[name = "collection_member_unprefixed", means = "A collection's member is written without the collection's name in front.", tests = ["coll_handler_short_name", "coll_member_short_name",]],
        errors::error[name = "wrong_type", means = "A value has a different type from the one expected here.", tests = ["bin_into_untyped_int_list", "c_enum_param_number", "empty_int", "enum_data_wrong_type", "fail_payload_wrong_type", "fnval_wrong_return", "list_mixed_types", "op_builtin_for_struct_ok_then_misuse", "return_shadowed_name_unrun", "return_wrong_kind_unrun", "str_slice_byte_text_fallback", "struct_wrong_field_type", "types_two_prefixes", "variadic_typed_mismatch",]],
        errors::error[name = "no_implicit_conversion", means = "Two number types meet where one is wanted, and no conversion happens silently.", tests = ["append_wrong_type", "int_into_bin_var", "mix_families",]],
        errors::error[name = "list_array_mismatch", means = "A list is given where an array is wanted, or an array where a list is wanted.", tests = ["array_into_list", "array_slice_is_list", "list_into_array",]],
        errors::error[name = "array_cannot_grow", means = "An array is appended to; only a list grows.", tests = ["append_to_array",]],
        errors::error[name = "array_never_filled", means = "An empty array is declared, and an array can never be filled later.", tests = ["empty_array",]],
        errors::error[name = "empty_untyped", means = "An empty value such as `[]` or `ptr.null` is written where nothing says its type.", tests = ["empty_walrus", "ptr_null_alone", "ptr_null_list_alone",]],
        errors::error[name = "empty_map_literal", means = "An empty map is written as a literal; it is `map.empty`.", tests = ["map_literal_empty",]],
        errors::error[name = "map_entry_form", means = "A map literal has an entry that does not pair a key with a value.", tests = ["map_literal_no_pair",]],
        errors::error[name = "duplicate_map_key", means = "A map literal gives the same key twice.", tests = ["map_literal_dup_key",]],
        errors::error[name = "bad_map_key", means = "A type that cannot be a map key is used as one.", tests = ["map_bad_key_type",]],
        errors::error[name = "unknown_map_variant", means = "A map kind is named that is not one of the map's variants.", tests = ["map_bad_variant",]],
        errors::error[name = "hash_disagrees_with_equal", means = "A type's `hash` gives different values for two keys its equality calls equal.", tests = ["map_hash_disagrees",]],
        errors::error[name = "unordered_map_walked", means = "A map that promises never to be walked is walked.", tests = ["map_unordered_walk",]],
        errors::error[name = "type_incomplete", means = "A type is written alone that must say more, such as an integer's width or a character's kind.", tests = ["bare_char", "bare_int", "bare_str",]],
        errors::error[name = "type_parameter_count", means = "A type is given the wrong number of type parameters.", tests = ["bare_list_type", "generic_arg_count", "int_with_params", "list_two_params",]],
        errors::error[name = "type_parameter_form", means = "A type parameter is written with `.` instead of in brackets.", tests = ["list_dot_type",]],
        errors::error[name = "no_such_width", means = "A number type is named in a width it does not come in.", tests = ["no_bin128",]],
        errors::error[name = "needs_integer", means = "A whole-number operation, such as a bitwise or wrapping one, is used on a non-integer.", tests = ["bit_on_bin", "to_bits_bin", "wrap_into_bool", "wrap_on_bin",]],
        errors::error[name = "width_unknown", means = "An operation needs a width, as `shr` does, and nothing here says one.", tests = ["bit_not_untyped", "shift_widthless_in_conversion", "shift_widthless_in_count", "shift_widthless_in_print", "shift_widthless_not_run", "shl_no_width", "shr_no_width", "wrap_untyped_left",]],
        errors::error[name = "wrap_sizes_mixed", means = "A wrapping operation mixes two sizes; it wraps at one.", tests = ["wrap_mixed_sizes",]],
        errors::error[name = "wrap_needless", means = "A wrapping form is used on an operation that never overflows, such as `mod`.", tests = ["mod_wrap",]],
        errors::error[name = "ieee_misused", means = "An `.ieee` form is used where no `-0` can arise, such as on integers or `mod.near`.", tests = ["ieee_on_int", "ieee_on_mod", "negate_ieee_on_int", "plus_ieee_on_int",]],
        errors::error[name = "rounding_unsaid", means = "`div` or `mod` is written without saying how it rounds.", tests = ["div_bare", "mod_bare", "op_div_bare",]],
        errors::error[name = "unknown_rounding", means = "A rounding way is named that does not exist.", tests = ["div_unknown_rounding", "round_unknown_way",]],
        errors::error[name = "mod_near_on_fraction", means = "`mod.near` is used on fractions, where it leaves nothing over.", tests = ["mod_near_fraction",]],
        errors::error[name = "negative_exponent", means = "An integer power has a negative exponent, which would make a fraction.", tests = ["negative_exponent",]],
        errors::error[name = "no_truthiness", means = "A non-bool is used as a condition or converted to bool; there is no truthiness.", tests = ["simd_not_a_bool", "to_bool", "truthiness",]],
        errors::error[name = "not_text", means = "A value that is not text, such as a list, map, struct or data-carrying case, is used as text.", tests = ["enum_data_to_text", "enum_plain_case_to_text", "list_to_text", "map_to_text", "struct_to_text",]],
        errors::error[name = "concat_needs_text", means = "`concat` is given something that is not text; convert it first.", tests = ["plusplus_needs_conversion", "plusplus_numbers",]],
        errors::error[name = "text_unit_unsaid", means = "Text is read, walked, indexed or measured without saying in which unit.", tests = ["str_each_no_unit", "str_for_bare", "str_index", "str_length",]],
        errors::error[name = "text_order_undecided", means = "Text is compared with `<`, which has no meaning yet.", tests = ["str_less_than",]],
        errors::error[name = "empty_separator", means = "A text split is given an empty separator.", tests = ["str_split_empty",]],
        errors::error[name = "case_mapping_unsaid", means = "A case change does not say which mapping it uses, or uses `lang:` with a simple one.", tests = ["case_lang_not_full", "case_mapping_unsaid",]],
