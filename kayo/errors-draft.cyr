        errors::error[name = "union_one_field", means = "A union is built with more or fewer than one field.", tests = ["union_two_fields",]],
        errors::error[name = "simd_element_type", means = "A simd vector holds something other than plain numbers or bools.", tests = ["simd_bad_element",]],
