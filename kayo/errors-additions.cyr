# Error names kayo needs beyond errors.cyr (owner, 2026-10-22/24): kinds no oracle refusal test reaches. DRAFT by compiler claude, for design claude's review.
errors::table[
    errors = [
        errors::error[name = "bare_mark_form", means = "A `bare` mark is misplaced, repeated, or put on something it does not cover, such as a const.", tests = []],
        errors::error[name = "body_missing", means = "A function has no body; only an `extern` function goes without one.", tests = []],
        errors::error[name = "bound_given_twice", means = "A type is given more than one bound; it takes one.", tests = []],
        errors::error[name = "bound_not_taken", means = "A bound is put on a type that takes none, such as a bool or a struct.", tests = []],
        errors::error[name = "bound_unit_misplaced", means = "A unit such as `bytes` is written on a bound that counts no units, such as a number's.", tests = []],
        errors::error[name = "build_file_missing", means = "A kit has no `build.cy` for `kayo prepare` to run.", tests = []],
        errors::error[name = "bundle_loop_form", means = "A loop over a mixed bundle is written in a way it cannot be, such as with `perm` or without `lend`.", tests = []],
        errors::error[name = "case_data_form", means = "A case's data is given in the wrong shape, such as several values or a field where it carries one value.", tests = []],
        errors::error[name = "case_handled_twice", means = "A `match` handles the same case twice.", tests = []],
        errors::error[name = "case_value_misplaced", means = "A case's value is given somewhere other than at the end of a case of a `match` used as a value.", tests = []],
        errors::error[name = "case_value_missing", means = "A case of a `match` used as a value ends without giving a value or leaving.", tests = []],
        errors::error[name = "character_empty", means = "A character literal has nothing between its backticks.", tests = []],
        errors::error[name = "collection_line_form", means = "A collection's `labels`, `defaults` or preset line is written in the wrong shape, or the collection has nothing for it to describe.", tests = []],
        errors::error[name = "counter_shadowed", means = "A loop's own variable is shadowed in its body; the loop's header alone says what it is.", tests = []],
        errors::error[name = "counting_loop_form", means = "A counting loop's words are missing or out of order; it reads `[from: …, to: …, by: …]`, or `before:` for `to:`.", tests = []],
        errors::error[name = "element_given_away", means = "One element of a list is given away, which would leave a hole in the list.", tests = []],
        errors::error[name = "enum_empty", means = "An enum has no cases.", tests = []],
        errors::error[name = "fail_list_empty", means = "A `fail[ ]` list names no failure.", tests = []],
        errors::error[name = "failure_handled_twice", means = "One failure of a call is handled by two arms.", tests = []],
        errors::error[name = "field_name_in_call", means = "A call's argument is written `name = value`, as a struct or map field is; a call takes values.", tests = []],
        errors::error[name = "field_unnamed", means = "A struct is built with a value that does not name its field.", tests = []],
        errors::error[name = "function_owner_wrong", means = "A function is attached with `fn name.f` to something that is not a struct, enum or function.", tests = []],
        errors::error[name = "generated_marker_form", means = "A template's `#generated_N_lines_below` marker is misplaced or misspelled.", tests = []],
        errors::error[name = "generic_unfilled", means = "A generic `<T>` is not filled: nothing in the call says what it is.", tests = []],
        errors::error[name = "given_twice", means = "A field or a labelled argument is given twice.", tests = []],
        errors::error[name = "handler_value_unused", means = "A failure's arm gives a value, but the call's value is not used.", tests = []],
        errors::error[name = "include_form", means = "An `incl` does not say what it makes of the file, or names a form that does not exist; it is `incl.bytes[…]` or `incl.str.…[…]`.", tests = []],
        errors::error[name = "iterator_has_no_position", means = "A loop over an iterator asks for a position; an iterator's items come one at a time.", tests = []],
        errors::error[name = "iterator_next_form", means = "An iterator's `next` does not take it `lent.mut` or does not return `optional[…]`.", tests = []],
        errors::error[name = "kit_not_found", means = "A kit named on the command line is not among the kits here.", tests = []],
        errors::error[name = "kits_depend_in_circle", means = "Kits depend on each other in a circle, so a kit would depend on itself.", tests = []],
        errors::error[name = "label_outside_call", means = "An argument's label, such as `count:` or `pos:`, is written where no call takes it.", tests = []],
        errors::error[name = "lane_count_misplaced", means = "A lane count, `count N`, is written somewhere other than in a `simd` type.", tests = []],
        errors::error[name = "lent_at_call", means = "`lent` is written at a call; it is the parameter's word, and the caller writes `lend`.", tests = []],
        errors::error[name = "lent_given_away", means = "Something only borrowed, such as a `lent` parameter or a loop's element, is given away.", tests = []],
        errors::error[name = "manifest_field_misplaced", means = "A manifest field is given where it does not belong, such as a `layout` on a target with an OS.", tests = []],
        errors::error[name = "manifest_line_form", means = "A line of the manifest is not a section, a block's opening or closing, or a `key = value` line with a value.", tests = []],
        errors::error[name = "manifest_missing", means = "A kit that is used has no `CyJet.toml`, so nothing gives its prefix.", tests = []],
        errors::error[name = "manifest_section_form", means = "A manifest section holds lines of the wrong shape, such as `key = value` lines where blocks belong.", tests = []],
        errors::error[name = "manifest_source_unclear", means = "A kit's or limb's block does not say where it comes from, or says it two ways.", tests = []],
        errors::error[name = "manifest_unknown_field", means = "A manifest section or block has a field it does not take.", tests = []],
        errors::error[name = "manifest_value_form", means = "A manifest value is not one its field takes, such as a `default` other than `yes` or `no`.", tests = []],
        errors::error[name = "member_names_itself", means = "A collection's member names itself instead of a function.", tests = []],
        errors::error[name = "my_after_kit_path", means = "`my.` follows another kit's path, which already starts at that kit's root.", tests = []],
        errors::error[name = "narrowing_not_taken", means = "A type that is already complete is narrowed further with `.`.", tests = []],
        errors::error[name = "negative_unsigned", means = "An unsigned number is negated or meets a negative number; an unsigned number is never negative.", tests = []],
        errors::error[name = "no_version_fits", means = "No version of a function takes the arguments given.", tests = []],
        errors::error[name = "not_a_module", means = "A path goes on past something that is not a module, such as a type, enum or const.", tests = []],
        errors::error[name = "not_a_struct", means = "A field is reached with `.` on something that is not a struct.", tests = []],
        errors::error[name = "not_a_type", means = "Something that is not a type, such as a function or module, is written where a type goes.", tests = []],
        errors::error[name = "not_a_value", means = "Something that is not a value, such as a keyword, a type or a function with several versions, is used as one.", tests = []],
        errors::error[name = "not_changeable", means = "Something other than a variable, a field or an element is assigned to or changed.", tests = []],
        errors::error[name = "not_indexable", means = "Something without positions, such as a map or a mixed bundle, is read with `[…]`.", tests = []],
        errors::error[name = "not_whole_number", means = "A number that must be whole, such as a count, a duration, a bit-field's width or a number of places, is written with a fraction.", tests = []],
        errors::error[name = "operator_cannot_fail", means = "An operator is declared to fail; only a `fn` can fail.", tests = []],
        errors::error[name = "operator_level_given_twice", means = "An operator is given precedence levels in two places; it binds one way everywhere.", tests = []],
        errors::error[name = "operator_wrong_type", means = "An operator is used on a type it has no meaning for, such as negating text or multiplying two durations.", tests = []],
        errors::error[name = "operators_level_apart", means = "A precedence level holds two operators that the language puts at different levels.", tests = []],
        errors::error[name = "outside_loop", means = "`break` or `continue` stands outside any loop.", tests = []],
        errors::error[name = "path_forbidden", means = "A name is written with a path or prefix that its kit or enum forbids; it is written bare.", tests = []],
        errors::error[name = "path_not_readable", means = "A file or folder kayo was given or found cannot be read.", tests = []],
        errors::error[name = "power_not_granted", means = "A kit uses a power that nothing grants it.", tests = []],
        errors::error[name = "returned_borrow_form", means = "A function that returns a borrow hands back something other than the `lent` or `lent.mut` borrow its signature says.", tests = []],
        errors::error[name = "returned_borrow_misused", means = "A borrow a function hands back is used other than held by a name or handed straight to a parameter.", tests = []],
        errors::error[name = "said_twice", means = "Something said once, such as a collection's `labels` line, a parameter's label or its default, is said twice.", tests = []],
        errors::error[name = "simd_lane_count_unknown", means = "A simd operation needs the vector's lane count, and nothing here says it.", tests = []],
        errors::error[name = "size_outside_writer", means = "A size in bytes is used somewhere other than a writer's size.", tests = []],
        errors::error[name = "strict_misplaced", means = "`#strict` is written somewhere other than once, at the top of the file.", tests = []],
        errors::error[name = "strict_word_missing", means = "A `#strict` file leaves out a word it must write out, such as `mut` or `immut` on a declaration, or `temp` or `perm` on a loop variable.", tests = []],
        errors::error[name = "target_function_wrong", means = "A target's `output` or `exit` does not name a function of the shape it needs.", tests = []],
        errors::error[name = "target_layout_missing", means = "A target with no OS has no linker script `layout`, or the file it names is not there.", tests = []],
        errors::error[name = "target_not_listed", means = "A build asks for a target the kit's `CyJet.toml` does not list.", tests = []],
        errors::error[name = "template_runs_forever", means = "A function run while generating takes so many steps that it may never end.", tests = []],
        errors::error[name = "template_too_many_members", means = "A template makes more members than a template may make.", tests = []],
        errors::error[name = "template_value_unknown", means = "A template, or a function run while generating, uses a value not known before building.", tests = []],
        errors::error[name = "text_not_ascii", means = "Text that is not ASCII is given where `str.ascii` is wanted.", tests = []],
        errors::error[name = "two_verbs", means = "A value is given more than one verb; it takes one.", tests = []],
        errors::error[name = "unclosed_quote", means = "A quoted name, a text or a character literal is opened and never closed.", tests = []],
        errors::error[name = "unknown_const", means = "No const of that name is reachable from here.", tests = []],
        errors::error[name = "unknown_inline_language", means = "An inline block names a language that is not one of the inline languages.", tests = []],
        errors::error[name = "unknown_module", means = "No module of that name is reachable from here.", tests = []],
        errors::error[name = "unknown_narrowing", means = "A word is narrowed with `.` and a word it does not take, such as `must.x` or `concur.x`.", tests = []],
        errors::error[name = "unknown_operation", means = "An operation of a built-in kind, such as `list.`, `map.` or `simd.`, is named that does not exist.", tests = []],
        errors::error[name = "unknown_power", means = "A power is named that does not exist.", tests = []],
        errors::error[name = "unknown_text_unit", means = "A text or character unit is named that is not `byte`, `point` or `grapheme`.", tests = []],
        errors::error[name = "unknown_verb", means = "A verb is narrowed with a word it does not take; the borrows are `lend` and `lend.mut`, or `lent` and `lent.mut` on a parameter.", tests = []],
        errors::error[name = "value_left_unused", means = "A value stands alone as a statement, and nothing uses it; it is assigned, or handed to a call.", tests = []],
        errors::error[name = "verb_on_fresh_value", means = "`give`, `copy` or `lend` is put on a fresh value, such as a call's result or a literal, which has no owner yet.", tests = []],
        errors::error[name = "writer_size_zero", means = "A writer is made with a size of less than one byte.", tests = []],
        errors::error[name = "ai::brain_to_deci_unsaid", means = "A brain float converts to a deci without saying which value it means.", tests = []],
        errors::error[name = "cnc::bit_field_form", means = "A bit-field is not a whole number or `bool`, or is given a range besides its bits.", tests = []],
        errors::error[name = "cnc::c_str_zero_misplaced", means = "`exclude zero` or `include zero` is written on a bound that is not a C string's.", tests = []],
        errors::error[name = "cnc::extern_language_unknown", means = "An `extern` names a language other than C, the only one reached.", tests = []],
        errors::error[name = "cnc::incl_c_form", means = "An `incl.C` line is written wrongly: an unknown kind of header, a header not in quotes, or no header at all.", tests = []],
        errors::error[name = "cnc::spread_into_c", means = "A list is spread with `...` into a call to C, which cannot take it.", tests = []],
        errors::error[name = "mcps::channel_bound_form", means = "A bounded channel does not say how much it holds, as in `channel[T][max: 100]`.", tests = []],
        errors::error[name = "mcps::para_cannot_split", means = "A `for para` loop cannot be split into slices that run side by side.", tests = []],
        errors::error[name = "mcps::send_never_taken", means = "Nothing can ever take what is sent on a channel here.", tests = []],
        errors::error[name = "mcps::task_outlives_lend", means = "A `concur` task can outlive something it borrowed.", tests = []],
        errors::error[name = "mcps::tasks_wait_on_each_other", means = "Two sides can end up each waiting for the other, so neither goes on.", tests = []],
        errors::error[name = "mcps::whichever_empty", means = "A `whichever` has no arms; it needs at least one.", tests = []],
        errors::error[name = "money::percent_number_type", means = "A percent is given a number type other than a `d` or an `f`.", tests = []],
    ],
];
