# lists, twin of lists.c. Lumen has no growable list, so the array is made at its full
# length up front; the runner writes N in for {{N}}.
fn main(console: Console) -> Unit {
  let n = {{N}}
  let xs = iarray(n)
  var i = 1
  while i <= n {
    iaset(xs, i - 1, i % 1000)
    i = i + 1
  }
  var acc = 0
  var r = 0
  while r < 10 {
    var j = 0
    while j < n {
      acc = acc + iaget(xs, j)
      j = j + 1
    }
    r = r + 1
  }
  console.print_int(acc % 256)
  return ()
}
