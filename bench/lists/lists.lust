local n: int = {{N}}
local xs: Array<int> = []
local i: int = 1
while i <= n do
    array.push(xs, i % 1000)
    i = i + 1
end
local acc: int = 0
local r: int = 0
local len: int = array.len(xs)
while r < 10 do
    local j: int = 0
    while j < len do
        if xs[j] is Ok(x) then
            acc = acc + x
        end
        j = j + 1
    end
    r = r + 1
end
println(acc % 256)
