# Bitwise operators and shifts on integers past 128 bits (owner, 2026-10-03:
# "Do the bit shit"), worked out at run time at the type's true width, and
# a uint128's shl 127 and not.bit at all 128 bits; each answer's digits
# against examples/wide_bits.out, checked against Python. All nine: 9.
extern.C fn exit ['code': int32];
extern.C fn strlen ['s': ptr[uint8]] --> uint64;
MAIN {
    let mut 'right': int32 = 0;
    let 's' := "x";
    !check let 'n0': uint64 = strlen[lend 's'];
    let 'z': int32 = to.int32['n0'] minus 1;
    let 'k55': int32 = 55 plus 'z';
    let 'k190': int32 = 190 plus 'z';
    let 'k3': int32 = 3 plus 'z';
    let 'k7': int32 = 7 plus 'z';
    let 'k127': int32 = 127 plus 'z';
    let 'a': !std.uint256 = 2 pow (200 plus 'z') plus 12345;
    let 'b': !std.uint256 = (2 pow (255 plus 'z')) minus 1;
    if to.stored.str.utf8['a' and.bit 'b'] == "1606938044258990275541962092341162602522202993782792835313721" { change 'right' = 'right' plus 1; }
    if to.stored.str.utf8['a' xor 'b'] == "57896044618658096104847448245353678384672899991657679497525798221163729506246" { change 'right' = 'right' plus 1; }
    if to.stored.str.utf8['a' shl 'k55'] == "57896044618658097711785492504343953926634992332820282020173567503155675004928" { change 'right' = 'right' plus 1; }
    if to.stored.str.utf8['a' shr 'k190'] == "1024" { change 'right' = 'right' plus 1; }
    let 'n': !std.int256 = -(2 pow (200 plus 'z'));
    if to.stored.str.utf8['n' or.bit to.!std.int256['k7']] == "-1606938044258990275541962092341162602522202993782792835301369" { change 'right' = 'right' plus 1; }
    if to.stored.str.utf8['n' shr 'k3'] == "-200867255532373784442745261542645325315275374222849104412672" { change 'right' = 'right' plus 1; }
    let 'zz': !std.uint256 = to.!std.uint256['z'];
    let 'all': !std.uint256 = not.bit 'zz';
    if to.stored.str.utf8['all'] == "115792089237316195423570985008687907853269984665640564039457584007913129639935" { change 'right' = 'right' plus 1; }
    let 'u': uint128 = to.uint128[1 plus 'z'];
    let 'top': uint128 = 'u' shl 'k127';
    let 'flip': uint128 = not.bit 'u';
    if to.stored.str.utf8['top'] == "170141183460469231731687303715884105728" { change 'right' = 'right' plus 1; }
    if to.stored.str.utf8['flip'] == "340282366920938463463374607431768211454" { change 'right' = 'right' plus 1; }
    !check my.exit['right'];
}
