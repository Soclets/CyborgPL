# A deci range type with bin's rules (owner, 2026-09-29): a value outside
# the bounds is a check site, and 2 is not in deci64[0.0, 1.0] (the
# oracle: "2 does not fit deci64[0, 1]").
extern.C fn exit ['code': int32];
fn twice ['d': deci64] -> deci64 {
    return 'd' times 2;
}
MAIN {
    let 'c': deci64[0.0, 1.0] = twice[1];
    nocheck exit[7];
}
