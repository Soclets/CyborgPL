# An unproven site keeps its check in a working build, and a check that
# fires stops the program with 101 and says where.
extern fn exit ['code': int32];
extern fn getpid [] -> int32;

MAIN {
    nocheck 'pid' := getpid[];
    'huge': int32 = 2_000_000_000;
    'boom': int32 = 'pid' x 'huge';
    nocheck exit['boom'];
}
