# A slice whose end is not known is checked at run time: past the end
# of the list, it stops. `strlen` is extern, so 'k' is any `uint64`.
extern fn exit ['code': int32];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    's' := "nine char";
    nocheck 'k': uint64 = strlen[lend 's'];
    'xs': list[int64] = [1, 2, 3];
    'part' := list.slice[lend 'xs', 1, 'k'];
    nocheck exit[to.int32[list.length[lend 'part']]];
}
