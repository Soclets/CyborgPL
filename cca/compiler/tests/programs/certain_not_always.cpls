extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 'k' := "CHK_A";
    nocheck let 'n': uint64 = strlen[getenv[lend 'k']];
    let 'p': int16 = -5;
    if 'n' > 1000000 {
        let 'x': uint64 = to.uint64['p'];
    }
    let 'hi' := "ran on";
    nocheck write[1, lend 'hi', 6];
}
