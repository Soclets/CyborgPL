# A write through `for 'x' in lend.mut 'xs'` changes the list, for Precog
# too. It wrote only 'x', kept the list's 2s, and "proved" that
# `'xs'[1] x 50` fits an int8 — the list holds 6s, and 300 does not: the
# program stops, as the oracle does.
extern.C fn exit ['code': int32];
MAIN {
    let mut 'xs': list[int64] = list.fill[2, 3];
    for 'x' in lend.mut 'xs' {
        change 'x' = 'x' times 3;
    }
    let 'y': int8 = to.int8['xs'[1] times 50];
    !check my.exit[to.int32['y']];
}
