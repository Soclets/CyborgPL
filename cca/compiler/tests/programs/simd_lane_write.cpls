# One lane of a vector is written like a list item (owner, 2026-09-29: a),
# as examples/simd_lanes.cpls has it: 'x' is 4, a uint8 200 +~ 200 is 144,
# lane 3 set to 30 reads 30 and sums to 30 — and Precog, which joins a
# written lane into the vector's domain, must not fold it back to 0.
# 4 + 144 + 30 + 30 = 208.
extern fn exit ['code': int32];
MAIN {
    'a': simd[int32, 4] = simd.fill[4];
    'x': int32 = 'a'[1];
    'u': simd[uint8, 16] = simd.fill[200];
    'w' := 'u' +~ 'u';
    mut 'v': simd[int32, 4] = simd.fill[0];
    change 'v'[3] = 30;
    'y': int32 = 'v'[3];
    's': int32 = simd.sum['v'];
    nocheck exit['x' + to.int32['w'[16]] + 'y' + 's'];
}
