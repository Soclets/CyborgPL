# `to.array[…]` freezes a list's length, `to.list[…]` lets an array grow
# (owner, 2026-09-23). `give` hands the elements over without a copy;
# `copy` keeps the original. Texts inside are copied, not shared: the
# leak check frees each once.
extern.C fn exit ['code': int32];
MAIN {
    let mut 'l': list[int32] = [1, 2];
    list.append[lend.mut 'l', 3];
    let 'a' := to.array[give 'l'];
    let mut 'm' := to.list[copy 'a'];
    list.append[lend.mut 'm', 4];
    let mut 's': list[int32] = array.slice[lend 'a', 2, 3];
    list.append[lend.mut 's', 9];
    let mut 'w': list[str.utf8] = ["x", "yy"];
    list.append[lend.mut 'w', "zzz"];
    let 'fw' := to.array[copy 'w'];
    let 'back' := to.list[give 'fw'];
    # 3 + 4 x 10 + 3 x 100 + 3 + (1 + 4 + 9)
    let 'n': uint64 = array.length[lend 'a'] plus list.length[lend 'm'] times 10 plus list.length[lend 's'] times 100 plus list.length[lend 'back'];
    let 'v': int32 = 'a'[1] plus 'm'[4] plus 's'[3];
    nocheck exit[to.int32['n'] plus 'v'];
}
