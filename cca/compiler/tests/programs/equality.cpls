# == and !== on an enum (with and without a payload), a struct and a text:
# the same shape all the way down. The instruction used to be dropped
# silently and the answer left unwritten. Each true case adds its bit.
extern fn exit ['code': int32];
extern fn strlen ['s': ptr[uint8]] -> uint64;
enum Status {
    empty
    claimed: str.utf8
    locked
}
struct P { x: int32  y: int32 }
MAIN {
    let 'k' := "abc";
    nocheck let 'n': uint64 = strlen[lend 'k'];
    let mut 'got': int32 = 0;
    let mut 's' := Status.empty;
    if 'n' > 2 { change 's' = Status.locked; }
    if 's' == Status.locked { change 'got' = 'got' + 1; }
    if 's' !== Status.empty { change 'got' = 'got' + 2; }
    let 't' := Status.claimed["Bo"];
    if 't' == Status.claimed["Bo"] { change 'got' = 'got' + 4; }
    if 't' !== Status.claimed["Al"] { change 'got' = 'got' + 8; }
    let 'a' := P[x = to.int32['n'], y = 2];
    if 'a' == P[x = 3, y = 2] { change 'got' = 'got' + 16; }
    if "a" ++ "bc" == 'k' { change 'got' = 'got' + 32; }
    nocheck exit['got'];
}
