# A shift's width is the shifted number's own type, or where the value goes,
# never its count (owner, 2026-10-07): ((0 minus 53) shr 'c') mod.floor 23 into
# an int64 is a 64-bit shift, 22; 7 shr (('a' minus 1) mod.floor 32) into an
# int64 is 7 shr 0, 7. 22 + 7 = 29, as the oracle has it.
extern.C fn exit ['code': int32];
MAIN {
    let 'c': int8 = 9;
    let 'r': int64 = ((0 minus 53) shr 'c') mod.floor 23;
    let 'a': int8 = 33;
    let 's': int64 = 7 shr (('a' minus 1) mod.floor 32);
    !check my.exit[to.int32['r' plus 's']];
}
