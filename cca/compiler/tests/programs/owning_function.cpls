# A function carrying what it captured with `copy` or `give` is owned like a
# list (owner, 2026-09-24: a): `copy` copies what it carries, `give` hands
# it on, and dropping it gives back what it holds. One carrying nothing, or
# only lends, copies by itself. Lent to a `lent` parameter, it stays put;
# given or copied to a `fn[…]` parameter, the callee owns it and gives it back.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn look [lent 'f': fn[] -> uint64] -> uint64 { return 'f'[]; }
fn run ['f': fn[] -> uint64] -> uint64 { return 'f'[]; }
MAIN {
    let 'k' := "CCA_SURELY_UNSET_VARIABLE";
    nocheck let 'there' := ptr.is_null[getenv[lend 'k']];
    let mut 'xs' := [1, 2, 3];
    if 'there' { list.append[lend.mut 'xs', 4]; }
    let 'count' := fn [] -> uint64 with [copy 'xs'] { return list.length[lend 'xs']; };
    list.append[lend.mut 'xs', 5];
    let 'again' := copy 'count';
    let 'moved' := give 'count';
    let 'words' := ["a", "bb"];
    let 'size' := fn [] -> uint64 with [give 'words'] { return str.bytes[lend 'words'[2]]; };
    let 'inc' := fn ['a': int32] -> int32 { return 'a' + 1; };
    let 'inc2' := 'inc';
    let 'inc3' := fn [] -> uint64 { return 7; };
    let mut 'got': int32 = 0;
    if 'again'[] == 4 and 'moved'[] == 4 { change 'got' = 'got' + 1; }
    if list.length[lend 'xs'] == 5 and 'size'[] == 2 { change 'got' = 'got' + 2; }
    if 'inc2'[41] == 42 and look[lend 'again'] == 4 { change 'got' = 'got' + 4; }
    if run[copy 'again'] == 4 and run[give 'again'] == 4 and run['inc3'] == 7 { change 'got' = 'got' + 8; }
    nocheck exit['got'];
}
