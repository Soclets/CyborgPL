extern.C fn exit ['code': int32];
MAIN {
    let mut 'phones': map[str.utf8, int32] = map["ann" = 51, "bob" = 52];
    map.set[lend.mut 'phones', "cat", 53];
    map.set[lend.mut 'phones', "ann", 60];
    let 'a' := map.get[lend 'phones', "ann"] otherwise 0;
    let 'c' := map.get[lend 'phones', "cat"] otherwise 0;
    let 'z' := map.get[lend 'phones', "zed"] otherwise 7;
    let 'n': int32 = map.length[lend 'phones'];
    let 'has': bool = map.has[lend 'phones', "bob"];
    let mut 'h': int32 = 0;
    if 'has' { change 'h' = 1; }
    nocheck exit['a' plus 'c' plus 'z' plus 'n' plus 'h'];
}
