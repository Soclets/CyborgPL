# `div.trunc` and `mod.trunc` round toward zero, C's `/` and `%` (owner,
# 2026-10-02): -7 div.trunc 2 is -3 and -7 mod.trunc 2 is -1, where `div`
# and `mod` floor (-4 and 1). `mod.trunc` takes bins and brain16 too, C's
# `fmod`: -370 mod.trunc 360 is -10. The lowest int8 mod.trunc -1 is 0 and
# no check; div.trunc of it is past the type, like `div`. Each right answer
# adds its own bit to the exit code: 255 when all are right.
extern.C fn exit ['code': int32];
MAIN {
    let 'x': int32 = -7;
    let 'y': int32 = 2;
    let 'z': int32 = -2;
    let 'lo': int8 = -128;
    let 'm1': int8 = -1;
    let 'u': uint16 = 65535;
    let 'angle': bin64 = -370.0;
    let 'turn': bin64 = 360.0;
    let 'a': bin64 = 7.5;
    let 'b': bin64 = -2.0;
    let 'h': brain16 = -5.0;
    let 'k': brain16 = 3.0;
    let mut 'code': int32 = 0;
    if ('x' div.trunc 'y') equal_to -3 { change 'code' = 'code' plus 1; }
    if ('x' mod.trunc 'y') equal_to -1 { change 'code' = 'code' plus 2; }
    if (7 div.trunc 'z') equal_to -3 { change 'code' = 'code' plus 4; }
    if (7 mod.trunc 'z') equal_to 1 { change 'code' = 'code' plus 8; }
    if (('lo' mod.trunc 'm1') equal_to 0) and (('u' div.trunc 10) equal_to 6553) and (('u' mod.trunc 10) equal_to 5) { change 'code' = 'code' plus 16; }
    if ('angle' mod.trunc 'turn') equal_to -10.0 { change 'code' = 'code' plus 32; }
    if (('a' mod.trunc 'b') equal_to 1.5) and (('h' mod.trunc 'k') equal_to -2.0) { change 'code' = 'code' plus 64; }
    # A remainder by 3 of -10 to 10, truncated: -2 to 2, the dividend's sign.
    let mut 'sum': int32 = 0;
    for 'i' in range[from -10, to 10, by 1] {
        change 'sum' = 'sum' plus ('i' mod.trunc 3) plus ('i' div.trunc 3);
    }
    if 'sum' equal_to 0 { change 'code' = 'code' plus 128; }
    no_check my.exit['code'];
}
