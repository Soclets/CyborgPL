extern fn exit ['code': int32];
MAIN {
    mut 'a': list[int32] = [1, 2, 3];
    mut 'b': list[int32] = copy 'a';
    list.append[lend.mut 'b', 4];
    change 'b'[pos 1] = 9;
    'la': int32 = list.length[lend 'a'];
    'lb': int32 = list.length[lend 'b'];
