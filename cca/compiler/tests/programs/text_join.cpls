extern.C fn exit ['code': int32];
fn greet [lent 'who': str.utf8] --> str.utf8 {
    return "hello, " ++ 'who';
}
MAIN {
    let 'name': str.utf8 = "world";
    let 'msg' := greet[lend 'name'];
    let 'n': int32 = str.bytes[lend 'msg'];
    let 'plain': int32 = str.bytes[lend 'name'];
    !check my.exit['n' plus 'plain'];
}
