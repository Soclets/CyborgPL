# `copy 'l'` handed to a call is a second, independent value: the callee
# owns it and gives it back, and the caller's own list is untouched. Read as
# the same bytes, the callee freed the caller's list, which was then used
# and freed again. Built at run time so the calls are not worked out ahead.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn first ['xs': list[int32]] -> int32 { return 'xs'[pos 1]; }
MAIN {
    'k' := "CCA_SURELY_UNSET_VARIABLE";
    nocheck 'there' := ptr.is_null[getenv[lend 'k']];
    mut 'x': int32 = 1;
    if 'there' { change 'x' = 2; }
    'l': list[int32] = ['x', 3];
    'a' := first[copy 'l'];
    'b' := first[copy 'l'];
    'c' := first[give 'l'];
    nocheck exit['a' + 'b' + 'c'];
}
