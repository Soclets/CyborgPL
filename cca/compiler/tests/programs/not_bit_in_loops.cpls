# A `check` that holds, inside two loops (check claude, seed 316): 'v2' is
# -102 to -96 on every trip, so `not.bit 'v2'` is 95 to 101 and never zero.
# Layer 2 had no range for `not.bit`, and widened at every busy block, so
# the loops lost the interval and the build refused the `check`. The
# quotient is exact now (owner, 2026-10-02) and a shift of an exact answer
# is open, so it is an int8 first, as it was.
extern.C fn exit ['code': int32];
extern.C fn strlen ['s': ptr[uint8]] --> uint64;
MAIN {
    let 's' := "seven!!";
    !check let 'n': uint64 = strlen[lend 's'];
    let mut 'v2': int8 = (to.int8['n' mod.floor 100] mod.floor 7) minus 102;
    let mut 'w3': int16 = 7;
    while 'w3' > 0 {
        change 'w3' = 'w3' minus 1;
        for 'i4': uint16 in range[29, 3, -3] {
            check change 'v2' = ((to.int8[(126 or.bit 'v2') div.floor (not.bit 'v2')] shl 6) mod.floor 7) minus 102;
        }
    }
    !check my.exit[to.int32[0 minus 'v2']];
}
