# The same, but one range in the program rests on `nocheck`'s word: 'w'
# is stored into an int64[0, 1000] unasked. No range is then a fact to
# hand LLVM (owner, 2026-09-29: c), and the answer is not clamped.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn pick [] -> int64[0, 1000] or fail[missing] {
    'key' := "CCA_NO_SUCH_VARIABLE";
    nocheck 'p' := getenv[lend 'key'];
    if ptr.is_null['p'] { return 3; }
    fail missing;
}
fn widen ['w': int64] -> int64 {
    nocheck 'r': int64[0, 1000] = 'w';
    return 'r';
}
MAIN {
    'n' := pick[] otherwise 0;
    nocheck exit[to.int32['n' + widen[3]]];
}
