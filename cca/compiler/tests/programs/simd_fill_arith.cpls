# `simd.fill` of an answer of plain math (check claude, 163 of 300
# programs): the answer is exact, and was made the lane type — 65-bit lanes,
# one to a register, `simd[integer, 1]` — so a `simd[int32, 4]` refused it.
# It now lands in every lane of the type the vector gets, and is asked there.
# And a vector nothing gives a lane width (`:=` of bare numbers) has the
# natural one, 64 bits, two lanes; it had none. 6 + 2 + 25 + 5 + 6 = 44.
extern.C fn exit ['code': int32];
MAIN {
    let 'x': int32 = 5;
    let 'a': simd[int32, 4] = simd.fill['x' plus 1];
    let 'b': simd[int32, 4] = simd.fill[('x' mod.floor 7) minus 3];
    let 'c': simd[int16, 8] = simd.fill['x' pow 2];
    let 'd' := simd.fill[5];
    let 'e' := simd.fill['x' plus 1];
    let 'd2': int64 = 'd'[2];
    let 'e1': int64 = 'e'[1];
    nocheck exit['a'[4] plus 'b'[1] plus to.int32['c'[8]] plus to.int32['d2'] plus to.int32['e1']];
}
