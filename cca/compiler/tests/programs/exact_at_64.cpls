# Plain math is exact, and "Precog still uses narrow sizes where it proves
# they fit" (operators.md): 'i' is at most 'n', an `int32`'s value, so
# `'i' x 'i'` and its `mod` are 64-bit instructions, not 128-bit ones and a
# library call. Widening at every busy block had thrown `'i' </== 'n'` away.
extern fn exit ['code': int32];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 's' := "ten chars!";
    nocheck let 'n': int32 = to.int32[strlen[lend 's']];
    let mut 'acc': int64 = 0;
    let mut 'i': int64 = 1;
    while 'i' </== to.int64['n'] {
        change 'acc' = ('acc' + (('i' x 'i') mod 7)) mod 1000000007;
        change 'i' = 'i' + 1;
    }
    nocheck exit[to.int32['acc']];
}
