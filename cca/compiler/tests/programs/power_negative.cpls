# A negative exponent makes a fraction, which no integer holds: it stops.
extern.C fn exit ['code': int32];
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 's' := "ab";
    nocheck let 'two': int64 = to.int64[strlen[lend 's']];
    let 'p': int64 = 'two' xx ('two' - 3);
    nocheck exit[to.int32['p' mod 256]];
}
