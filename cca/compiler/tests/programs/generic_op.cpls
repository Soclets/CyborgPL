# A generic operator (owner, 2026-09-29), and one operator for two types by
# name (examples/generic_op.cpls as an exit code): 95 ~= 100 is true (1), 50
# ~= 100 false, A 3 <+> A 3 is 6 and B 3 <+> B 3 is 9 → 1 + 60 + 9 x 100 = 961,
# which exits as 961 mod 256 = 193.
extern fn exit ['code': int32];
interface Number {
    op - ['a': <T>, 'b': <T>] -> <T>;
    op < ['a': <T>, 'b': <T>] -> bool;
}
op ~= ['a': <T: Number>, 'b': <T>] -> bool {
    if 'a' < 'b' { return 'b' - 'a' < 10; }
    return 'a' - 'b' < 10;
}
struct A { x: int32 }
struct B { y: int32 }
op <+> ['a': A, 'b': A] -> int32 { return 'a'.x + 'b'.x; }
op <+> ['a': B, 'b': B] -> int32 { return 'a'.y x 'b'.y; }
MAIN {
    let 'm': int32 = 100;
    let mut 'k': int32 = 0;
    if 95 ~= 'm' { change 'k' = 1; }
    if 50 ~= 'm' { change 'k' = 'k' + 2; }
    let 'p' := A[x = 3];
    let 'q' := B[y = 3];
    nocheck exit['k' + ('p' <+> 'p') x 10 + ('q' <+> 'q') x 100];
}
