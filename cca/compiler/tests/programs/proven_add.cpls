# A value from outside, guarded until Precog can prove the addition cannot
# leave an int32 — so the binary carries the plain instruction with the fact
# attached, and no check. Not foldable: nobody knows what getpid returns.
extern fn getpid [] -> int32;
extern fn exit ['code': int32];

MAIN {
    nocheck let 'n' := getpid[];
    if 'n' > 0 {
        if 'n' < 1000 {
            let 'x': int32 = 'n' + 1;
            nocheck exit[0];
        }
    }
    nocheck exit[0];
}
