# A bin operation is done at its answer's width: a bin32 with a bare literal
# is a free-width bin, 64 bits, and an `fadd float` stored into its `double`
# left half of it garbage. The comparison takes the literal at the bin's.
extern fn exit ['code': int32];
MAIN {
    let 'x': bin32 = 16777216.0;
    let mut 'got': int32 = 0;
    let 'a' := 'x' + 1.0;
    let 'na' := to.int32['a' - 16777216.0] otherwise 99;
    if 'na' == 1 { 'got' = 'got' + 1; }
    let 'b': bin32 = 'x' + 1.0 + 1.0;
    let 'nb' := to.int32['b' - 16777216.0] otherwise 99;
    if 'nb' == 2 { 'got' = 'got' + 2; }
    let 'c': bin32 = 0.1;
    if 'c' == 0.1 { 'got' = 'got' + 4; }
    let 'd' := 'c' x 10.0;
    if 'd' > 0.99 and 'd' < 1.01 { 'got' = 'got' + 8; }
    let mut 'h': int32 = 0;
    check if 'x' > 0.0 { 'h' = to.int32['x' / 2.0] otherwise 0; }
    if 'h' == 8388608 { 'got' = 'got' + 16; }
    nocheck exit['got'];
}
