# `list.fill[value, count]` (owner, 2026-09-30): a list of count copies.
# The scores are 0 but one 7 (7); three flags, all false (30, and no 50);
# no ones (0); four int8s of 100, the fourth read back (100); two bins of
# 1.5, the second doubled (3). 7 + 30 + 0 + 100 + 3 = 140.
extern.C fn exit ['code': int32];
MAIN {
    let mut 'scores' := list.fill[0, 5];
    change 'scores'[3] = 7;
    let 'n': int64 = 3;
    let 'flags': list[bool] = list.fill[false, 'n'];
    let 'none': list[int32] = list.fill[1, 0];
    let 'eights': list[int8] = list.fill[100, 4];
    let 'bs': list[bin64] = list.fill[1.5, 2];
    let mut 'code': int64 = 0;
    for 'k': int64 in range[1, 5] {
        change 'code' = 'code' plus 'scores'['k'];
    }
    change 'code' = 'code' plus to.int64[list.length[lend 'flags']] times 10;
    if 'flags'[2] { change 'code' = 'code' plus 50; }
    change 'code' = 'code' plus to.int64[list.length[lend 'none']];
    change 'code' = 'code' plus to.int64['eights'[4]];
    let 'twice': int64 = to.int64['bs'[2] times 2.0] otherwise 0;
    change 'code' = 'code' plus 'twice';
    !check my.exit[to.int32['code']];
}
