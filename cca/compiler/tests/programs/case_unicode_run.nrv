# Insensitive means Unicode's full case folding (owner, 2026-10-06): `ß`
# matches `SS`, `É` matches `é`. A lone file has WSTN. 7 + 7 = 14.
case.insensitive [fn, var];
extern.C fn exit ['code': int32];

fn Größe [] -> int32 {
    return 7;
}

MAIN {
    let 'Café' := GRÖSSE[];
    no_check my.exit['CAFÉ' plus größe[]];
}
