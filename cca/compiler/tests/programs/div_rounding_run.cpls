# Every division says how it rounds (owner, 2026-10-02), worked out at run
# time: the values pass through C, so nothing is folded. `floor` down,
# `ceil` up, `trunc` toward zero, `near` to the nearest with a tie to even;
# `mod.X` is what `div.X` leaves. On a bin or deci `div.near` is ordinary
# division and the others give a whole quotient. The smallest int8 by -1
# is 128, exact where it lands. Each right group adds its own bit: 255.
extern.C fn exit ['code': int32];
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 's' := "x";
    nocheck let 'n': uint64 = strlen[lend 's'];
    let 'z': int32 = to.int32['n'] minus 1;
    let 'a': int32 = -7 plus 'z';
    let 'b': int32 = 2 plus 'z';
    let 'c': int32 = 5 plus 'z';
    let mut 'code': int32 = 0;
    if (('a' div.floor 'b') == -4) and (('a' div.ceil 'b') == -3) and (('a' div.trunc 'b') == -3) and (('a' div.near 'b') == -4) { change 'code' = 'code' plus 1; }
    if (('a' mod.floor 'b') == 1) and (('a' mod.ceil 'b') == -1) and (('a' mod.trunc 'b') == -1) and (('a' mod.near 'b') == 1) { change 'code' = 'code' plus 2; }
    if (('c' div.near 'b') == 2) and (('c' mod.near 'b') == 1) and ((7 div.near 'b') == 4) { change 'code' = 'code' plus 4; }
    let 'u': uint32 = to.uint32[7 plus 'z'];
    let 'v': uint32 = to.uint32[2 plus 'z'];
    if (('u' div.ceil 'v') == 4) and (('u' div.near 'v') == 4) and (('u' div.floor 'v') == 3) { change 'code' = 'code' plus 8; }
    let 'lo': int8 = to.int8[-128 plus 'z'];
    let 'm1': int8 = to.int8[-1 plus 'z'];
    let 'big': int16 = 'lo' div.trunc 'm1';
    if ('big' == 128) and (('lo' mod.near 'm1') == 0) { change 'code' = 'code' plus 16; }
    let 'one': bin64 = to.bin64[1 plus 'z'];
    let 'x': bin64 = 7.5 times 'one';
    let 'y': bin64 = 2.0 times 'one';
    if (('x' div.near 'y') == 3.75) and (('x' div.floor 'y') == 3.0) and (('x' mod.floor 'y') == 1.5) and (('x' div.ceil 'y') == 4.0) and (('x' mod.ceil 'y') == -0.5) { change 'code' = 'code' plus 32; }
    let 'h': brain16 = to.brain16[-5 plus 'z'];
    let 'k': brain16 = to.brain16[3 plus 'z'];
    if (('h' div.floor 'k') == -2.0) and (('h' mod.floor 'k') == 1.0) and (('h' div.trunc 'k') == -1.0) and (('h' mod.trunc 'k') == -2.0) { change 'code' = 'code' plus 64; }
    let 'p': deci64 = -7.5 plus to.deci64['z'];
    let 'q': deci64 = 2.0 plus to.deci64['z'];
    if (('p' div.near 'q') == -3.75) and (('p' div.floor 'q') == -4) and (('p' mod.floor 'q') == 0.5) and (('p' div.trunc 'q') == -3) and (('p' mod.trunc 'q') == -1.5) and (('p' mod.ceil 'q') == -1.5) { change 'code' = 'code' plus 128; }
    nocheck my.exit['code'];
}
