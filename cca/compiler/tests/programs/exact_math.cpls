# Plain math is exact, checked where it lands (owner, 2026-09-23): the
# cases of examples/overflow_sites.cpls, each adding its bit to the exit.
# The last line also pins a wrapping answer kept at its own width when
# stored wider: layer 1 used to fold 8000000000 for 'h'.
extern fn exit ['code': int32];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 'z' := "ab";
    nocheck let 'two': int64 = to.int64[strlen[lend 'z']];
    let 'small': int16 = to.int16['two'] + 3;
    let 'big': int64 = (20000 + 20000) + 'small';
    let 's': int16 = 30000;
    let 'twice': int64 = 's' + 's';
    let 'tiny': int8 = (100 + 100) - 150;
    let 'v': int8 = 112;
    let 'u': uint8 = 5;
    let 'below' := 'u' - 10;
    let 'x': uint32 = 4000000000;
    let 'h': uint64 = 'x' +~ 'x';
    let mut 'got': int64 = 0;
    if 'big' == 40005 { change 'got' = 'got' + 1; }
    if 'twice' == 60000 { change 'got' = 'got' + 2; }
    if 'tiny' == 50 { change 'got' = 'got' + 4; }
    if not ('v' > ('v' + 'v')) { change 'got' = 'got' + 8; }
    if 'below' == -5 { change 'got' = 'got' + 16; }
    if 'h' == 3705032704 { change 'got' = 'got' + 32; }
    if 'v' < 200 { change 'got' = 'got' + 64; }
    nocheck exit[to.int32['got']];
}
