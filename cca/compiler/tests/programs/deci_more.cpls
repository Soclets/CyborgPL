# deci's leftovers (owner, 2026-09-29), as examples/deci_more.cpls has
# them, checked by the program itself against the oracle's text: mod takes
# the divisor's sign, xx a whole exponent, a narrower deci fails
# too_many_digits, and a deci may be a range type. One point each: 19.
extern fn exit ['code': int32];
fn same ['v': deci64, 'want': str.utf8] -> int32 {
    if to.str.utf8['v'] == 'want' { return 1; }
    return 0;
}
fn in_unit ['v': deci64] -> int32 {
    'p' := to.deci64[0.0, 1.0]['v'] otherwise { out_of_range { return 0; } };
    if 'p' >/== 0.0 { return 1; }
    return 2;
}
MAIN {
    mut 'got': int32 = 0;
    't': deci64 = 7.50;
    'm': deci64 = -7.50;
    change 'got' = 'got' + same['t' mod 2, "1.50"] + same['m' mod 2, "0.50"] + same['t' mod -2, "-0.50"];
    'c': deci64 = -4.0;
    change 'got' = 'got' + same['c' mod 2, "0.0"] + same['c' mod -2, "-0.0"] + same['t' mod 0.7, "0.50"];
    'r': deci64 = 1.05;
    change 'got' = 'got' + same['r' xx 10, "1.628894626777441"] + same['r' xx 0, "1"] + same['r' xx -1, "0.9523809523809524"];
    'r2': deci128 = 1.05;
    if to.str.utf8['r2' xx 10] == "1.62889462677744140625" { change 'got' = 'got' + 1; }
    'n': int32 = 3;
    change 'got' = 'got' + same['r' xx 'n', "1.157625"] + same['c' xx 3, "-64.000"];
    'x': deci64 = 3.141592653589793;
    's': deci32 = 7;
    'y' := to.deci32['x'] otherwise 's';
    'z': deci64 = 2.50;
    'zz' := to.deci32['z'] otherwise 's';
    if to.str.utf8['y'] == "7" and to.str.utf8['zz'] == "2.50" { change 'got' = 'got' + 1; }
    'disc': deci64[0.0, 1.0] = 0.15;
    'p' := to.deci64[0.0, 1.0]["1.5"] otherwise 'disc';
    change 'got' = 'got' + same['disc', "0.15"] + same['p', "0.15"];
    change 'got' = 'got' + in_unit[0.25] + in_unit[1.5];
    'q' := to.deci64[0.0, 1.0]["0.5"] otherwise 'disc';
    change 'got' = 'got' + same['q', "0.5"];
    'e': int64 = 5;
    'f' := to.deci32[0.0, 10.0]['e'] otherwise 's';
    if to.str.utf8['f'] == "5" { change 'got' = 'got' + 1; }
    'w': bin64 = 5.5;
    'g' := to.deci64[0.0, 1.0]['w'] otherwise 'disc';
    change 'got' = 'got' + same['g', "0.15"];
    nocheck exit['got'];
}
