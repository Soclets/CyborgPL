# A loop that calls C stays in order by itself; `for para` runs it in
# slices anyway, the call's `nocheck` being the writer's word that the C
# is safe on many cores (owner, 2026-09-30). `labs` is: the sum of |i - 12345|
# mod 256 for i in 1 to 100000, as both loops give: 40 (worked out by hand;
# the oracle cannot link C).
extern fn exit ['code': int32];
extern fn labs ['n': int64] -> int64;
MAIN {
    'n': int64 = 100000;
    mut 'a': list[int64] = list.fill[0, 'n'];
    mut 'b': list[int64] = list.fill[0, 'n'];
    for para 'i': int64 in range[1, 'n'] {
        nocheck 'v' := labs['i' - 12345];
        change 'a'['i'] = 'v';
    }
    for 'i': int64 in range[1, 'n'] {
        nocheck 'v' := labs['i' - 12345];
        change 'b'['i'] = 'v';
    }
    mut 'same': int64 = 0;
    mut 's': int64 = 0;
    for 'k': int64 in range[1, 'n'] {
        if 'a'['k'] == 'b'['k'] { change 'same' = 'same' + 1; }
        change 's' = ('s' + 'a'['k']) mod 256;
    }
    if 'same' !== 'n' { nocheck exit[1]; }
    nocheck exit[to.int32['s']];
}
