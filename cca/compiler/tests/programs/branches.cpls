extern.C fn exit ['code': int32];

fn grade ['n': int32] -> int32 {
    if 'n' > 90 { return 1; }
    else if 'n' > 50 { return 2; }
    else { return 3; }
}

MAIN {
    let 'a': int32 = grade[95];
    let 'b': int32 = grade[60];
    let 'c': int32 = grade[10];
    nocheck exit[('a' times 100) plus ('b' times 10) plus 'c'];     # 123
}
