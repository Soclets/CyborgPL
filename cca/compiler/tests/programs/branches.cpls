extern fn exit ['code': int32];

fn grade ['n': int32] -> int32 {
    if 'n' > 90 { return 1; }
    else if 'n' > 50 { return 2; }
    else { return 3; }
}

MAIN {
    'a': int32 = grade[95];
    'b': int32 = grade[60];
    'c': int32 = grade[10];
    nocheck exit[('a' x 100) + ('b' x 10) + 'c'];     # 123
}
