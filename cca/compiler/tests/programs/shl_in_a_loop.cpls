# A `shl` whose answer leaves its type is stopped (check claude, seed
# 9148). Layer 3 asked only whether the count was 0 to 31 — it is, 5 down
# to 0 — never whether 2030534677 shifted still fits a uint32, "proved"
# the shift, and the binary printed wrapped values. It stops at the first.
extern.C fn exit ['code': int32];
fn f1 ['p1': int64] -> int32 {
    let mut 'w10': int8 = 6;
    let mut 'sum': uint64 = 0;
    loop {
        if 'w10' == 0 { break; }
        change 'w10' = 'w10' minus 1;
        let 'v': uint32 = to.uint32['p1' mod.floor 4294967296] shl to.uint32['w10'];
        change 'sum' = 'sum' plus to.uint64['v'];
    }
    return to.int32['sum' mod.floor 100];
}
MAIN {
    let 'x': int32 = f1[2030534677];
    nocheck exit['x'];
}
