# A character literal of several code points can only be a grapheme
# (types.md), with its unit unwritten too: e + a combining accent.
extern fn exit ['code': int32];
MAIN {
    'g' := `é`;
    't' := to.str.utf8['g'];
    mut 'got': int32 = 0;
    if str.bytes[lend 't'] == 3 and str.graphemes[lend 't'] == 1 { change 'got' = 'got' + 1; }
    if 'g' == `é` { change 'got' = 'got' + 2; }
    nocheck exit['got'];
}
