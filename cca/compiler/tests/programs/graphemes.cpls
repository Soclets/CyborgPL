# Graphemes (types.md): a char.grapheme is a text of its own; counts in
# points and grapheme clusters (UAX #29, extended: เกี่ยว is 4 clusters, 6
# points, 18 bytes); text <-> grapheme conversions; a text bound counted
# in graphemes, checked at run time. Values chosen at run time.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn short [lent 't': str.utf8] -> int32 {
    let 's': str.utf8[0, 2 graphemes] = to.str.utf8[0, 2 graphemes]['t'] otherwise { out_of_range { return 0; } };
    return 1;
}
MAIN {
    let 'k' := "CCA_SURELY_UNSET_VARIABLE";
    no_check let 'there' := ptr.is_null[getenv[lend 'k']];
    let mut 'w' := "ab";
    if 'there' { change 'w' = "เกี่ยว"; }
    let mut 'got': int32 = 0;
    if str.graphemes[lend 'w'] equal_to 4 and str.points[lend 'w'] equal_to 6 and str.bytes[lend 'w'] equal_to 18 { change 'got' = 'got' plus 1; }
    let 'g': char.grapheme = `é`;
    let 'p' := to.char.point['g'] otherwise `?`;
    if char.code['p'] equal_to 233 and 'g' equal_to `é` { change 'got' = 'got' plus 2; }
    let 'one' := to.char.grapheme["x" ++ 'w'] otherwise `?`;
    let 'syl' := to.char.grapheme["เกี่ยว"] otherwise `?`;
    let 'acc' := to.char.grapheme["é"] otherwise `?`;
    let 'at' := to.str.utf8['acc'];
    if 'one' equal_to `?` and 'syl' equal_to `?` and str.bytes[lend 'at'] equal_to 3 { change 'got' = 'got' plus 4; }
    let 'up' := to.char.grapheme[`x`];
    if to.str.utf8['up'] ++ "!" equal_to "x!" { change 'got' = 'got' plus 8; }
    if short[lend 'w'] equal_to 0 and short["ab"] equal_to 1 and short["abc"] equal_to 0 { change 'got' = 'got' plus 16; }
    no_check my.exit['got'];
}
