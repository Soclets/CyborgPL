extern fn exit ['code': int32];
MAIN {
    mut 'xs': list[int32] = [];
    for 'i': int32 in range[1, 100] {
        list.append[lend.mut 'xs', 'i'];
    }
    'len': int32 = list.length[lend 'xs'];
    'last': int32 = 'xs'[100];
    'first': int32 = list.remove[lend.mut 'xs', 1];
    'now_first': int32 = 'xs'[1];
    'shorter': int32 = list.length[lend 'xs'];
    nocheck exit['len' - 'last' + 'first' + 'now_first' + 'shorter' - 99];
}
