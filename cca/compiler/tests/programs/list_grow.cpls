extern.C fn exit ['code': int32];
MAIN {
    let mut 'xs': list[int32] = [];
    for 'i': int32 in range[1, 100] {
        list.append[lend.mut 'xs', 'i'];
    }
    let 'len': int32 = list.length[lend 'xs'];
    let 'last': int32 = 'xs'[100];
    let 'first': int32 = list.remove[lend.mut 'xs', 1];
    let 'now_first': int32 = 'xs'[1];
    let 'shorter': int32 = list.length[lend 'xs'];
    !check my.exit['len' minus 'last' plus 'first' plus 'now_first' plus 'shorter' minus 99];
}
