extern fn exit ['code': int32];
fn judge ['n': int32] -> fail[small, odd: int32] {
    if 'n' < 10 { fail small; }
    if ('n' mod 2) == 1 { fail odd['n']; }
}
MAIN {
    mut 'seen': int32 = 0;
    {
        concur with [] { judge[3] otherwise fail; }
            otherwise { small { change 'seen' = 'seen' + 1; } odd 'v' { change 'seen' = 'seen' + 100; } };
        concur with [] { judge[13] otherwise fail; }
            otherwise { small { change 'seen' = 'seen' + 1000; } odd 'v' { change 'seen' = 'seen' + 'v'; } };
        concur with [] { judge[20] otherwise fail; }
            otherwise { small { change 'seen' = 'seen' + 7; } odd 'v' { change 'seen' = 'seen' + 7; } };
    }
    nocheck exit['seen'];
}
