# A list literal's items take the element type as their context (owner,
# 2026-09-29: a): 0 -~ 1 in a list[uint8] wraps at 8 bits to 255, 250 +~ 10
# to 4; 2 shl 3 in a list[uint32] is 16 and not.bit 0 is 4294967295; a
# nested list passes it down (0 -~ 2 is 254); bare numbers alone stay exact
# (check claude's seed 197). examples/list_item_context.cpls as an exit
# code: one bit per right answer, 127.
extern.C fn exit ['code': int32];
fn flag ['b': bool, 'v': int32] -> int32 {
    if 'b' { return 'v'; }
    return 0;
}
MAIN {
    let 'i': uint8 = 5;
    let 'xs': list[uint8] = [0 minus.wrap 1, 0 minus.wrap 'i', 250 plus.wrap 10];
    let 'ys': list[uint32] = [2 shl 3, not.bit 0];
    let 'zs': list[list[uint8]] = [[0 minus.wrap 2,], [1,]];
    let 'big': list[uint64] = [9692729768110883998 minus 3166240359165959856,];
    let 'inner' := copy 'zs'[1];
    nocheck my.exit[flag['xs'[1] == 255, 1] plus flag['xs'[2] == 251, 2] plus flag['xs'[3] == 4, 4] plus flag['ys'[1] == 16, 8] plus flag['ys'[2] == 4294967295, 16] plus flag['inner'[1] == 254, 32] plus flag['big'[1] == 6526489408944924142, 64]];
}
