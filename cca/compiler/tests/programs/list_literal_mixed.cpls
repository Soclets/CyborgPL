# In a list literal, a bare number takes its family from the other items
# (owner, 2026-09-30: a), whichever comes first: [1, 2.5] is two bins, and
# [1, 'q'] with 'q' a deci is two decis. The oracle (9b29d6f):
# (1 + 5) + (1 + 0.5) x 2 + (1 + 5 - 3 + 10) + (0.1 + 1) x 10 = 6 + 3 + 13 + 11 = 33.
extern.C fn exit ['code': int32];
MAIN {
    let 'xs' := [1, 2.5];
    let 'q': deci64 = 0.5;
    let 'ds' := [1, 'q'];
    let 'ys': list[bin64] = [1, 2.5, -3];
    let 'es': list[deci64] = [0.1, 1];
    let 'a': int32 = to.int32['xs'[1] plus ('xs'[2] times 2.0)] otherwise 90;
    let 'b': int32 = to.int32[('ds'[1] plus 'ds'[2]) times 2] otherwise 91;
    let 'c': int32 = to.int32[('ys'[2] times 2.0) plus 'ys'[3] plus 'ys'[1] plus 10.0] otherwise 92;
    let 'd': int32 = to.int32[('es'[1] plus 'es'[2]) times 10] otherwise 93;
    nocheck exit['a' plus 'b' plus 'c' plus 'd'];
}
