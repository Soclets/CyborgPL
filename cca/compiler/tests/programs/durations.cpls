# Durations (concurrency.md): nanoseconds in 64 bits; literals in any unit,
# added, compared across units, subtracted while it stays a length.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
MAIN {
    let 'k' := "CCA_SURELY_UNSET_VARIABLE";
    nocheck let 'there' := ptr.is_null[getenv[lend 'k']];
    let mut 'a' := 5 seconds;
    if 'there' { 'a' = 1500 millis; }
    let 'b' := 'a' + 500 millis;
    let mut 'got': int32 = 0;
    if 'b' == 2 seconds { 'got' = 'got' + 1; }
    if 'b' > 1999999999 nanos and 'b' < 2001 millis { 'got' = 'got' + 2; }
    let 'c' := 'b' - 1 second;
    if 'c' == 1000 millis { 'got' = 'got' + 4; }
    nocheck exit['got'];
}
