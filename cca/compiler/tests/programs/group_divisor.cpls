# Bare numbers alone are worked out exactly (dc83c05), beside `div` and
# `mod` too (check claude, seed 4698): the group took the typed side's
# `uint8`, and its `221 x 2` was refused as 442. 7 mod 3 is 1, 7 div 3 is
# 2, 12 mod 7 is 5: 1 + 20 + 5 x 10 = 71.
extern.C fn exit ['code': int32];
MAIN {
    let 'p': uint8 = 7;
    let 'a': uint8 = 'p' mod.floor (((221 times 2) mod.floor 5) plus 1);
    let 'b': uint8 = 'p' div.floor (((221 times 2) mod.floor 5) plus 1);
    let 'c': uint8 = (((221 times 2) mod.floor 5) plus 10) mod.floor 'p';
    nocheck exit[to.int32['a'] plus to.int32['b'] times 10 plus to.int32['c'] times 10];
}
