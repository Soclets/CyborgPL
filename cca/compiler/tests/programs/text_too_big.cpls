# Text holding a number its type cannot hold fails `out_of_range`, however
# many digits, above or below; never a check site, never `not_a_number`
# (owner, 2026-09-24: c). `examples/text_to_number.cpls`.
extern.C fn exit ['code': int32];
fn read ['t': str.utf8] --> int32 {
    let 'v' := to.int32['t'] otherwise {
        not_a_number { return -1; }
        out_of_range { return -2; }
    };
    return 'v';
}
fn byte ['t': str.utf8] --> int32 {
    let 'v' := to.uint8['t'] otherwise {
        not_a_number { return -1; }
        out_of_range { return -2; }
    };
    return to.int32['v'];
}
MAIN {
    let mut 'got': int32 = 0;
    if read["99999999999"] == -2 { change 'got' = 'got' plus 1; }
    if read["99999999999999999999999999999999999999999999"] == -2 { change 'got' = 'got' plus 2; }
    if read["-99999999999999999999999999999999999999999999"] == -2 { change 'got' = 'got' plus 4; }
    if byte["-1"] == -2 and byte["256"] == -2 and byte["255"] == 255 { change 'got' = 'got' plus 8; }
    if read["2147483647"] == 2147483647 and read["-2147483648"] == -2147483648 { change 'got' = 'got' plus 16; }
    if read["12x"] == -1 and byte["x"] == -1 { change 'got' = 'got' plus 32; }
    let 'b' := to.int64["99999999999999999999999999999999999999999999"] otherwise -1;
    if 'b' == -1 { change 'got' = 'got' plus 64; }
    !check my.exit['got'];
}
