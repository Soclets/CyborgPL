# Text holding a number its type cannot hold fails `out_of_range`, however
# many digits, above or below; never a check site, never `not_a_number`
# (owner, 2026-09-24: c). `examples/text_to_number.cpls`.
extern fn exit ['code': int32];
fn read ['t': str.utf8] -> int32 {
    'v' := to.int32['t'] otherwise {
        not_a_number { return -1; }
        out_of_range { return -2; }
    };
    return 'v';
}
fn byte ['t': str.utf8] -> int32 {
    'v' := to.uint8['t'] otherwise {
        not_a_number { return -1; }
        out_of_range { return -2; }
    };
    return to.int32['v'];
}
MAIN {
    mut 'got': int32 = 0;
    if read["99999999999"] == -2 { change 'got' = 'got' + 1; }
    if read["99999999999999999999999999999999999999999999"] == -2 { change 'got' = 'got' + 2; }
    if read["-99999999999999999999999999999999999999999999"] == -2 { change 'got' = 'got' + 4; }
    if byte["-1"] == -2 and byte["256"] == -2 and byte["255"] == 255 { change 'got' = 'got' + 8; }
    if read["2147483647"] == 2147483647 and read["-2147483648"] == -2147483648 { change 'got' = 'got' + 16; }
    if read["12x"] == -1 and byte["x"] == -1 { change 'got' = 'got' + 32; }
    'b' := to.int64["99999999999999999999999999999999999999999999"] otherwise -1;
    if 'b' == -1 { change 'got' = 'got' + 64; }
    nocheck exit['got'];
}
