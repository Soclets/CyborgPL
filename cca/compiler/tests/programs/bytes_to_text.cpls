# Bytes read as text (owner, 2026-09-30: "yea"): `to.str.utf8` reads a
# list or array of uint8 as UTF-8, and fails `not_utf8` when they are not.
# 104 195 169 108 108 111 is "héllo": 5 points, 6 bytes; 255 is never
# UTF-8, so 'b' is "not" (3 bytes); the array is "hi" (2 bytes).
# 5 x 16 + 6 + 3 + 2 = 91.
extern fn exit ['code': int32];
MAIN {
    'good': list[uint8] = [104, 195, 169, 108, 108, 111];
    'bad': list[uint8] = [104, 255, 105];
    'arr': array[uint8] = [104, 105];
    'a' := to.str.utf8['good'] otherwise "?";
    'b' := to.str.utf8['bad'] otherwise "not";
    'c' := to.str.utf8['arr'] otherwise "?";
    'n': uint64 = str.points[lend 'a'] x 16 + str.bytes[lend 'a'] + str.bytes[lend 'b'] + str.bytes[lend 'c'];
    nocheck exit[to.int32['n']];
}
