# extern let (ffi.md): a C global, read and written as C's own variable.
# getopt's optind starts at 1; written 5, read back 5: 1 x 10 + 5 = 15.
extern.C fn exit ['code': int32];
extern.C mut 'optind': int32;
MAIN {
    !check let 'first' := 'optind';
    !check change 'optind' = 5;
    !check let 'after' := 'optind';
    !check my.exit['first' times 10 plus 'after'];
}
