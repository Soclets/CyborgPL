# extern let (ffi.md): a C global, read and written as C's own variable.
# getopt's optind starts at 1; written 5, read back 5: 1 x 10 + 5 = 15.
extern fn exit ['code': int32];
extern mut 'optind': int32;
MAIN {
    nocheck 'first' := 'optind';
    nocheck change 'optind' = 5;
    nocheck 'after' := 'optind';
    nocheck exit['first' x 10 + 'after'];
}
