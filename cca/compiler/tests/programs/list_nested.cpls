extern.C fn exit ['code': int32];
MAIN {
    let mut 'grid': list[list[int32]] = [[1, 2], [3, 4]];
    let mut 'row': list[int32] = [5, 6, 7];
    list.append[lend.mut 'grid', give 'row'];
    let 'copy_of': list[list[int32]] = copy 'grid';
    let 'rows': int32 = list.length[lend 'grid'];
    let 'third': int32 = 'grid'[pos 3][pos 3];
    let 'crows': int32 = list.length[lend 'copy_of'];
    no_check my.exit['rows' plus 'third' plus 'crows'];
}
