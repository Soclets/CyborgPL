extern fn exit ['code': int32];
MAIN {
    mut 'grid': list[list[int32]] = [[1, 2], [3, 4]];
    mut 'row': list[int32] = [5, 6, 7];
    list.append[lend.mut 'grid', give 'row'];
    'copy_of': list[list[int32]] = copy 'grid';
    'rows': int32 = list.length[lend 'grid'];
    'third': int32 = 'grid'[3][3];
    'crows': int32 = list.length[lend 'copy_of'];
    nocheck exit['rows' + 'third' + 'crows'];
}
