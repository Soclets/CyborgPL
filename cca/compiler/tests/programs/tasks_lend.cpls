extern fn exit ['code': int32];
fn work ['n': int32] -> int32 { return 'n' x 2; }
fn fill [lent.mut 'into': list[int32], 'from': int32] {
    for 'i': int32 in range[1, 5] {
        list.append[lend.mut 'into', 'from' + 'i'];
    }
}
MAIN {
    let mut 'a': list[int32] = [];
    let mut 'b': list[int32] = [];
    {
        concur with [lend.mut 'a'] { fill[lend.mut 'a', 10]; }
        concur with [lend.mut 'b'] { fill[lend.mut 'b', 20]; }
        concur work[4];
    }
    let 'la': int32 = list.length[lend 'a'];
    let 'lb': int32 = list.length[lend 'b'];
    let 'last': int32 = 'b'[pos 5];
    nocheck exit['la' + 'lb' + 'last'];
}
