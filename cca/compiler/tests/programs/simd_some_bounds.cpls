# `simd.load.some`'s k items must be in the list (owner, 2026-09-27: a): a
# count Precog cannot see is checked at run time, and past the end it traps.
extern fn getpid [] -> int32;
extern fn exit ['code': int32];
MAIN {
    'xs': list[int32] = [1, 2, 3];
    nocheck 'p': int32 = getpid[];
    'k': uint64 = to.uint64[('p' - 'p') + 3];
    'v': simd[int32, 4] = simd.load.some[lend 'xs', 2, 'k'];
    nocheck exit[simd.sum['v']];
}
