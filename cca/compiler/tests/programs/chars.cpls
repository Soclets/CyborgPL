# Characters (types.md, conversion.md): a point is its code, 32 bits; a
# byte 8. The code by name, from a code failing not_a_char (a point is a
# Unicode scalar, a byte 0-255), text <-> char and point -> byte as
# failing conversions, a char as text (a byte as the point of its number,
# the oracle's reading), `==` across units, and `++` beside text. Values
# are known only at run time: whether an unset variable is there.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn point ['code': int64] -> uint32 {
    'c' := char.point.from_code['code'] otherwise { not_a_char { return 0; } };
    return char.code['c'];
}
fn byte ['code': int64] -> uint8 {
    'c' := char.byte.from_code['code'] otherwise { not_a_char { return 0; } };
    return char.code['c'];
}
MAIN {
    'k' := "CCA_SURELY_UNSET_VARIABLE";
    nocheck 'there' := ptr.is_null[getenv[lend 'k']];
    mut 'd': int64 = 0;
    if 'there' { change 'd' = 1; }
    mut 'got': int32 = 0;
    if point[55295 + 'd'] == 0 and point[57344 - 'd'] == 0 and point[-'d'] == 0 and point[1114110 + 'd'] == 1114111 { change 'got' = 'got' + 1; }
    if byte[199 + 'd'] == 200 and byte[255 + 'd'] == 0 and point['d' - 1] == 0 { change 'got' = 'got' + 2; }
    'b200' := char.byte.from_code[199 + 'd'] otherwise `?`;
    't' := to.str.utf8['b200'];
    if str.bytes[lend 't'] == 2 { change 'got' = 'got' + 4; }
    mut 'e' := "Z";
    if 'there' { change 'e' = "é"; }
    'p' := to.char.point['e'] otherwise `?`;
    'y' := to.char.byte['p'] otherwise `?`;
    if char.code['p'] == 233 and 'y' == `?` { change 'got' = 'got' + 8; }
    'two' := to.char.point['e' ++ "x"] otherwise `?`;
    'none' := to.char.byte["" ++ 'e'] otherwise `!`;
    if 'two' == `?` and 'none' == `!` { change 'got' = 'got' + 16; }
    'bb': char.byte = `A`;
    mut 'pp': char.point = `B`;
    if 'there' { change 'pp' = `A`; }
    if 'bb' == 'pp' { change 'got' = 'got' + 32; }
    'j' := 'p' ++ "!" ++ 'pp';
    if 'j' == "é!A" { change 'got' = 'got' + 64; }
    nocheck exit['got'];
}
