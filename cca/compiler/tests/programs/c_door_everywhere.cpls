# C's numbers are checked wherever they come in (owner, 2026-09-27): a
# `ptr.read` of a C enum, and what C wrote through a `ptr.mut` lent to it,
# checked when the call ends; `NO_FUCKING_CHECKS` trusts them instead. The
# oracle cannot link calloc, memset or memcpy, so the answer is worked out
# by hand: calloc's 0 is no key, after the write the read is b, memset's
# 0x41414141 is no key, memcpy's b and a are keys, and the trusted read is b
# — each right answer is one bit, 1 + 2 + 4 + 8 + 16 = 31.
extern.C fn exit ['code': int32];
extern.C fn calloc ['n': uint64, 'size': uint64] -> ptr.mut[Key];
extern.C fn free ['p': ptr.mut[Key]];
extern.C fn memset ['s': ptr.mut[Key], 'c': int32, 'n': uint64] -> ptr.mut[Key];
extern.C fn memcpy ['d': ptr.mut[Key], 's': ptr[Key], 'n': uint64] -> ptr.mut[Key];
layout.C enum Key { a = 65  b = 66  escape = 256 }

fn num ['k': Key] -> int32 {
    match 'k' {
        a { return 1; }
        b { return 2; }
        escape { return 3; }
    }
}

fn flag ['b': bool, 'v': int32] -> int32 {
    if 'b' { return 'v'; }
    return 0;
}

fn by_memset [] -> int32 {
    let mut 'keys': list[Key] = [Key.a, Key.a];
    nocheck let 'q' := memset[lend.mut 'keys', 65, 8] otherwise { out_of_range { return 3; } };
    return 0;
}

fn by_memcpy [] -> int32 {
    let 'src': list[Key] = [Key.b, Key.a];
    let mut 'dst': list[Key] = [Key.escape, Key.escape];
    nocheck let 'q' := memcpy[lend.mut 'dst', lend 'src', 8] otherwise { out_of_range { return 9; } };
    return num[copy 'dst'[1]] + num[copy 'dst'[2]] x 2;
}

MAIN {
    nocheck let 'p' := calloc[1, 4];
    nocheck let 'zero' := ptr.read['p'] otherwise Key.escape;
    nocheck ptr.write['p', Key.b];
    nocheck let 'two' := ptr.read['p'] otherwise Key.escape;
    NO_FUCKING_CHECKS let 'trusted' := ptr.read['p'];
    nocheck free['p'];
    let 'bits' := flag[num[give 'zero'] == 3, 1] + flag[num[give 'two'] == 2, 2] + flag[by_memset[] == 3, 4] + flag[by_memcpy[] == 4, 8] + flag[num[give 'trusted'] == 2, 16];
    nocheck exit['bits'];
}
