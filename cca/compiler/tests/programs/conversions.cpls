# Conversions that can fail: text into a whole number (not_a_number), a bin
# into one (not_whole, or out_of_range when too big: owner, 2026-09-30),
# and anything into a range type (out_of_range).
extern.C fn exit ['code': int32];
fn read ['t': str.utf8] --> int32 {
    let 'v' := to.int32['t'] otherwise {
        not_a_number { return -1; }
        out_of_range { return -3; }
    };
    return 'v';
}
fn percent ['t': str.utf8] --> int32 {
    let 'v' := to.int32[0, 100]['t'] otherwise {
        not_a_number { return -1; }
        out_of_range { return -2; }
    };
    return 'v';
}
fn whole ['x': bin64] --> int32 {
    let 'v' := to.int32['x'] otherwise {
        not_whole { return -1; }
        out_of_range { return -4; }
    };
    return 'v';
}
MAIN {
    let mut 'got': int32 = 0;
    if read["42"] == 42 { change 'got' = 'got' plus 1; }
    let 'b' := to.int64["-7"] otherwise -1;
    if 'b' == -7 { change 'got' = 'got' plus 2; }
    if read["4x2"] == -1 and read[""] == -1 and read["-"] == -1 { change 'got' = 'got' plus 4; }
    if percent["150"] == -2 and percent["-1"] == -2 and percent["x"] == -1 { change 'got' = 'got' plus 8; }
    if percent["+99"] == 99 and percent["0"] == 0 { change 'got' = 'got' plus 16; }
    if whole[2.0] == 2 and whole[2.7] == -1 and whole[-3.0] == -3 and whole[10000000000.0] == -4 { change 'got' = 'got' plus 32; }
    let 'n': int64 = 150;
    let 'h' := to.int32[0, 100]['n'] otherwise 7;
    if 'h' == 7 { change 'got' = 'got' plus 64; }
    let 'i' := to.uint8[" 1"] otherwise 3;
    if 'i' == 3 { change 'got' = 'got' plus 128; }
    !check my.exit['got' mod.floor 256];
}
