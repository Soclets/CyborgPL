# 3 xx 50 is past any 64-bit type: the check in between stops it.
extern fn exit ['code': int32];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    's' := "ab";
    nocheck 'two': int64 = to.int64[strlen[lend 's']];
    'p': int64 = ('two' + 1) xx ('two' x 25);
    nocheck exit[to.int32['p' mod 256]];
}
