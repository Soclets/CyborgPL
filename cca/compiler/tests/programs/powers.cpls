# Powers at run time: by squaring, each multiply checked only when the
# answer needs it; xx~ wraps at its values' size. Each true case adds a bit.
extern fn exit ['code': int32];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    's' := "ab";
    nocheck 'two': int64 = to.int64[strlen[lend 's']];
    mut 'got': int64 = 0;
    if 'two' xx 10 == 1024 { change 'got' = 'got' + 1; }
    if ('two' + 1) xx 0 == 1 { change 'got' = 'got' + 2; }
    if (0 - 'two') xx 3 == -8 { change 'got' = 'got' + 4; }
    'w': uint8 = to.uint8['two' + 1];
    'e5': uint8 = to.uint8['two' + 3];
    if 'w' xx~ 'e5' == 243 { change 'got' = 'got' + 8; }
    'e6': uint8 = to.uint8['two' + 4];
    if 'w' xx~ 'e6' == 217 { change 'got' = 'got' + 16; }
    nocheck exit[to.int32['got']];
}
