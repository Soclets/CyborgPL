# `simd[bool, N]` is a type you can write (owner, 2026-09-27: a): a function
# takes one, `simd.fill[true]` makes one, and `not`/`and`/`or` work lane by
# lane. The answers are examples/simd_mask.cpls', read out as an exit code.
extern fn exit ['code': int32];

fn all_on ['m': simd[bool, 4]] -> bool {
    return simd.all['m'];
}

fn flag ['b': bool, 'v': int32] -> int32 {
    if 'b' { return 'v'; }
    return 0;
}

MAIN {
    'xs': array[int32] = [5, 20, 30, 40];
    'a': simd[int32, 4] = simd.load[lend 'xs', pos 1];
    'm': simd[bool, 4] = 'a' > simd.fill[10];
    'all': simd[bool, 4] = simd.fill[true];
    'both' := 'm' and 'all';
    'flip' := not 'm';
    'either' := 'flip' or 'm';
    'few': simd[bool, 16] = simd.fill[false];
    nocheck exit[flag[simd.any['m'], 1] + flag[simd.all['m'], 2] + flag[all_on['both'], 4] + flag[simd.any['flip'], 8] + flag[simd.all['either'], 16] + flag[simd.any['few'], 32]];   # 1 + 8 + 16 = 25
}
