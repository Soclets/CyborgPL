# A remainder is not monotone in the dividend: both ends of `uint64` leave 0
# when divided by 255 or 65535 (2^64 - 1 is a multiple of each), and layer 1
# took the ends for the whole range and folded "always 0" (check claude,
# generator seed 106). `strlen` is extern, so its answer is any `uint64`.
extern.C fn exit ['code': int32];
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 's' := "three hundred characters are too many to type, so this is fewer";
    nocheck let 'n': uint64 = strlen[lend 's'];
    let 'a': uint64 = 'n' mod.floor 255;
    let 'b': uint64 = 'n' mod.floor 65535;
    nocheck exit[to.int32['a' plus 'b']];
}
