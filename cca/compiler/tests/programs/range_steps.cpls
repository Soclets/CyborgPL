# A step past the counter's last value is never taken (control-flow.md,
# owner 2026-09-23), and a negative step counts a uint64 down.
extern.C fn exit ['code': int32];
MAIN {
    let mut 't': int32 = 0;
    for 'i': uint8 in range[1, 0, -2] { change 't' = 't' + 1; }
    for 'i': uint8 in range[250, 255, 3] { change 't' = 't' + 1; }
    for 'i': int8 in range[120, 127, 5] { change 't' = 't' + 1; }
    for 'i': int8 in range[-120, -128, -5] { change 't' = 't' + 1; }
    for 'i': uint64 in range[3, 1, -1] { change 't' = 't' + 1; }
    for 'i': int64 in range[9223372036854775806, 9223372036854775807, 2] { change 't' = 't' + 1; }
    nocheck exit['t'];
}
