# A call's answer of a range type, checked where it was made: the caller
# tells LLVM its range (owner, 2026-09-29: c), so a loop bounded by it is
# worked out at 64 bits. `pick` gives 3 here (no CCA_NO_SUCH_VARIABLE),
# and the sum of 1 to 3 is 6.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn pick [] -> int64[0, 1000] or fail[missing] {
    let 'key' := "CCA_NO_SUCH_VARIABLE";
    nocheck let 'p' := getenv[lend 'key'];
    if ptr.is_null['p'] { return 3; }
    fail missing;
}
MAIN {
    let 'n' := pick[] otherwise 0;
    let mut 'sum': int64 = 0;
    let mut 'i': int64 = 1;
    while 'i' </== 'n' {
        change 'sum' = 'sum' + 'i';
        change 'i' = 'i' + 1;
    }
    nocheck exit[to.int32['sum']];
}
