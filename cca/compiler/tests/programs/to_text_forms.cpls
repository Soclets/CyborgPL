# Text in two forms (owner, 2026-09-30): `to.str.utf8` the exact value,
# `to.useful.str.utf8` the useful one, as the oracle prints them. Each
# form that reads as expected counts one: 22 in all.
extern fn exit ['code': int32];

enum Size {
    small
    big
}

layout.c enum Mode {
    off = 0
    on = 7
}

MAIN {
    mut 'got': int32 = 0;
    'x': bin64 = 0.1;
    if to.str.utf8['x'] == "0.1000000000000000055511151231257827021181583404541015625" { change 'got' = 'got' + 1; }
    if to.useful.str.utf8['x'] == "0.1" { change 'got' = 'got' + 1; }
    'd': deci64 = 1.50;
    if to.str.utf8['d'] == "1.50" { change 'got' = 'got' + 1; }
    if to.useful.str.utf8['d'] == "1.5" { change 'got' = 'got' + 1; }
    'm': deci64 = 100;
    if to.useful.str.utf8['m'] == "100" { change 'got' = 'got' + 1; }
    'n': int32 = 42;
    if to.str.utf8['n'] == "42" { change 'got' = 'got' + 1; }
    if to.useful.str.utf8['n'] == "42" { change 'got' = 'got' + 1; }
    'ok' := true;
    if to.str.utf8['ok'] == "true" { change 'got' = 'got' + 1; }
    if to.useful.str.utf8['ok'] == "true" { change 'got' = 'got' + 1; }
    's' := Size.big;
    if to.str.utf8['s'] == "Size.big" { change 'got' = 'got' + 1; }
    if to.useful.str.utf8['s'] == "big" { change 'got' = 'got' + 1; }
    'o' := Mode.on;
    if to.str.utf8['o'] == "Mode.on" { change 'got' = 'got' + 1; }
    if to.useful.str.utf8['o'] == "on" { change 'got' = 'got' + 1; }
    'g': bin32 = 0.1;
    if to.useful.str.utf8['g'] == "0.1" { change 'got' = 'got' + 1; }
    'b': bin64 = 100.0;
    if to.useful.str.utf8['b'] == "100" { change 'got' = 'got' + 1; }
    'c': bin64 = 0.000001;
    if to.useful.str.utf8['c'] == "0.000001" { change 'got' = 'got' + 1; }
    'e': bin64 = -2.25;
    if to.useful.str.utf8['e'] == "-2.25" { change 'got' = 'got' + 1; }
    'f': bin64 = 123456789012345678.0;
    if to.useful.str.utf8['f'] == "123456789012345680" { change 'got' = 'got' + 1; }
    'h': bin64 = 0.0;
    if to.useful.str.utf8['h'] == "0" { change 'got' = 'got' + 1; }
    'k': bin64 = 10000000000000000.0;
    if to.useful.str.utf8['k'] == "10000000000000000" { change 'got' = 'got' + 1; }
    'l': bin64 = 0.0001;
    if to.useful.str.utf8['l'] == "0.0001" { change 'got' = 'got' + 1; }
    'p': bin64 = 1000000000000000000000000000000.0;
    if to.useful.str.utf8['p'] == "1000000000000000000000000000000" { change 'got' = 'got' + 1; }
    nocheck exit['got'];
}
