# `/` floors and `mod` takes the divisor's sign (operators.md). The values
# come from C so that the division happens at run time, not in Precog.
extern.C fn exit ['code': int32];
extern.C fn abs ['v': int32] --> int32;
MAIN {
    !check let 'seven': int32 = abs[-7];
    let 'a': int32 = (0 minus 'seven') div.floor 2;       # -4
    let 'b': int32 = (0 minus 'seven') mod.floor 2;     # 1
    let 'c': int32 = 'seven' div.floor -2;            # -4
    let 'd': int32 = 'seven' mod.floor -2;          # -1
    !check my.exit[('a' plus 4) times 1000 plus ('b' minus 1) times 100 plus ('c' plus 4) times 10 plus ('d' plus 1) plus 42];
}
