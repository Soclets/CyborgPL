# A function hands back a borrow (owner, 2026-09-29): `-> lent@x T`, where
# `@x` names a lifetime group; left out, as in `first`, the body says what
# the result depends on (examples/lifetimes.cpls as an exit code: "hello",
# "hi" and "hello" are 5, 2 and 5 bytes → 5 x 100 + 2 x 10 + 5 = 525,
# which exits as 525 mod 256 = 13).
extern fn exit ['code': int32];
fn longer [lent@x 'a': str.utf8, lent@x 'b': str.utf8] -> lent@x str.utf8 {
    if str.bytes[lend 'a'] >/== str.bytes[lend 'b'] { return lend 'a'; }
    return lend 'b';
}
fn pick [lent@x 'a': str.utf8, lent@y 'b': str.utf8] -> lent@x str.utf8 {
    return lend 'a';
}
fn first [lent 'a': str.utf8] -> lent str.utf8 {
    return lend 'a';
}
fn width [lent 's': str.utf8] -> int32 {
    let 'n' := str.bytes[lend 's'];
    if 'n' > 1000 { return 0; }
    return to.int32['n'];
}
fn run [] -> int32 {
    let 's' := "hello";
    let 't' := "hi";
    let 'l' := longer[lend 's', lend 't'];
    let 'p' := pick[lend 't', lend 's'];
    let 'f' := first[lend 's'];
    return width[lend 'l'] x 100 + width[lend 'p'] x 10 + width[lend 'f'];
}
MAIN {
    nocheck exit[run[]];
}
