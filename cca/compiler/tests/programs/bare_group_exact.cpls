# "Bare numbers alone are worked out exactly at compile time" (operators.md),
# `/` and `mod` too, with no 64-bit window in between: only where the answer
# lands is checked. (2^64 - 1 + 1) mod 1 is 0; it was refused, in a loop and
# out of one (check claude, attack a: 2026-09-24-bare-sum-past-64-in-loop).
extern.C fn exit ['code': int32];
MAIN {
    let mut 'v': uint64 = 9;
    let mut 'w': uint16 = 2;
    loop {
        if 'w' == 0 { break; }
        change 'w' = 'w' - 1;
        change 'v' = (18446744073709551615 + 1) mod.floor 1;
    }
    let 'u': uint64 = (18446744073709551615 x 4) div.floor 2 - 18446744073709551615 - 1;
    let 't': int8 = ((1000 x 1000) mod.floor 7) - (200 + 100) div.floor 3;
    nocheck exit[to.int32['v'] + to.int32['u' mod.floor 256] + to.int32['t'] + 100];
}
