# A borrow handed back through a call with no group (check claude,
# 2026-09-29): `b1`'s body hands back only 'b', so `b2`'s result is in @x.
fn b1 [lent 'a': list[int32], lent 'b': list[int32]] -> lent list[int32] {
    return lend 'b';
}
fn b2 @x @y [lent@y 'a': list[int32], lent@x 'b': list[int32]] -> lent@x list[int32] {
    return b1[lend 'a', lend 'b'];
}
extern.C fn exit ['code': int32];
MAIN {
    let 's': list[int32] = [1,];
    let 't': list[int32] = [2, 3];
    let 'r' := b2[lend 's', lend 't'];
    nocheck my.exit[to.int32[list.length[lend 'r']]];
}
