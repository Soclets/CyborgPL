# A call's answer stored into a narrower type is asked there, like any
# other value: `twice` gives 2 here (no CCA_NO_SUCH_VARIABLE is set), and
# 2 is no int32[0, 1]. Filled straight into the place, it was never asked
# — the store held 2 and Precog believed the type (the oracle: "2 does not
# fit int32[0, 1]").
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn twice ['d': int32] -> int32 {
    return 'd' x 2;
}
fn one [] -> int32 {
    'key' := "CCA_NO_SUCH_VARIABLE";
    nocheck 'p' := getenv[lend 'key'];
    if ptr.is_null['p'] { return 1; }
    return 0;
}
MAIN {
    'c': int32[0, 1] = twice[one[]];
    nocheck exit[7];
}
