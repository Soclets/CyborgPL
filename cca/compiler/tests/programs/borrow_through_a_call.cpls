# A function hands back the borrow another call handed it (check claude,
# 2026-09-29, 46faa74): `second`'s result borrows its own lent 'a', through
# `first`. The oracle prints 2 for the same program.
extern fn exit ['code': int32];
fn first [lent 'a': list[int32]] -> lent list[int32] { return lend 'a'; }
fn second [lent 'a': list[int32]] -> lent list[int32] { return first[lend 'a']; }
MAIN {
    's': list[int32] = [1, 2, 3];
    'r' := second[lend 's'];
    nocheck exit['r'[2]];
}
