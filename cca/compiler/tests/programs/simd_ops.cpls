# simd[T, N] (simd.md): fill, load, store, the lane-wise operators with
# their checks, and the folds all, any, max, sum. Each true case adds its bit.
# A store used to leave Precog believing the list unchanged, and an `if`
# about a stored element was folded to false.
extern fn exit ['code': int32];
fn is_ascii [lent 'bytes': array[uint8]] -> bool {
    let mut 'acc': simd[uint8, 16] = simd.fill[0];
    for 'i' in range[1, array.length[lend 'bytes'], 16] {
        'acc' = 'acc' or.bit simd.load[lend 'bytes', pos 'i'];
    }
    return simd.max['acc'] < 128;
}
MAIN {
    let 'plain': array[uint8] = [72, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100, 33, 33, 33, 33, 33];
    let 'thai': array[uint8] = [72, 101, 108, 108, 111, 32, 224, 184, 129, 108, 100, 33, 33, 33, 33, 33];
    let mut 'got': int32 = 0;
    if is_ascii[lend 'plain'] { 'got' = 'got' + 1; }
    if not is_ascii[lend 'thai'] { 'got' = 'got' + 2; }
    let 'a': simd[int32, 4] = simd.fill[10];
    let 'b': simd[int32, 4] = simd.fill[3];
    if simd.sum['a'] == 40 { 'got' = 'got' + 4; }
    if simd.max['a' x 'b'] == 30 { 'got' = 'got' + 8; }
    let 'm' := 'a' > 'b';
    if simd.all['m'] { 'got' = 'got' + 16; }
    if not simd.any['b' > 'a'] { 'got' = 'got' + 32; }
    let mut 'out': array[int32] = [0, 0, 0, 0, 0, 0];
    simd.store[lend.mut 'out', pos 2, 'a' + 'b'];
    if 'out'[pos 1] == 0 and 'out'[pos 2] == 13 and 'out'[pos 5] == 13 and 'out'[pos 6] == 0 { 'got' = 'got' + 64; }
    nocheck exit['got'];
}
