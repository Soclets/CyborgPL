# The brain float (owner, 2026-10-02): `brain16`, `bfloat16`, `bf16`. Literals
# round to the nearest, each step rounds, and it converts to and from every
# number family and text, both forms of each. The oracle gives 66.
extern.C fn exit ['code': int32];
MAIN {
    let 'a': brain16 = 0.1;
    let 'b': bf16 = 0.2;
    let 'c': bfloat16 = 'a' + 'b';
    let 'x': bin64 = 300.7;
    let 'w' := to.brain16['x'];
    let 'back' := to.bin32['w'];
    let 'n' := to.int32['w'] otherwise -1;
    let 'cc' := to.int32[to.bin64['c'] x 100000000.0] otherwise -1;
    let 's' := to.useful.str.utf8['a'];
    let 't' := to.stored.str.utf8['a'];
    let 'd' := to.useful.deci64['c'];
    let 'ds' := to.stored.deci64['a'];
    let 'p' := to.brain16["2.5"] otherwise 0;
    let 'q' := to.brain16[100000];
    let 'xs': list[brain16] = [0.5, 1.5, 2.5];
    let 'h' := to.bin16['w'];
    let 'k1' := to.int32['d' x 10] otherwise -1;
    let 'k2' := to.int32['ds' x 100000000000] otherwise -1;
    let 'k3' := to.int32['p' x 'xs'[3]] otherwise -1;
    let 'k4' := to.int32['q'] otherwise -1;
    let 'k5' := to.int32['h'] otherwise -1;
    let 'k6' := to.int32['back'] otherwise -1;
    let 'total' := 'n' + ('cc' mod 1000) + str.bytes[lend 's'] + str.bytes[lend 't'] + 'k1' + ('k2' mod 1000) + 'k3' + ('k4' mod 1000) + 'k5' + 'k6';
    nocheck exit[to.int32['total' mod 256]];
}
