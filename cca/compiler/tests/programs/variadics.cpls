# Variadics (functions.md): a bundle of any number of values, typed or each
# its own; lent or owned; `...'xs'` unpacking a list (literal, bounded with
# a length known only at run time, or a bundle passed on), `...copy` and
# `...give` of owned elements. The call builds the bundle.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
fn sum [...'nums'] -> bin64 {
    mut 'total': bin64 = 0.0;
    for 'n' in lend 'nums' { change 'total' = 'total' + to.bin64['n']; }
    return 'total';
}
fn add [...'nums': int32] -> int32 {
    mut 'total': int32 = 0;
    for 'n' in lend 'nums' { change 'total' = 'total' + 'n'; }
    return 'total';
}
fn count [...'nums': int32] -> uint64 { return list.length[lend 'nums']; }
fn bytes [lent 'label': str.utf8, lent ...'parts': str.utf8] -> uint64 {
    mut 'n': uint64 = str.bytes[lend 'label'];
    for 'p' in lend 'parts' { change 'n' = 'n' + str.bytes[lend 'p']; }
    return 'n';
}
fn pass_on [lent ...'parts': str.utf8] -> uint64 { return bytes["x", ...'parts']; }
fn keep [...'names': str.utf8] -> uint64 { return list.length[lend 'names']; }
MAIN {
    'k' := "CCA_SURELY_UNSET_VARIABLE";
    nocheck 'there' := ptr.is_null[getenv[lend 'k']];
    mut 'got': int32 = 0;
    mut 'three': int32 = 4;
    if 'there' { change 'three' = 3; }
    if sum[1, 2.5, 'three'] == 6.5 and sum[] == 0.0 { change 'got' = 'got' + 1; }
    if add[4, 5, 'three'] == 12 and count[4, 5, 6] == 3 and count[] == 0 { change 'got' = 'got' + 2; }
    'xs' := [1, 2, 'three'];
    if add[...'xs'] == 6 and add[10, ...'xs', 20] == 36 { change 'got' = 'got' + 4; }
    mut 'ys': list[int32][0, 4] = list.empty;
    list.append[lend.mut 'ys', 7];
    if 'there' { list.append[lend.mut 'ys', 8]; }
    if add[...'ys'] == 15 and count[...'ys', 1] == 3 { change 'got' = 'got' + 8; }
    'name' := "Ann";
    if bytes["mixed", lend 'name', "yo"] == 10 and bytes["none"] == 4 and pass_on[lend 'name', "b"] == 5 { change 'got' = 'got' + 16; }
    mut 'words' := ["a", "bb"];
    if 'there' { change 'words' = ["a", "bcd"]; }
    if keep[...copy 'words'] == 2 and list.length[lend 'words'] == 2 { change 'got' = 'got' + 32; }
    if keep[...give 'words'] == 2 and list.length[lend 'words'] == 0 { change 'got' = 'got' + 64; }
    nocheck exit['got'];
}
