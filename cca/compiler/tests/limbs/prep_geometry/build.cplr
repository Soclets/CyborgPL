# Run by `cca prepare` in its own Limb's folder (owner, 2026-09-29): it
# says its name, and stops with 9 unless its folder's marker is beside it.
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] --> int64;
extern.C fn access ['path': ptr[uint8], 'mode': int32] --> int32;
extern.C fn exit ['code': int32];
MAIN {
    let 'at' := "here-geometry";
    !check let 'found' := access[lend 'at', 0];
    if 'found' !== 0 { !check my.exit[9]; }
    let 'say' := "geometry";
    let 'nl': list[uint8] = [10,];
    !check let 'w' := write[1, lend 'say', 8];
    !check let 'e' := write[1, lend 'nl', 1];
    !check my.exit[0];
}
