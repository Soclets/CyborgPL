# A Limb's own operators (owner, 2026-10-03): areas' `mean` and `mean.low`,
# bare or with the Limb's path, `'x' areas::mean.low 'y'`. 3 and 4: the mean
# is 3.5 and the low mean 3.0, so 3.5 times 2 is 7, the low one 3, and 3
# times 10 is 30: 7 + 3 + 30 = 40.
extern.C fn exit ['code': int32];
MAIN {
    let 'x': bin64 = 3.0;
    let 'y': bin64 = 4.0;
    let 'a': int32 = to.int32[('x' mean 'y') times 2.0] otherwise 0;
    let 'b': int32 = to.int32['x' areas::mean.low 'y'] otherwise 0;
    let 'c': int32 = to.int32[('x' mean.low 'y') times 10.0] otherwise 0;
    let 'd': int32 = to.int32[('x' areas::mean 'y') times 2.0] otherwise 0;
    nocheck exit['a' plus 'b' plus 'c' plus 'd' minus 7];
}
