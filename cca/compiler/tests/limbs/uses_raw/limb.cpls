# What examples/raw_numbers prints, as an exit code: one bit per value
# that came out as its bits read (128 in an int8 is -128, 255 in a uint8
# is 255, 40000 in an int16 is -25536, 200 as an int8 argument is -56,
# 255 changed into an int8 is -1, and a struct's 255s are 255 and -1);
# all seven right is 127.
extern.C fn exit ['code': int32];
fn bit ['ok': bool, 'n': int32] --> int32 {
    if 'ok' { return 'n'; }
    return 0;
}
MAIN {
    let 'p' := raw::in_a_struct[];
    let 'a' := bit[raw::min_int8[] == -128, 1] plus bit[raw::all_ones[] == 255, 2] plus bit[raw::wide[] == -25536, 4];
    let 'b' := bit[raw::through_an_argument[] == -56, 8] plus bit[raw::after_a_change[] == -1, 16];
    let 'c' := bit['p'.lo == 255, 32] plus bit['p'.hi == -1, 64];
    !check my.exit['a' plus 'b' plus 'c'];
}
