# Run by `cca prepare` in its own Limb's folder (owner, 2026-09-29): it
# says its name, and stops with 9 unless its folder's marker is beside it.
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern fn access ['path': ptr[uint8], 'mode': int32] -> int32;
extern fn exit ['code': int32];
MAIN {
    let 'at' := "here-app";
    nocheck let 'found' := access[lend 'at', 0];
    if 'found' !== 0 { nocheck exit[9]; }
    let 'say' := "app";
    let 'nl': list[uint8] = [10,];
    nocheck let 'w' := write[1, lend 'say', 3];
    nocheck let 'e' := write[1, lend 'nl', 1];
    nocheck exit[0];
}
