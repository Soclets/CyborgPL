# refuse: the value can be outside what a `uint64` holds
# A case's data lands where a field's does, and is checked there (check claude,
# seed 15174): -5 into a `uint64` case wrapped to 2^64 - 5, unchecked.
extern.C fn exit ['code': int32];
enum E1 {
    c1: uint32
    c4: uint64
}
MAIN {
    let 'e' := E1.c4[0 minus 5];
    match 'e' {
        c1 'a' { nocheck my.exit[1]; }
        c4 'b' { nocheck my.exit[to.int32['b' mod.floor 256]]; }
    }
}
