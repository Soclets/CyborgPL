# Every way a test ends (testing.md, owner 2026-09-29), as `cca test` reports
# it: outcomes.test-out, the oracle's words but for a check that fires, which
# CCA says in its own. A test goes on after its `must.stop` (after_stop).
fn half ['n': int32] -> int32 or fail[odd] {
    if ('n' mod 2) == 1 { fail odd; }
    return 'n' div 2;
}
test fn plain_bool [] {
    let 'b': bool = false;
    must 'b';
}
test fn no_fail [] {
    must.fail to.int32["12"];
}
test fn no_stop [] {
    let 'xs': list[int32] = [1, 2, 3];
    must.stop 'xs'[2];
}
test fn stops_anyway [] {
    let 'xs': list[int32] = [1, 2, 3];
    let 'i': int64 = 7;
    let 'y' := 'xs'['i'];
    must 'y' == 1;
}
test fn fails_ok [] {
    must.fail half[3];
    must.fail.odd half[3];
    let 'h' := half[4] otherwise 0;
    must 'h' == 2;
}
test fn and_expr [] {
    must 1 < 2 and 3 < 2;
}
test fn texts [] {
    let 's': str.utf8 = "abc";
    must 's' == "abd";
}
test fn after_stop [] {
    let 'xs': list[int32] = [1, 2, 3];
    must.stop 'xs'[99];
    must 'xs'[1] == 1;
    must 'xs'[2] == 5;
}
MAIN { }
