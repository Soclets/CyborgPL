extern.C fn exit ['code': int32];
extern.C fn strlen ['s': ptr[uint8]] --> uint64;
fn r ['d': int32[0, 12], 'v': uint8, 'w': uint16] --> int8 {
    if 'd' >/== 12 {
        return to.int8['v'];
    }
    return r['d' plus 1, 'v', 'w'];
}
MAIN {
    let 's' := "x";
    !check let 'n': uint64 = strlen[lend 's'];
    let 'w': uint16 = to.uint16['n' mod.floor 65536];
    let 'a' := r[0, 6, 'w'];
    let 'b' := r[12, 4, 'w'];
    !check my.exit[to.int32['a' plus 'b']];
}
