# A function that calls itself on a larger argument is not proven by
# induction on the arguments: that call is to a tuple not yet done, which
# can be anything the return type holds. up(98) is past an int64 in truth.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] --> ptr[uint8];
extern.C fn atoll ['s': ptr[uint8]] --> int64[0, 100];
fn up ['n': int64[0, 100]] --> int64 {
    if 'n' >/== 100 { return 1; }
    return up['n' plus 1] plus 9_000_000_000_000_000_000;
}
fn read_n ['text': ptr[uint8]] --> int64[0, 100] or fail[missing, out_of_range] {
    if ptr.is_null['text'] { fail missing; }
    !check let 'n' := atoll['text'] otherwise fail;
    return 'n';
}
fn run [] --> int32 or fail[missing, out_of_range] {
    let 'key' := "N";
    !check let 'n' := read_n[getenv[lend 'key']] otherwise fail;
    return to.int32[up['n'] mod.floor 256];
}
MAIN {
    let 'code' := run[] otherwise 2;
    !check my.exit['code'];
}
