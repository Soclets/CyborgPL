# A list appended to on only some trips is not in lock-step with the
# counter: its length is not n + 1, and indexing up to n must stay unproven.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] --> ptr[uint8];
extern.C fn atoi ['s': ptr[uint8]] --> int32;
MAIN {
    let 'k' := "N";
    !check let 'n': int64 = to.int64[atoi[getenv[lend 'k']]];
    let mut 'xs': list[bool] = [];
    let mut 'i': int64 = 0;
    while 'i' </== 'n' {
        if ('i' mod.floor 2) == 0 { list.append[lend.mut 'xs', true]; }
        change 'i' = 'i' plus 1;
    }
    let mut 'p': int64 = 1;
    let mut 'c': int64 = 0;
    while 'p' </== 'n' {
        if 'xs'[to.uint64['p']] { change 'c' = 'c' plus 1; }
        change 'p' = 'p' plus 1;
    }
    !check my.exit[to.int32['c' mod.floor 256]];
}
