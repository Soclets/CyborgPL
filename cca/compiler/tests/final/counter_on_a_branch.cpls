# A counter stepped on only some trips does not bound how many trips there
# are: for an odd N this loop goes round forever, and the sum overflows.
# The final build must not bound 'acc' by the counter.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn atoll ['s': ptr[uint8]] -> int64[0, 1000];
fn read_n ['text': ptr[uint8]] -> int64[0, 1000] or fail[missing, out_of_range] {
    if ptr.is_null['text'] { fail missing; }
    nocheck 'n' := atoll['text'] otherwise fail;
    return 'n';
}
fn run [] -> int32 or fail[missing, out_of_range] {
    'key' := "N";
    nocheck 'n' := read_n[getenv[lend 'key']] otherwise fail;
    mut 'acc': int64 = 0;
    mut 'i': int64 = 0;
    while 'i' </== 'n' {
        if ('n' mod 2) == 0 { change 'i' = 'i' + 1; }
        change 'acc' = 'acc' + 1_000_000_000_000;
    }
    return to.int32['acc' mod 256];
}
MAIN {
    'code' := run[] otherwise 2;
    nocheck exit['code'];
}
