# fib on 0 to 93, N from outside: fib(93) does not fit an int64, so the
# final build must refuse where it lands.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern.C fn atoll ['s': ptr[uint8]] -> int64[0, 93];
fn fib ['n': int64[0, 93]] -> int64 {
    if 'n' < 2 { return 'n'; }
    return fib['n' - 1] + fib['n' - 2];
}
fn read_n ['text': ptr[uint8]] -> int64[0, 93] or fail[missing, out_of_range] {
    if ptr.is_null['text'] { fail missing; }
    nocheck let 'n' := atoll['text'] otherwise fail;
    return 'n';
}
fn run [] -> int32 or fail[missing, out_of_range] {
    let 'key' := "N";
    nocheck let 'n' := read_n[getenv[lend 'key']] otherwise fail;
    return to.int32[fib['n'] mod.floor 256];
}
MAIN {
    let 'code' := run[] otherwise 2;
    nocheck exit['code'];
}
