# An average of int32 values fits an int32 (precog.md: "a sum bounded by n x
# max divided by n is at most max"), for a list whose length and contents
# come from outside. The final build accepts it with no checks left.
extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn atoi ['s': ptr[uint8]] -> int32;
fn average [lent 'xs': list[int32]] -> int32 or fail[empty] {
    if list.length[lend 'xs'] == 0 { fail empty; }
    mut 'total' := 0;
    for 'x' in lend 'xs' { change 'total' = 'total' + 'x'; }
    return 'total' / list.length[lend 'xs'];
}
MAIN {
    'k' := "N";
    nocheck 'n': int32 = atoi[getenv[lend 'k']];
    mut 'xs': list[int32][0, 1000] = list.empty;
    mut 'i': int32 = 0;
    while 'i' < 'n' and 'i' < 1000 {
        list.append[lend.mut 'xs', ('n' mod 1000) - 'i'];
        change 'i' = 'i' + 1;
    }
    'a' := average[lend 'xs'] otherwise 0;
    nocheck exit['a' mod 256];
}
