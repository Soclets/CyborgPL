# An average of int32 values fits an int32 (precog.md: "a sum bounded by n x
# max divided by n is at most max"), for a list whose length and contents
# come from outside. The final build accepts it with no checks left.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] --> ptr[uint8];
extern.C fn atoi ['s': ptr[uint8]] --> int32;
fn average [lent 'xs': list[int32]] --> int32 or fail[empty] {
    if list.length[lend 'xs'] == 0 { fail empty; }
    let mut 'total' := 0;
    for 'x' in lend 'xs' { change 'total' = 'total' plus 'x'; }
    return 'total' div.floor list.length[lend 'xs'];
}
MAIN {
    let 'k' := "N";
    !check let 'n': int32 = atoi[getenv[lend 'k']];
    let mut 'xs': list[int32][0, 1000] = list.empty;
    let mut 'i': int32 = 0;
    while 'i' < 'n' and 'i' < 1000 {
        list.append[lend.mut 'xs', ('n' mod.floor 1000) minus 'i'];
        change 'i' = 'i' plus 1;
    }
    let 'a' := average[lend 'xs'] otherwise 0;
    !check my.exit['a' mod.floor 256];
}
