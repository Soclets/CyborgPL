# The same give, after the borrow's last use: nothing still looks at 's'.
fn eat ['s': str.utf8] { }
fn first [lent 'a': str.utf8] -> lent str.utf8 { return lend 'a'; }
fn len [lent 's': str.utf8] -> uint64 { return str.bytes[lend 's']; }
MAIN {
    's' := "hello";
    'l' := first[lend 's'];
    'n' := len[lend 'l'];
    eat[give 's'];
}
