# A list of N numbers (i mod 1000 for i = 1 to N), then summed ten times by
# position; the exit code is the sum's low byte. N comes from the
# environment and must be 0 to 100_000_000; anything else ends the program
# with exit code 2.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] --> ptr[uint8];
extern.C fn atoll ['s': ptr[uint8]] --> int64[0, 100_000_000];

# N, from the text in the environment: missing when there is none, and out
# of range when it is not a number this program takes.
fn read_n ['text': ptr[uint8]] --> int64[0, 100_000_000] or fail[missing, out_of_range] {
    if ptr.is_null['text'] { fail missing; }
    !check let 'n' := atoll['text'] otherwise fail;
    return 'n';
}

fn run [] --> int32 or fail[missing, out_of_range] {
    let 'key' := "N";
    !check let 'n' := read_n[getenv[lend 'key']] otherwise fail;
    let mut 'xs': list[int64] = [];
    let mut 'i': int64 = 1;
    while 'i' </== 'n' {
        list.append[lend.mut 'xs', 'i' mod.floor 1000];
        change 'i' = 'i' plus 1;
    }
    let mut 'acc': int64 = 0;
    let mut 'r': int64 = 0;
    while 'r' < 10 {
        let mut 'j': uint64 = 1;
        while 'j' </== list.length[lend 'xs'] {
            change 'acc' = 'acc' plus 'xs'['j'];
            change 'j' = 'j' plus 1;
        }
        change 'r' = 'r' plus 1;
    }
    return to.int32['acc' mod.floor 256];
}

MAIN {
    let 'code' := run[] otherwise 2;
    !check my.exit['code'];
}
