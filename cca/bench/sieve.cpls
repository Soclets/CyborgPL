extern fn exit ['code': int32];
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn atoi ['s': ptr[uint8]] -> int32;
MAIN {
    let 'k' := "N";
    nocheck let 'n': int64 = to.int64[atoi[getenv[lend 'k']]];
    let mut 'comp': list[bool] = [];
    let mut 'i': int64 = 0;
    while 'i' <== 'n' {
        list.append[lend.mut 'comp', false];
        'i' = 'i' + 1;
    }
    let mut 'count': int64 = 0;
    let mut 'p': int64 = 2;
    while 'p' <== 'n' {
        if not 'comp'[pos to.uint64['p' + 1]] {
            'count' = 'count' + 1;
            let mut 'm': int64 = 'p' x 'p';
            while 'm' <== 'n' {
                'comp'[pos to.uint64['m' + 1]] = true;
                'm' = 'm' + 'p';
            }
        }
        'p' = 'p' + 1;
    }
    nocheck exit[to.int32['count' mod 256]];
}
