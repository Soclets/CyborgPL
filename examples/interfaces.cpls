# Interfaces (design/interfaces.md): a named list of promises about some <T>.
interface Ordered {
    op < ['a': <T>, 'b': <T>] -> bool;
    op == ['a': <T>, 'b': <T>] -> bool;
}

interface Printable {
    fn show [lent 'x': <T>] -> str.utf8;
}

struct Vec { x: bin64  y: bin64 }

# a struct keeps a promise by having the operations — the language's own operators
# may be defined for a user type (never for the language's types)
op < ['a': Vec, 'b': Vec] -> bool { return ('a'.x x 'a'.x + 'a'.y x 'a'.y) < ('b'.x x 'b'.x + 'b'.y x 'b'.y); }
op == ['a': Vec, 'b': Vec] -> bool { return 'a'.x == 'b'.x and 'a'.y == 'b'.y; }
fn show [lent 'v': Vec] -> str.utf8 { return "(" ++ to.str.utf8['v'.x] ++ ", " ++ to.str.utf8['v'.y] ++ ")"; }

Vec satisfies Ordered;        # optional: a claim the compiler checks
Vec satisfies Printable;

# a generic asks for the promise on one mention of the blank
fn max ['a': <T: Ordered>, 'b': <T>] -> <T> {
    if 'b' < 'a' { return give 'a'; }     # a <T> may be owned, so generic code writes the verbs;
    return give 'b';                       # for a plain T (int32) the verb does nothing
}

fn describe [lent 'x': <T: Printable>] -> str.utf8 {
    return "value " ++ show[lend 'x'];
}

MAIN {
    let 'u' := Vec[x = 1, y = 2];
    let 'v' := Vec[x = 3, y = 4];
    let 'm' := max[copy 'u', copy 'v'];             # Vec is Ordered: it has < and ==
    std::printu.stdout[describe[lend 'm'], \n];
    std::printu.stdout[max[3, 9], " ", max[2.5, 1.5], \n];   # numbers are Ordered by the language
    std::printu.stdout['u' == 'v', " ", 'u' < 'v', \n];     # the operators work directly too
}
