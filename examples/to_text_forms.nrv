# Text in two forms (owner, 2026-09-30): `to.stored.str.utf8` is the exact value, as `print.stored` shows it;
# `to.useful.str.utf8` is the useful one, as `print.useful` shows it. `.useful` follows the verb.
enum Size {
    small
    big
}

MAIN {
    let 'x': bin64 = 0.1;
    let 'd': deci64 = 1.50;
    let 'n': int32 = 42;
    let 'ok' := true;
    let 's' := Size.big;
    cord::print.stored[to.stored.str.utf8['x'], " | ", to.useful.str.utf8['x'], newln];
    cord::print.stored[to.stored.str.utf8['d'], " | ", to.useful.str.utf8['d'], newln];
    cord::print.stored[to.stored.str.utf8['n'], " | ", to.useful.str.utf8['n'], newln];
    cord::print.stored[to.stored.str.utf8['ok'], " | ", to.useful.str.utf8['ok'], newln];
    cord::print.stored[to.stored.str.utf8['s'], " | ", to.useful.str.utf8['s'], newln];
    cord::print.useful['s', newln];
}
