MAIN {
    stdkit::print.stored["a\nb", newln];               # newln inside quotes is a backslash and an n
    stdkit::print.stored["say \"hi\"", newln];         # \" is the one escape that is needed
    stdkit::print.stored["back\\slash", newln];        # and \\ for the backslash itself
    stdkit::print.stored["tab	here", newln];           # a tab is typed, not escaped
    let 'nl' := newln;                              # the newline is the bare newln outside quotes
    stdkit::print.stored["one", 'nl', "two", 'nl'];
}
