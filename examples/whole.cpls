# bin → int fails unless the bin is whole (decided 2026-09-21), or `out_of_range` when it is whole but
# too big for the integer (owner, 2026-09-30: a). Rounding is said first.
MAIN {
    let 'x': bin64 = 2.0;
    let 'y': bin64 = 2.7;
    let 'a' := to.int32['x'] otherwise -1;                    # whole: 2
    let 'b' := to.int32['y'] otherwise -1;                    # not whole: fails → -1
    let 'c' := to.int32[stdkit::round['y']] otherwise -1;        # said: 3
    let 'd' := to.int32[stdkit::floor['y']] otherwise -1;        # said: 2
    let 'e' := to.int32[stdkit::trunc[0.0 minus 'y']] otherwise -1;  # said: -2
    stdkit::print.useful['a', " ", 'b', " ", 'c', " ", 'd', " ", 'e', newln];
    let 'big': bin64 = 10000000000.0;
    let 'g' := to.int32['big'] otherwise -1;                 # whole but too big for an int32: out_of_range → -1
    stdkit::print.useful['g', newln];
    let 'f' := to.int32['y'] otherwise {
        not_whole { stdkit::print.useful["2.7 is not whole", newln]; stdkit::exit[0]; }
        out_of_range { stdkit::print.useful["too big", newln]; stdkit::exit[0]; }
    };
}
