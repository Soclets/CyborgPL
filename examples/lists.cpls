fn count [lent 'items'] -> int32 {
    let 'n' := 0;
    for 'item' in lend 'items' {
        change 'n' = 'n' plus 1;
    }
    return 'n';
}

MAIN {
    let 'grid' := [[1, 2], [3, 4]];
    stdkit::print.useful.stdout['grid', newln];
    for 'row' in lend 'grid' {
        stdkit::print.useful.stdout[count[lend 'row'], newln];
    }
    stdkit::print.useful.stdout[count[["a", "b", "c"]], newln];
    let 'one' := [7,];
    stdkit::print.useful.stdout['one', " ", count[lend 'one'], newln];
}
