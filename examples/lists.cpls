fn count [lent 'items'] --> int32 {
    let 'n' := 0;
    for 'item' in lend 'items' {
        change 'n' = 'n' plus 1;
    }
    return 'n';
}

MAIN {
    let 'grid' := [[1, 2], [3, 4]];
    std::print.useful.stdout['grid', \n];
    for 'row' in lend 'grid' {
        std::print.useful.stdout[count[lend 'row'], \n];
    }
    std::print.useful.stdout[count[["a", "b", "c"]], \n];
    let 'one' := [7,];
    std::print.useful.stdout['one', " ", count[lend 'one'], \n];
}
