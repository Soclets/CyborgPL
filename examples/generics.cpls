# Generics (design/generics.md): a blank, <T>, filled per use by the compiler.
fn max ['a': <T>, 'b': <T>] -> <T> {
    if 'a' > 'b' { return give 'a'; }     # a <T> may be owned: generic code writes the verbs
    return give 'b';
}

fn first [lent 'xs': list[<T>]] -> <T> or fail[empty] {
    if list.length[lend 'xs'] == 0 { fail empty; }
    return 'xs'[1];
}

struct Pair { left: <A>  right: <B> }         # blanks in order of first appearance: A, B

enum Maybe { none  some: <T> }

fn describe [lent 'p': Pair[int32, str.utf8]] -> str.utf8 {
    return to.str.utf8['p'.left] ++ " " ++ 'p'.right;
}

MAIN {
    std::printu.stdout[max[3, 9], " ", max[2.5, 1.5], \n];       # int32 and bin64 versions, one source
    'nums' := [4, 5, 6];
    'f' := first[lend 'nums'] otherwise 0;
    std::printu.stdout['f', \n];
    'p': Pair[int32, str.utf8] = Pair[left = 7, right = "seven"];
    std::printu.stdout[describe[lend 'p'], \n];
    'm' := Maybe.some[42];
    match 'm' {
        none     { std::print.stdout["nothing", \n]; }
        some 'v' { std::printu.stdout["got ", 'v', \n]; }
    }
}
