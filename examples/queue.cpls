# `list.remove` hands the removed element back (decided 2026-09-21): no copy, no hole.

struct Job { name: str.utf8 }
fn run ['job': Job] { stdkit::print.useful.stdout["ran ", 'job'.name, newln]; }
MAIN {
    let mut 'queue' := [Job[name = "a"], Job[name = "b"], Job[name = "c"]];
    run[list.remove[lend.mut 'queue', 1]];              # straight into a call
    let 'next' := list.remove[lend.mut 'queue', 1];     # or kept
    run[give 'next'];
    list.remove[lend.mut 'queue', 1];                   # or dropped
    stdkit::print.useful.stdout[list.length[lend 'queue'], newln];
}
