# `&` works wherever `lent` does (owner, 2026-10-02: "Yes."): parameters, calls, function types, handed-back
# borrows (`--> &T`, `--> &mut T`) and lifetime groups (`&@x`, `&mut@x`).
fn first [&'a': str.utf8] --> &str.utf8 { return &'a'; }
fn longer @x [&@x 'a': str.utf8, &@x 'b': str.utf8] --> &@x str.utf8 {
    if str.bytes[&'a'] >/== str.bytes[&'b'] { return &'a'; }
    return &'b';
}
fn grow @y [&mut@y 'xs': list[int32]] --> &mut@y list[int32] { list.append[&mut 'xs', 9]; return &mut 'xs'; }
MAIN {
    let 's' := "hi";
    let 't' := "hello";
    let mut 'xs': list[int32] = [1, 2];
    std::print.useful.stdout[first[&'s'], " ", longer[&'s', &'t'], \n];
    grow[&mut 'xs'];
    std::print.useful.stdout['xs', \n];
}
