# Map keys (decided 2026-09-22): plain values, text, chars, structs and enums by structure —
# or a type's own `op ==` and `fn hash` (it satisfies `Key`), with "equal keys hash the same"
# a check site the compiler must prove.
interface Key <T> { op == ['a': <T>, 'b': <T>] -> bool;  fn hash [lent 'v': <T>] -> uint64; }

struct Point { x: int32  y: int32 }                      # structural: fields decide

struct User { name: str.utf8 }                           # its own rule: names compare lowercased
op == ['a': User, 'b': User] -> bool { return std::str.lower[lend 'a'.name] == std::str.lower[lend 'b'.name]; }
fn hash [lent 'v': User] -> uint64 { let 'low' := std::str.lower[lend 'v'.name]; return str.bytes[lend 'low']; }
User satisfies Key;

MAIN {
    let mut 'grid': map[Point, str.utf8] = map.empty;
    map.set[lend.mut 'grid', Point[x = 1, y = 2], "tree"];
    let 'at' := map.get[lend 'grid', Point[x = 1, y = 2]] otherwise "nothing";
    std::print.useful.stdout['at', \n];
    let mut 'users': map[User, int32] = map.empty;
    map.set[lend.mut 'users', User[name = "Ann"], 1];
    let 'n' := map.get[lend 'users', User[name = "ANN"]] otherwise 0;     # same key by User's own ==
    std::print.useful.stdout['n', \n];
}
