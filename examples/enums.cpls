enum Status {
    empty
    claimed: str.utf8
    locked
}

struct Locker {
    number: int32
    status: Status
}

fn describe [lent 'l': Locker] -> str.utf8 {
    match 'l'.status {
        empty         { return "free"; }
        claimed 'who' { return "taken by " ++ 'who'; }
        locked        { return "locked"; }
    }
}

MAIN {
    'lockers' := [
        Locker[number = 1, status = Status.empty],
        Locker[number = 2, status = Status.claimed["Tankun"]],
        Locker[number = 3, status = Status.locked]
    ];
    for 'l' in lend 'lockers' {
        std::printu.stdout["#", 'l'.number, ": ", describe[lend 'l'], \n];
    }
    's' := Status.locked;
    if 's' == Status.locked { std::print.stdout["== works on a case", \n]; }
    't' := Status.claimed["Bo"];
    std::print.stdout['t', \n];
}
