# A whole bin or deci too big for the integer fails `out_of_range`, beside `not_whole` (owner,
# 2026-09-30: a), as text that is too big does: one `otherwise` handles both.
MAIN {
    'b': bin64 = 10000000000.0;
    'd': deci128 = 99999999999999999999.0;
    'small': deci64 = 42.0;
    'x' := to.int32['b'] otherwise -1;
    'y' := to.int64['d' x 1000] otherwise -2;
    'z' := to.int64['small'] otherwise -3;
    'w' := to.int32['d'] otherwise 99;
    std::print.stdout['x', " ", 'y', " ", 'z', " ", 'w', \n];
}
