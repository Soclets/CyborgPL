# A pointer seen as pointing at another type (owner, 2026-09-30: a): `ptr.cast[T]['p']` keeps the
# address and whether it may write, and changes only what it claims to point at. Always nocheck.
extern fn malloc ['bytes': uint64] -> ptr.mut[uint8];
extern fn free ['p': ptr.mut[uint8]];

layout.c struct Point {
    x: int32
    y: int32
}

MAIN {
    nocheck let 'raw' := malloc[size.of[Point]];
    nocheck let 'p' := ptr.cast[Point]['raw'];
    nocheck ptr.write['p', Point[x = 3, y = 4]];
    nocheck let 'q' := ptr.read['p'];
    std::print.stored.stdout['q'.x, " ", 'q'.y, \n];
    nocheck free['raw'];
}
