# a whole-line comment
MAIN {
    var 'a' := [1];          # trailing: from here to the end of the line
    var 'b' := [2]; #wl this whole line is a comment, including the code before the #
    #3l these three lines
    var 'c' := [3];
    var 'd' := [4];
    var 'e' := [5]; #2ld this line and two more down
    var 'f' := [6];
    var 'g' := [7];
    std::printu.stdout['a' " " 'e' \n];
}
