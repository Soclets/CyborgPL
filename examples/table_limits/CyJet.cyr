cyjet::manifest[
    name = "table_limits",
    prefix = "table_limits",
    version = "1.0.0",
    dependencies = [cyjet::dep[id = "fff4302dffc4a894a2bab6baf724eb21dfc05a2ad9818509d8001013d6761936", version = "2026-10-06T12:57:14+07:00"],],
    # the largest table Precog may make for each target, in bytes; 65,536 when not written (owner, 2026-10-19)
    targets = [
        cyjet::target[name = "aarch64-macos", default = true, table_bytes = 262_144],
        cyjet::target[name = "aarch64-none", table_bytes = 4_096],   # a small board: small tables
    ]
];
