MAIN {
    let 'x': bin64 = 0.1;
    stdkit::print.stored.stdout['x', newln];
    stdkit::print.useful.stdout['x', newln];
    let 'y': bin16 = 1000;
    stdkit::print.useful.stdout['y', newln];
    let 'big' := 1_000_000 times 1_000_000;
    stdkit::print.stored.stdout['big', newln];
    let 's' := "x is " ++ to.stored.str.utf8['x'];
    stdkit::print.stored.stdout['s', newln];
    stdkit::print.useful.stdout['s', newln];
    stdkit::print.useful.stdout["x is ", 'x', newln];
}
