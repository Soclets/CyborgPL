MAIN {
    let 'x': bin64 = 0.1;
    cord::print.stored['x', newln];
    cord::print.useful['x', newln];
    let 'y': bin16 = 1000;
    cord::print.useful['y', newln];
    let 'big' := 1_000_000 times 1_000_000;
    cord::print.stored['big', newln];
    let 's' := "x is " ++ to.stored.str.utf8['x'];
    cord::print.stored['s', newln];
    cord::print.useful['s', newln];
    cord::print.useful["x is ", 'x', newln];
}
