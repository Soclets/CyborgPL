fn say ['n': int32] {
    let 'by3' := ('n' mod 3) == 0;
    let 'by5' := ('n' mod 5) == 0;
    if 'by3' and 'by5' {
        std::print.stdout["FizzBuzz", \n];
    } else if 'by3' {
        std::print.stdout["Fizz", \n];
    } else if 'by5' {
        std::print.stdout["Buzz", \n];
    } else {
        std::print.stdout['n', \n];
    }
}

MAIN {
    let immut 'limit': int32 = 15;
    let 'i' := 1;
    while 'i' </== 'limit' {
        say['i'];
        change 'i' = 'i' + 1;
    }
}
