func say [var.int32 'n'] {
    var 'by3' := [('n' mod 3) == 0];
    var 'by5' := [('n' mod 5) == 0];
    if ['by3' and 'by5'] {
        std::print.stdout["FizzBuzz" \n];
    } else.if ['by3'] {
        std::print.stdout["Fizz" \n];
    } else.if ['by5'] {
        std::print.stdout["Buzz" \n];
    } else {
        std::print.stdout['n' \n];
    }
}

MAIN {
    var.immut.int32 'limit' = [15];
    var 'i' := [1];
    loop.while ['i' <== 'limit'] {
        say['i'];
        'i' = ['i' + 1];
    }
}
