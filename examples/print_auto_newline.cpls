# `stdkit::print.useful.auto_newln` ends the line itself, so no `newln` is written (owner, 2026-09-30).
MAIN {
    stdkit::print.useful.auto_newln.stdout["Hello, World!"];
    let 'n' := 3;
    stdkit::print.useful.auto_newln.stdout["n is ", 'n'];
    stdkit::print.useful.stdout["the same, by hand: ", 'n', newln];
}
