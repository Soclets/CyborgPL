# Each core's words work once the Limb lists the core (owner, 2026-10-05/06): ASP's `to.` and
# `check`, IEG's `no_check`, Genny's generics, MCPS's `concur`; std for the operators and printing.

fn first <T>: any ['a': <T>, 'b': <T>] -> <T> {
    return 'a';
}

fn hello [] {
    stdkit::print.useful["from a task", newln];
}

MAIN {
    let 'n': int64 = to.int64["41"] otherwise 0;
    check change 'n' = 'n' plus 1;
    no_check change 'n' = 'n' times 1;
    stdkit::print.useful[first['n', 7], newln];
    concur hello[];
}
