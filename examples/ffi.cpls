# The door to the OS (design/ffi.md). The oracle cannot link C; it emulates
# write, exit, getenv, strlen, malloc, free so this runs.
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern.C fn malloc ['bytes': uint64] -> ptr.mut[uint8];
extern.C fn free ['p': ptr.mut[uint8]];

layout.C struct Timeval {
    sec: int64
    usec: int64
}

fn say [lent 'text': str.utf8] -> fail[io] {
    nocheck let 'n' := write[1, lend 'text', strlen[lend 'text']];   # a lend is the pointer; the call is a nocheck site
    if 'n' < 0 { fail io; }
}

MAIN {
    say["hello from write" ++ \n] otherwise std::exit[1];
    say["hello again" ++ \n] otherwise std::exit[1];

    let 'key' := "HOME";                            # the lent text ends where C expects a 0
    nocheck let 'home' := getenv[lend 'key'];
    if ptr.is_null['home'] { std::print.stored.stdout["no HOME", \n]; }
    else { nocheck if strlen['home'] > 0 { std::print.stored.stdout["HOME is set", \n]; } }

    nocheck let 'buf' := malloc[4];                 # bytes nobody owns
    nocheck ptr.write['buf', 72];
    nocheck ptr.write[ptr.at['buf', 1], 105];
    nocheck std::print.useful.stdout[ptr.read['buf'], " ", ptr.read[ptr.at['buf', 1]], \n];
    nocheck free['buf'];

    std::print.useful.stdout[size.of[int32], " ", size.of[Timeval], " ", align.of[int64], " ", size.of[ptr[uint8]], \n];
}
