# whichever, timers, structured tasks, a task that fails (design/concurrency.md, 2026-09-22).
fn fetch [lent 'url': str.utf8] -> str.utf8 or fail[no_network] {
    if 'url' equal_to "down.com" { fail no_network; }
    return "page of " ++ 'url';
}

MAIN {
    let 'inbox' := channel[str.utf8][0, 10];
    let 'shutdown' := channel[bool];
    concur with [lend 'inbox'] { channel.send[lend 'inbox', "first"]; channel.send[lend 'inbox', "second"]; }
    concur with [lend 'shutdown'] { channel.send[lend 'shutdown', true]; }
    let 'deadline' := stdkit::time.after[5 seconds];
    for 'i' in range[1, 4] {
        whichever {
            'msg' from lend 'inbox'    { stdkit::print.useful.stdout["got ", 'msg', newln]; }
            'why' from lend 'shutdown' { stdkit::print.useful.stdout["shutdown", newln]; }
            'now' from lend 'deadline' { stdkit::print.useful.stdout["timed out after ", 'now', newln]; }
        } otherwise { closed { stdkit::print.useful.stdout["all closed", newln]; } };
    }
    {
        concur { stdkit::print.useful.stdout["task in a block", newln]; }
        stdkit::print.useful.stdout["block body", newln];
    }
    stdkit::print.useful.stdout["after the block", newln];
    concur with [lend 'inbox'] { let 'p' := fetch["down.com"] otherwise fail; channel.send[lend 'inbox', give 'p']; }
        otherwise { no_network { stdkit::print.useful.stdout["offline", newln]; } };
    let 'tick' := stdkit::time.every[1 second];
    let 't' := channel.take[lend 'tick'] otherwise 0 seconds;
    stdkit::print.useful.stdout["tick ", 't', newln];
}
