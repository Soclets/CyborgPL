fn draw ['y': bin16] { std::printu.stdout["drawing ", 'y', \n]; }
MAIN {
    let 'x' := 70000;
    if 'x' > 65_504 {
        std::print.stdout["too big", \n];
    } else {
        check let 'y': bin16 = 'x';
        draw['y'];
    }
    let 'xs' := [1, 2, 3];
    check {
        for 'i' in range[1, list.length[lend 'xs']] {
            std::printu.stdout['xs'[pos 'i'], " "];
        }
    }
    std::print.stdout[\n];
    nocheck 'xs'[pos 2] = 9;
    check if 'x' > 0 { 'xs'[pos 1] = 'x' / 2; }
    std::printu.stdout['xs', \n];
}
