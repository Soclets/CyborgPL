# `shout` is case-insensitive (`case.insensitive [fn, struct, field, const];` in its `limb.cpls`), so
# this Neuron reaches its names in any case, with the path and bare (owner, 2026-10-06).
MAIN {
    print.useful[shout::SHOUT["hey"], " ", WHISPER[], " ", shout::'VOLUME', newln];
    let 'l' := shout::LEVEL[LOUD = true];
    print.useful['l'.loud, newln];
}
