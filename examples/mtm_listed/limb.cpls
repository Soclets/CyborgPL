# MTM, "Maybe Too Much" (owner, 2026-10-06): other spellings of what Signatar, IEG and std already
# have. With MTM listed, each works beside the main one.

fn shout [&'s': str.utf8] -> str.utf8 {    # `lent 's': str.utf8` and `-->`
    return 's' ++ "!";
}

MAIN {
    let immut 'x': i32 = 20;              # `let !mut 'x': int32`
    let mut 'y': int32 = 0;
    nocheck change 'y' = 'x' times 2;     # `!check`
    let 'word' := "hey";
    if not ('y' == 0) {                    # `! ('y' == 0)`
        std::print.weird.useful.stdout << shout[& 'word'] << " " << 'y' << \n;   # `lend`, `<--`
    }
}
