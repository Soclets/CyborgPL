# extern.C 'x': T — a C global (decided 2026-09-21). Reading or writing it is a nocheck site.
extern.C 'lib_version': int32;              # C: extern int lib_version;
extern.C mut 'lib_verbose': int32;          # C: extern int lib_verbose;  (we may write it)

MAIN {
    !check let 'v' := 'lib_version';
    std::print.useful.stdout["version ", 'v', \n];
    !check change 'lib_verbose' = 1;
    !check let 'on' := 'lib_verbose';
    std::print.useful.stdout["verbose ", 'on', \n];
}
