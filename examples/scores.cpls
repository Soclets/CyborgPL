fn is_even ['n': int32] --> bool {
    return ('n' mod.floor 2) == 0;
}

fn clamp ['n': int32, 'low': int32, 'high': int32] --> int32 {
    if 'n' < 'low' {
        return 'low';
    } else if 'n' > 'high' {
        return 'high';
    } else {
        return 'n';
    }
}

MAIN {
    let 'scores' := [72, 95, 38, 100, 61, 87];

    let 'count' := 0;
    let 'total' := 0;
    let 'evens' := 0;
    let 'best' := 0;

    for 'score' in lend 'scores' {
        change 'count' = 'count' plus 1;
        change 'total' = 'total' plus 'score';
        if is_even['score'] {
            change 'evens' = 'evens' plus 1;
        }
        if 'score' > 'best' {
            change 'best' = 'score';
        }
    }

    let 'average' := 'total' div.floor 'count';
    let 'curved' := clamp['average' plus 10, 0, 100];

    std::print.useful.stdout["scored ", 'count', " tests", \n];
    std::print.useful.stdout["total ", 'total', ", best ", 'best', \n];
    std::print.useful.stdout["even scores: ", 'evens', \n];
    std::print.useful.stdout["average ", 'average', ", curved ", 'curved', \n];

    if 'average' >/== 90 {
        std::print.useful.stdout["grade A", \n];
    } else if 'average' >/== 75 {
        std::print.useful.stdout["grade B", \n];
    } else {
        std::print.useful.stdout["keep going", \n];
    }
}
