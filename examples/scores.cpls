fn is_even ['n': int32] -> bool {
    return ('n' mod 2) == 0;
}

fn clamp ['n': int32, 'low': int32, 'high': int32] -> int32 {
    if 'n' < 'low' {
        return 'low';
    } else if 'n' > 'high' {
        return 'high';
    } else {
        return 'n';
    }
}

MAIN {
    'scores' := [72, 95, 38, 100, 61, 87];

    'count' := 0;
    'total' := 0;
    'evens' := 0;
    'best' := 0;

    for 'score' in lend 'scores' {
        change 'count' = 'count' + 1;
        change 'total' = 'total' + 'score';
        if is_even['score'] {
            change 'evens' = 'evens' + 1;
        }
        if 'score' > 'best' {
            change 'best' = 'score';
        }
    }

    'average' := 'total' / 'count';
    'curved' := clamp['average' + 10, 0, 100];

    std::printu.stdout["scored ", 'count', " tests", \n];
    std::printu.stdout["total ", 'total', ", best ", 'best', \n];
    std::printu.stdout["even scores: ", 'evens', \n];
    std::printu.stdout["average ", 'average', ", curved ", 'curved', \n];

    if 'average' >== 90 {
        std::printu.stdout["grade A", \n];
    } else if 'average' >== 75 {
        std::printu.stdout["grade B", \n];
    } else {
        std::printu.stdout["keep going", \n];
    }
}
