fn is_even ['n': int32] -> bool {
    return ('n' mod 2) == 0;
}

fn clamp ['n': int32, 'low': int32, 'high': int32] -> int32 {
    if 'n' < 'low' {
        return 'low';
    } else if 'n' > 'high' {
        return 'high';
    } else {
        return 'n';
    }
}

MAIN {
    let 'scores' := [72, 95, 38, 100, 61, 87];

    let 'count' := 0;
    let 'total' := 0;
    let 'evens' := 0;
    let 'best' := 0;

    for temp 'score' in lend 'scores' {
        'count' = 'count' + 1;
        'total' = 'total' + 'score';
        if is_even['score'] {
            'evens' = 'evens' + 1;
        }
        if 'score' > 'best' {
            'best' = 'score';
        }
    }

    let 'average' := 'total' / 'count';
    let 'curved' := clamp['average' + 10, 0, 100];

    std::printu.stdout["scored " 'count' " tests" \n];
    std::printu.stdout["total " 'total' ", best " 'best' \n];
    std::printu.stdout["even scores: " 'evens' \n];
    std::printu.stdout["average " 'average' ", curved " 'curved' \n];

    if 'average' >== 90 {
        std::printu.stdout["grade A" \n];
    } else if 'average' >== 75 {
        std::printu.stdout["grade B" \n];
    } else {
        std::printu.stdout["keep going" \n];
    }
}
