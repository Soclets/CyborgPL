#strict
# In a #strict file a bare nested `match` is a statement, and a nested match that is the value
# says `giveS` (owner, 2026-09-29).
enum Order { cancelled  paid }
enum Ship { pickup  post }
fn handle ['o': Order, 's': Ship] {
    match 'o' {
        cancelled { }
        paid {
            match 's' {
                pickup { std::print.useful.stdout["counter", \n]; }
                post { std::print.useful.stdout["mail", \n]; }
            }
        }
    }
}
fn price ['o': Order, 's': Ship] --> int32 {
    let !mut 'p': int32 = match 'o' {
        cancelled { giveS 0; }
        paid { giveS match 's' { pickup { giveS 5; } post { giveS 9; } }; }
    };
    return 'p';
}
MAIN {
    handle[Order.paid, Ship.post];
    let !mut 'n': int32 = price[Order.paid, Ship.post];
    std::print.useful.stdout['n', \n];
}
