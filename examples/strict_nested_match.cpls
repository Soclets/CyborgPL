#strict
# In a #strict file a bare nested `match` is a statement, and a nested match that is the value
# says `is` (owner, 2026-09-29).
enum Order { cancelled  paid }
enum Ship { pickup  post }
fn handle ['o': Order, 's': Ship] {
    match 'o' {
        cancelled { }
        paid {
            match 's' {
                pickup { stdkit::print.useful["counter", newln]; }
                post { stdkit::print.useful["mail", newln]; }
            }
        }
    }
}
fn price ['o': Order, 's': Ship] -> int32 {
    let immut 'p': int32 = match 'o' {
        cancelled { is 0; }
        paid { is match 's' { pickup { is 5; } post { is 9; } }; }
    };
    return 'p';
}
MAIN {
    handle[Order.paid, Ship.post];
    let immut 'n': int32 = price[Order.paid, Ship.post];
    stdkit::print.useful['n', newln];
}
