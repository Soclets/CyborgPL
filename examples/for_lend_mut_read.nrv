# Inside `for 'x' in lend.mut 'xs'`, the list may be read once 'x' is used for the last time in
# that trip, and the read sees the new values (owner, 2026-09-30: a, Synapse's liveness rule).
MAIN {
    let mut 'xs': list[int32] = [1, 2, 3];
    let mut 'seen': list[int32] = [];
    for 'x' in lend.mut 'xs' {
        change 'x' = 'x' times 10;
        list.append[lend.mut 'seen', 'xs'[pos 1]];
    }
    cord::print.stored['xs', newln];
    cord::print.stored['seen', newln];
}
