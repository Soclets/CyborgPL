MAIN {
    for 'i' in range[from 1, to 3, by 1] {
        stdkit::print.useful.stdout['i', " "];
    }
    stdkit::print.stored.stdout[newln];
    for 'k' in range[from 0, to 10, by 5] {
        stdkit::print.useful.stdout['k', " "];
    }
    stdkit::print.stored.stdout[newln];
    for 'd' in range[from 3, to 1, by -1] {
        stdkit::print.useful.stdout['d', " "];
    }
    stdkit::print.stored.stdout[newln];
    for perm 'stop' in range[from 0, to 100, by 1] {
        if ('stop' times 'stop') > 50 { break; }
    }
    stdkit::print.useful.stdout["stopped at ", 'stop', newln];
    for perm 'never' in range[from 5, to 2, by 1] {
        stdkit::print.stored.stdout["unreachable", newln];
    }
    stdkit::print.useful.stdout["never ran, holds ", 'never', newln];
    for perm 'done' in range[from 0, to 3, by 1] {
    }
    stdkit::print.useful.stdout["ran out, holds ", 'done', newln];
    for 'b': int8 in range[from 126, to 127, by 1] {
        stdkit::print.useful.stdout['b', " "];
    }
    stdkit::print.stored.stdout[newln];
    let 'words' := ["a", "b", "c"];
    for perm 'w' in lend 'words' {
    }
    stdkit::print.stored.stdout["last word ", 'w', newln];
}
