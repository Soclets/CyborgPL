MAIN {
    for temp 'i' in range[1, 3] {
        std::printu.stdout['i' " "];
    }
    std::print.stdout[\n];
    for temp 'k' in range[0, 10, 5] {
        std::printu.stdout['k' " "];
    }
    std::print.stdout[\n];
    for temp 'd' in range[3, 1, -1] {
        std::printu.stdout['d' " "];
    }
    std::print.stdout[\n];
    for perm 'stop' in range[0, 100] {
        if ('stop' x 'stop') > 50 { break; }
    }
    std::printu.stdout["stopped at " 'stop' \n];
    for perm 'never' in range[5, 2] {
        std::print.stdout["unreachable" \n];
    }
    std::printu.stdout["never ran, holds " 'never' \n];
    for perm 'done' in range[0, 3] {
    }
    std::printu.stdout["ran out, holds " 'done' \n];
    for temp 'b': int8 in range[126, 127] {
        std::printu.stdout['b' " "];
    }
    std::print.stdout[\n];
    let 'words' := ["a", "b", "c"];
    for perm 'w' in lend 'words' {
    }
    std::print.stdout["last word " 'w' \n];
}
