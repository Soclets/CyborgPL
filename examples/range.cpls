MAIN {
    for 'i' in range[1, 3] {
        std::print.useful.stdout['i', " "];
    }
    std::print.stored.stdout[\n];
    for 'k' in range[0, 10, 5] {
        std::print.useful.stdout['k', " "];
    }
    std::print.stored.stdout[\n];
    for 'd' in range[3, 1, -1] {
        std::print.useful.stdout['d', " "];
    }
    std::print.stored.stdout[\n];
    for perm 'stop' in range[0, 100] {
        if ('stop' x 'stop') > 50 { break; }
    }
    std::print.useful.stdout["stopped at ", 'stop', \n];
    for perm 'never' in range[5, 2] {
        std::print.stored.stdout["unreachable", \n];
    }
    std::print.useful.stdout["never ran, holds ", 'never', \n];
    for perm 'done' in range[0, 3] {
    }
    std::print.useful.stdout["ran out, holds ", 'done', \n];
    for 'b': int8 in range[126, 127] {
        std::print.useful.stdout['b', " "];
    }
    std::print.stored.stdout[\n];
    let 'words' := ["a", "b", "c"];
    for perm 'w' in lend 'words' {
    }
    std::print.stored.stdout["last word ", 'w', \n];
}
