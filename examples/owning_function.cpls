# A function that captured with `copy` or `give` carries what it captured, so it is owned
# like a list: copying or handing it on takes a word (owner, 2026-09-24: a). A function
# carrying nothing, or only lends, copies by itself like a number.
MAIN {
    'xs' := [1, 2, 3];
    'count' := fn [] -> uint64 with [copy 'xs'] { return list.length[lend 'xs']; };
    'again' := copy 'count';        # its own copy of the list inside
    'moved' := give 'count';        # 'count' is gone after this
    'inc' := fn ['a': int32] -> int32 { return 'a' + 1; };
    'inc2' := 'inc';                # carries nothing: no word needed
    std::printu.stdout['again'[], " ", 'moved'[], " ", 'inc2'[41], \n];
}
