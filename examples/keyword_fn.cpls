# A keyword may name a function, reached by path, never bare (2026-09-19):
# bare `to` is the conversion and bare `true` the boolean, so these are `limb.to[]`, `limb.true[]`.
fn to [] -> int32 { return 5; }
fn true [] -> int32 { return 1; }
MAIN {
    'x' := limb.to[];
    'y' := limb.true[];
    std::print.useful.stdout['x', " ", 'y', \n];
}
