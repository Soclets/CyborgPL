# whichever, timers, structured tasks, a task that fails (design/concurrency.md, 2026-09-22).
fn fetch [lent 'url': str.utf8] -> str.utf8 or fail[no_network] {
    if 'url' equal_to "down.com" { fail no_network; }
    return "page of " ++ 'url';
}

MAIN {
    let 'inbox' := channel[str.utf8][max 10];
    let 'shutdown' := channel[bool];
    concur with [lend 'inbox'] { channel.send[lend 'inbox', "first"]; channel.send[lend 'inbox', "second"]; }
    concur with [lend 'shutdown'] { channel.send[lend 'shutdown', true]; }
    let 'deadline' := cord::time.after[5 seconds];
    for 'i' from 1 to 4 by 1 {
        whichever {
            'msg' from lend 'inbox'    { cord::print.useful["got ", 'msg', newln]; }
            'why' from lend 'shutdown' { cord::print.useful["shutdown", newln]; }
            'now' from lend 'deadline' { cord::print.useful["timed out after ", 'now', newln]; }
        } otherwise { closed { cord::print.useful["all closed", newln]; } };
    }
    {
        concur { cord::print.useful["task in a block", newln]; }
        cord::print.useful["block body", newln];
    }
    cord::print.useful["after the block", newln];
    concur with [lend 'inbox'] { let 'p' := fetch["down.com"] otherwise fail; channel.send[lend 'inbox', give 'p']; }
        otherwise { no_network { cord::print.useful["offline", newln]; } };
    let 'tick' := cord::time.every[1 second];
    let 't' := channel.take[lend 'tick'] otherwise 0 seconds;
    cord::print.useful["tick ", 't', newln];
}
