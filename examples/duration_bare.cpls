# `duration` bare is std's `stdkit::duration`: std marks everything `bare.optional` (owner, 2026-10-06:
# "optional for all"). Without std, the type and its literals are refused.
fn twice ['d': duration] -> duration {
    return 'd' plus 'd';
}
MAIN {
    let 'w': duration = 2 seconds;
    stdkit::print.useful[twice['w'] equal_to 4 seconds, newln];
}
