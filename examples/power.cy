# `pow`, and how it groups (to the right).
!MAIN:
    std::print.shortest((2 power (3 power 2)), newline);
    std::print.shortest(((2 power 3) power 2), newline);
    let $kilo := 2 power 10;
    std::print.shortest($kilo, newline);
    std::print.shortest((10 minus 3 minus 2), newline);
!end of MAIN
