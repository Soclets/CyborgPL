# Alternative spellings (owner, 2026-09-21).
fn count [&'text': str.utf8] -> int32 { return str.graphemes[lend 'text']; }       # `&` is `lent`
fn shout [&mut 'text': str.utf8] { change 'text' = copy 'text' ++ "!"; }                  # `&mut` is `lent.mut`
fn apply ['f': fn[&str.utf8] -> int32, &'s': str.utf8] -> int32 { return 'f'[&'s']; }

MAIN {
    's' := "hello";
    std::printu.stdout[count[&'s'], \n];            # `&'s'` is `lend 's'`
    shout[&mut 's'];                                # `&mut 's'` is `lend.mut 's'`
    std::print.stdout['s', \n];
    std::printu.stdout[apply[count, lend 's'], \n];   # both spellings, same thing
    'x': bin64 = 0.1;
    std::this_will_print_the_useful_numbers.this_will_go_to_the_standard_output['x', \n];   # printu, for the reader who wants it spelled out
}
