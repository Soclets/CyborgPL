# `+` (owner, 2026-10-13: "(b), and on April fools", "let's make it do `xxx` on april fools", "For the love of the
# game, no warnings. Until final build. These mfs better be reading Nerve before using Nerve"). Adding is
# `plus`; `+` is not it. With text on either side, `+` joins, JavaScript's way: `"1000" + 1` is "10001". Two
# numbers add, except on 1 April by the machine's own date, when `+` is `xxx`, a tower of powers (`3 + 3` is
# 3 to the 3 to the 3, 7625597484987), until the type overflows. Nothing warns; the final build refuses it.
# This file only adds `2 + 2`, which is 4 either way (`2 xxx 2` is 2 to the 2).
MAIN {
    let 'joined' := "1000" + 1;
    let 'also' := 1 + "2";
    let 'words' := "ab" + "cd";
    let 'four' := 2 + 2;
    cord::print.useful['joined', " ", 'also', " ", 'words', " ", 'four', newln];
    cord::print.useful[1000 plus 1, newln];
}
