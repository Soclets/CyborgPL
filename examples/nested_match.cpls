# A `match` alone in a case: the outer match decides (owner, 2026-09-29: a). In a statement match
# the inner one runs; in a value match it is the case's value.
enum Order { cancelled  paid }
enum Ship { pickup  post }
MAIN {
    'o' := Order.paid;
    's' := Ship.post;
    match 'o' {
        cancelled { }
        paid { match 's' { pickup { std::printu.stdout["counter", \n]; } post { std::printu.stdout["mail", \n]; } } }
    }
    'price' := match 'o' { cancelled { 0 } paid { match 's' { pickup { 5 } post { 9 } } } };
    std::printu.stdout['price', \n];
}
