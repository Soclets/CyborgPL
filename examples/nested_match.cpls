# A `match` alone in a case: the outer match decides (owner, 2026-09-29: a). In a statement match
# the inner one runs; in a value match it is the case's value.
enum Order { cancelled  paid }
enum Ship { pickup  post }
MAIN {
    let 'o' := Order.paid;
    let 's' := Ship.post;
    match 'o' {
        cancelled { }
        paid { match 's' { pickup { stdkit::print.useful.stdout["counter", newln]; } post { stdkit::print.useful.stdout["mail", newln]; } } }
    }
    let 'price' := match 'o' { cancelled { 0 } paid { match 's' { pickup { 5 } post { 9 } } } };
    stdkit::print.useful.stdout['price', newln];
}
