# An argument takes its parameter's type as its context, as a declaration's value does (owner,
# 2026-09-29: a): show[0 minus.wrap 1] wraps at 8 bits, and list.append's value takes the element type.
fn show ['b': uint8] { cord::print.useful['b', newln]; }
fn wide ['w': uint32] -> uint32 { return 'w'; }
MAIN {
    show[0 minus.wrap 1];
    let 'v': uint64 = to.uint64[wide[2 shl 3]];
    cord::print.useful['v', " ", wide[not.bit 0], newln];
    let mut 'xs': list[uint8] = [1,];
    list.append[lend.mut 'xs', 0 minus.wrap 2];
    cord::print.useful['xs'[pos 2], newln];
}
