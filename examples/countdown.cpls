# Counting down: the step is its own signed number, not a value the counter takes (2026-09-23).
# A position is a uint64, so walking a list backwards needs exactly this.
MAIN {
    for 'i': uint64 in range[3, 1, -1] { std::printu.stdout['i', " "]; }
    std::print.stdout[\n];
    for 'j': uint64 in range[3, 0, -1] { std::printu.stdout['j', " "]; }   # ends at 0: must not underflow
    std::print.stdout[\n];
    'xs' := [10, 20, 30];
    for 'k': uint64 in range[list.length[lend 'xs'], 1, -1] { std::printu.stdout['xs'[pos 'k'], " "]; }
    std::print.stdout[\n];
}
