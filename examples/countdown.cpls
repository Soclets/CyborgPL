# Counting down: the step is its own signed number, not a value the counter takes (2026-09-23).
# A position is a uint64, so walking a list backwards needs exactly this.
MAIN {
    for 'i': uint64 in range[3, 1, -1] { stdkit::print.useful.stdout['i', " "]; }
    stdkit::print.stored.stdout[newln];
    for 'j': uint64 in range[3, 0, -1] { stdkit::print.useful.stdout['j', " "]; }   # ends at 0: must not underflow
    stdkit::print.stored.stdout[newln];
    let 'xs' := [10, 20, 30];
    for 'k': uint64 in range[list.length[lend 'xs'], 1, -1] { stdkit::print.useful.stdout['xs'['k'], " "]; }
    stdkit::print.stored.stdout[newln];
}
