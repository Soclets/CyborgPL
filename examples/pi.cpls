# The digits of pi, by the Rabinowitz–Wagon spigot: integers only, no bin anywhere.
fn pi_digits ['n': int32] {
    let 'len' := (10 x 'n') / 3 + 1;
    let mut 'a' := list.empty;
    for 'i' in range[1, 'len'] { list.append[lend.mut 'a', 2]; }
    let mut 'nines' := 0;
    let mut 'predigit' := 0;
    for 'j' in range[1, 'n'] {
        let mut 'q' := 0;
        for 'i' in range['len', 1, -1] {
            let 'x' := (10 x 'a'[pos 'i']) + ('q' x 'i');
            let 'den' := (2 x 'i') - 1;
            'a'[pos 'i'] = 'x' mod 'den';
            'q' = 'x' / 'den';
        }
        'a'[pos 1] = 'q' mod 10;
        'q' = 'q' / 10;
        if 'q' == 9 {
            'nines' = 'nines' + 1;
        } else if 'q' == 10 {
            std::printu.stdout['predigit' + 1];
            for 'k' in range[1, 'nines'] { std::printu.stdout[0]; }
            'predigit' = 0;
            'nines' = 0;
        } else {
            if 'j' > 1 { std::printu.stdout['predigit']; }
            if 'j' == 2 { std::printu.stdout["."]; }
            'predigit' = 'q';
            for 'k' in range[1, 'nines'] { std::printu.stdout[9]; }
            'nines' = 0;
        }
    }
    std::printu.stdout['predigit', \n];
}

MAIN { pi_digits[60]; }
