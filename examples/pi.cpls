# The digits of pi, by the Rabinowitz–Wagon spigot: integers only, no bin anywhere.
fn pi_digits ['n': int32] {
    'len' := (10 x 'n') div 3 + 1;
    mut 'a' := list.empty;
    for 'i' in range[1, 'len'] { list.append[lend.mut 'a', 2]; }
    mut 'nines' := 0;
    mut 'predigit' := 0;
    for 'j' in range[1, 'n'] {
        mut 'q' := 0;
        for 'i' in range['len', 1, -1] {
            'x' := (10 x 'a'['i']) + ('q' x 'i');
            'den' := (2 x 'i') - 1;
            change 'a'['i'] = 'x' mod 'den';
            change 'q' = 'x' div 'den';
        }
        change 'a'[1] = 'q' mod 10;
        change 'q' = 'q' div 10;
        if 'q' == 9 {
            change 'nines' = 'nines' + 1;
        } else if 'q' == 10 {
            std::print.useful.stdout['predigit' + 1];
            for 'k' in range[1, 'nines'] { std::print.useful.stdout[0]; }
            change 'predigit' = 0;
            change 'nines' = 0;
        } else {
            if 'j' > 1 { std::print.useful.stdout['predigit']; }
            if 'j' == 2 { std::print.useful.stdout["."]; }
            change 'predigit' = 'q';
            for 'k' in range[1, 'nines'] { std::print.useful.stdout[9]; }
            change 'nines' = 0;
        }
    }
    std::print.useful.stdout['predigit', \n];
}

MAIN { pi_digits[60]; }
