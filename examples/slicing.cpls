# list.slice / array.slice (2026-09-23): 1-based and inclusive, like [i] and range[…].
# A slice owns its elements; Precog elides the copy where nobody can tell.
MAIN {
    let 'xs' := [10, 20, 30, 40, 50];
    let 'mid' := list.slice[lend 'xs', pos 2, pos 4];
    stdkit::print.useful['mid', " ", list.length[lend 'mid'], newln];
    let 'fixed': array[int32] = [1, 2, 3];
    stdkit::print.useful[array.slice[lend 'fixed', pos 1, pos 2], newln];
    let 'none' := list.slice[lend 'xs', pos 3, pos 2];
    stdkit::print.useful['none', " ", 'xs', newln];
}
