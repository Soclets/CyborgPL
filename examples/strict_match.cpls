# In a `#strict` file a case says its value with `is` (owner, 2026-09-29: b), and may do
# other work first.
#strict
enum Status { empty  claimed: str.utf8  locked }
fn label ['s': Status] -> str.utf8 {
    let immut 'text' := match 's' {
        empty         { is "free"; }
        claimed 'who' { let immut 'prefix' := "taken by "; is 'prefix' ++ 'who'; }
        locked        { is "locked"; }
    };
    return give 'text';
}
MAIN {
    stdkit::print.useful[label[Status.claimed["bo"]], newln];
}
