# In a `#strict` file a case says its value with `giveS` (owner, 2026-09-29: b), and may do
# other work first.
#strict
enum Status { empty  claimed: str.utf8  locked }
fn label ['s': Status] -> str.utf8 {
    let immut 'text' := match 's' {
        empty         { giveS "free"; }
        claimed 'who' { let immut 'prefix' := "taken by "; giveS 'prefix' ++ 'who'; }
        locked        { giveS "locked"; }
    };
    return give 'text';
}
MAIN {
    stdkit::print.useful.stdout[label[Status.claimed["bo"]], newln];
}
