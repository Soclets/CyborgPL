fn sum [...'nums'] -> bin64 {
    'total': bin64 = 0;
    for 'n' in lend 'nums' { change 'total' = 'total' + to.bin64['n']; }
    return 'total';
}

fn count_ints [...'nums': int32] -> uint64 {
    return list.length[lend 'nums'];
}

fn show [lent 'label': str.utf8, lent ...'parts'] {
    std::printu.stdout['label', ": "];
    for 'p' in lend 'parts' { std::printu.stdout['p', " "]; }
    std::print.stdout[\n];
}

MAIN {
    std::printu.stdout[sum[1, 2.5, 3], \n];
    std::printu.stdout[sum[], \n];
    std::printu.stdout[count_ints[4, 5, 6], \n];
    'name' := "Ann";
    show["mixed", lend 'name', 7, true, `x`];
    show["none"];
}
