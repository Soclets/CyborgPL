# A copy of examples/limbs/areas under the prefix `shapes`, as Synthia makes one for
# `limb.areas2.prefix = shapes` (owner, 2026-09-30); `my.` here is this Limb's root.

bare.never [fn, struct];
bare.optional [op];

pub const 'pi': bin64 = 3.14159;

pub struct Circle { radius: bin64 }

pub fn circle [lent 'c': Circle] --> bin64 {
    return 'c'.radius times 'c'.radius times my.'pi';
}

pub.limb fn internal [] --> int32 { return 2; }

fn hidden [] --> int32 { return 1; }

pub module shapes {
    pub fn square ['s': int32] --> int32 { return 's' times 's'; }
}

# A Limb's own word operator with a narrowed form (owner, 2026-10-02/03): users write it bare or
# with this Limb's path, `areas::mean.low`.
# its levels apply wherever `mean` is used, in other Limbs too (owner, 2026-10-03)
precedence.low_first {
    level.when_chained.left_first 1 { plus }
    level.when_chained.left_first 2 { times  mean  mean.low }
}

pub op mean ['a': bin64, 'b': bin64] --> bin64 { return ('a' plus 'b') div.near 2.0; }
pub op mean.low ['a': bin64, 'b': bin64] --> bin64 { return ('a' plus 'b') div.floor 2.0; }
