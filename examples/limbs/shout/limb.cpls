# A Limb whose writer made its names case-insensitive, in its own code and as reached from other
# Limbs (owner, 2026-10-06: "`a`, and `c`. Would depend on their respective writers"), kind by kind.
case.insensitive [fn, struct, field, const];
bare.never [struct];

pub const 'Volume' := 11;

pub bare.never fn Shout ['s': str.utf8] --> str.utf8 {
    return 's' ++ "!";
}

pub bare.optional fn Whisper [] --> str.utf8 {
    return "psst, " ++ shout["volume " ++ to.useful.str.utf8[my.'VOLUME']];
}

pub struct Level {
    Loud: bool
}
