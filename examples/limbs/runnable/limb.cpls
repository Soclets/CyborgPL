# A Neuron that is both a library and a program (owner, 2026-09-29: a): its MAIN runs when this Neuron is
# run itself, and is ignored when another Neuron uses it (examples/uses_a_limb).

bare.never [fn];

pub fn seven [] -> int32 { return 7; }

MAIN {
    cord::print.stored["runnable on its own", newln];
}
