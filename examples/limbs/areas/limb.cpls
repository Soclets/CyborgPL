# A small Limb used by examples/uses_a_limb (a dependency: it has no MAIN). Only `pub` items reach
# another Limb; `pub.limb` and private ones stay home. `limb.` here is this Limb's root.
pub const 'pi': bin64 = 3.14159;

pub struct Circle { radius: bin64 }

pub fn circle [lent 'c': Circle] --> bin64 {
    return 'c'.radius times 'c'.radius times limb.'pi';
}

pub.limb fn internal [] --> int32 { return 2; }

fn hidden [] --> int32 { return 1; }

pub module shapes {
    pub fn square ['s': int32] --> int32 { return 's' times 's'; }
}
