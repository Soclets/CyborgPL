# Code for one target (owner, 2026-10-06): `on.target` is chosen when compiling, and a branch it rules
# out is not compiled at all; `on.machine` asks the actual machine once, when running (IEG's).
# The oracle's target is aarch64-macos.

on.target.os windows {
    fn where [] --> str.utf8 { return "windows"; }
} else {
    fn where [] --> str.utf8 { return "not windows"; }
}

MAIN {
    on.target aarch64-macos {
        std::print.useful.stdout["built for aarch64-macos", \n];
    } else on.target.chip x86_64 {
        let 'n': int64 = 5;
        !check inline.ASM { neg rax } with ['n' --> rax, 'n' <-- rax];   # never compiled here: x86 assembly
    } else {
        std::print.useful.stdout["built for something else", \n];
    }
    on.target.chip aarch64 { std::print.useful.stdout["an ARM chip, ", where[], \n]; }
    on.machine.chip aarch64 {
        std::print.useful.stdout["running on ARM", \n];
    } else {
        std::print.useful.stdout["running elsewhere", \n];
    }
}
