# Text → number fails `not_a_number` when it is not a number, and `out_of_range`
# when it is one too big for the type, however many digits (owner, 2026-09-24).
# Text comes from outside, so either is bad input to handle, never a crash.
MAIN {
    let 'a' := to.int32["42"] otherwise 0;
    let 'b' := to.int32["99999999999"] otherwise -1;                               # too big for int32
    let 'c' := to.int64["99999999999999999999999999999999999999999999"] otherwise -1;  # too big for anything
    let 'd' := to.uint8["-1"] otherwise 0;                                         # below what uint8 holds
    let 'e' := to.int32["12x"] otherwise -2;                                      # not a number at all
    std::printu.stdout['a', " ", 'b', " ", 'c', " ", 'd', " ", 'e', \n];
}
