fn sum [lent 'items': list[int32]] -> int32 {
    let 'total' := 0;
    for 'n' in lend 'items' {
        change 'total' = 'total' plus 'n';
    }
    return 'total';
}

MAIN {
    let 'xs': list[int32] = [10, 20, 30];
    stdkit::print.useful.stdout["first ", 'xs'[1], ", last ", 'xs'[3], newln];
    let 'n' := list.length[lend 'xs'];
    stdkit::print.useful.stdout["length ", 'n', newln];
    list.append[lend.mut 'xs', 40];
    list.remove[lend.mut 'xs', 1];
    stdkit::print.useful.stdout['xs', " length ", list.length[lend 'xs'], newln];
    stdkit::print.useful.stdout["sum ", sum[lend 'xs'], newln];
    for 'i' in range[1, list.length[lend 'xs']] {
        stdkit::print.useful.stdout['xs'['i'], " "];
    }
    stdkit::print.stored.stdout[newln];
    let 'days': array[str.utf8] = ["mon", "tue"];
    stdkit::print.stored.stdout['days'[2], " of ", array.length[lend 'days'], newln];
    let 'grid' := [[1, 2], [3, 4]];
    stdkit::print.useful.stdout['grid'[2], newln];
    for perm 'i' in range[1, list.length[lend 'xs']] {
        if 'xs'['i'] equal_to 30 { break; }
    }
    change 'xs'['i'] = 33;
    stdkit::print.useful.stdout['xs', newln];
}
