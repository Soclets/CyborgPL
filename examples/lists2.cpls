fn sum [lent 'items': list[int32]] -> int32 {
    let 'total' := 0;
    for 'n' in lend 'items' {
        change 'total' = 'total' + 'n';
    }
    return 'total';
}

MAIN {
    let 'xs': list[int32] = [10, 20, 30];
    std::print.useful.stdout["first ", 'xs'[1], ", last ", 'xs'[3], \n];
    let 'n' := list.length[lend 'xs'];
    std::print.useful.stdout["length ", 'n', \n];
    list.append[lend.mut 'xs', 40];
    list.remove[lend.mut 'xs', 1];
    std::print.useful.stdout['xs', " length ", list.length[lend 'xs'], \n];
    std::print.useful.stdout["sum ", sum[lend 'xs'], \n];
    for 'i' in range[1, list.length[lend 'xs']] {
        std::print.useful.stdout['xs'['i'], " "];
    }
    std::print.stored.stdout[\n];
    let 'days': array[str.utf8] = ["mon", "tue"];
    std::print.stored.stdout['days'[2], " of ", array.length[lend 'days'], \n];
    let 'grid' := [[1, 2], [3, 4]];
    std::print.useful.stdout['grid'[2], \n];
    for perm 'i' in range[1, list.length[lend 'xs']] {
        if 'xs'['i'] == 30 { break; }
    }
    change 'xs'['i'] = 33;
    std::print.useful.stdout['xs', \n];
}
