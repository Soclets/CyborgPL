MAIN {
    let 'i' := 0;
    while 'i' < 3 {
        stdkit::print.useful["while ", 'i', newln];
        change 'i' = 'i' plus 1;
    }
    let 'n' := 0;
    loop {
        change 'n' = 'n' plus 1;
        if 'n' equal_to 2 {
            continue;
        }
        if 'n' > 4 {
            break;
        }
        stdkit::print.useful["loop ", 'n', newln];
    }
    let 'chars' := [`a`, `é`, `🍎`];
    for seq 'c' in lend 'chars' {
        stdkit::print.stored['c', newln];
    }
    stdkit::exit[3];
}
