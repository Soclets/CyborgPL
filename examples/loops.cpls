MAIN {
    let 'i' := 0;
    while 'i' < 3 {
        std::print.useful.stdout["while ", 'i', \n];
        change 'i' = 'i' + 1;
    }
    let 'n' := 0;
    loop {
        change 'n' = 'n' + 1;
        if 'n' == 2 {
            continue;
        }
        if 'n' > 4 {
            break;
        }
        std::print.useful.stdout["loop ", 'n', \n];
    }
    let 'chars' := [`a`, `é`, `🍎`];
    for seq 'c' in lend 'chars' {
        std::print.stdout['c', \n];
    }
    std::exit[3];
}
