MAIN {
    let 'i' := 0;
    while 'i' < 3 {
        std::printu.stdout["while " 'i' \n];
        'i' = 'i' + 1;
    }
    let 'n' := 0;
    loop {
        'n' = 'n' + 1;
        if 'n' == 2 {
            continue;
        }
        if 'n' > 4 {
            break;
        }
        std::printu.stdout["loop " 'n' \n];
    }
    let 'chars' := [`a`, `é`, `🍎`];
    for seq temp 'c' in lend 'chars' {
        std::print.stdout['c' \n];
    }
    std::exit[3];
}
