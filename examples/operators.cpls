struct Vec { x: bin64  y: bin64 }

# a glyph operator: any run of  ! % & * + - / < > = ? @ ^ | ~
op <+> ['a': Vec, 'b': Vec] -> Vec {
    return Vec[x = 'a'.x + 'b'.x, y = 'a'.y + 'b'.y];
}

# a word operator, like x / xx / mod
op dot ['a': Vec, 'b': Vec] -> bin64 {
    return 'a'.x x 'b'.x + 'a'.y x 'b'.y;
}

# operands are lent unless the op says give; then the caller says give too
op ** [give 'a': Vec, 'b': bin64] -> Vec {
    'a'.x = 'a'.x x 'b';
    'a'.y = 'a'.y x 'b';
    return give 'a';
}

MAIN {
    let 'u' := Vec[x = 1, y = 2];
    let 'v' := Vec[x = 3, y = 4];
    let 'w' := 'u' <+> 'v';                      # 'u' and 'v' both still here
    std::printu.stdout['w'.x, " ", 'w'.y, \n];
    std::printu.stdout['u' dot 'v', \n];
    let 'd' := ('u' <+> 'v') dot 'v';            # custom operators have no precedence: parenthesise
    std::printu.stdout['d', \n];
    let 's' := give 'u' ** 10;                   # 'u' is gone after this
    std::printu.stdout['s'.x, " ", 's'.y, \n];
}
