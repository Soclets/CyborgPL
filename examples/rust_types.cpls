# Rust's number names are aliases for CyborgPL's (owner, 2026-10-02): i8–i128, u8–u128, f16 f32 f64.
# Nothing else: not `bool` (the same word), not `char` (a unit must be said), no decimal (Rust has none).
fn half ['x': f64] -> f64 { return 'x' div 2.0; }

MAIN {
    let 'a': i32 = -7;
    let 'b': u8 = 255;
    let 'c': int32 = 'a';                       # the same type, spelled two ways
    let 'xs': list[i64] = [1, 2, 3];
    let 'r': i16[0, 100] = 42;                  # a range type
    let 'n' := to.u16["500"] otherwise 0;       # a conversion
    std::print.useful.stdout['a', " ", 'b', " ", 'c', " ", 'xs', " ", 'r', " ", 'n', " ", half[3.0], \n];
}
