fn count [lent 'items'] --> int32 {
    let 'n' := 0;
    for 'item' in lend 'items' {
        change 'n' = 'n' + 1;
    }
    return 'n';
}

fn shout [lent.mut 'text': str.utf8] {
    change 'text' = copy 'text' ++ "!";
}

fn greet ['name': str.utf8] --> str.utf8 {
    return "hello " ++ 'name';
}

MAIN {
    let 's' := "line 1" ++ \n ++ "line 2";
    let 't' := give 's';
    let 'u' := copy 't';
    shout[lend.mut 'u'];
    std::print.stored.stdout['t', \n];
    std::print.stored.stdout['u', \n];
    let 'g' := greet[copy 'u'];
    std::print.stored.stdout['g', \n];
    std::print.stored.stdout['u', \n];
    let 'words' := ["a", "b", "c"];
    let 'n' := count[lend 'words'];
    std::print.useful.stdout['n', " words", \n];
    let 'm' := count[["x", "y"]];
    std::print.useful.stdout['m', " fresh", \n];
    let 'r' := lend 'words';
    std::print.useful.stdout['r', \n];
}
