MAIN {
    for 'i' from 1 to 3 by 1 {
        cord::print.useful['i', " "];
    }
    cord::print.stored[newln];
    for 'k' from 0 to 10 by 5 {
        cord::print.useful['k', " "];
    }
    cord::print.stored[newln];
    for 'd' from 3 to 1 by -1 {
        cord::print.useful['d', " "];
    }
    cord::print.stored[newln];
    for perm 'stop' from 0 to 100 by 1 {
        if ('stop' times 'stop') > 50 { break; }
    }
    cord::print.useful["stopped at ", 'stop', newln];
    for perm 'never' from 5 to 2 by 1 {
        cord::print.stored["unreachable", newln];
    }
    cord::print.useful["never ran, holds ", 'never', newln];
    for perm 'done' from 0 to 3 by 1 {
    }
    cord::print.useful["ran out, holds ", 'done', newln];
    for 'b': int8 from 126 to 127 by 1 {
        cord::print.useful['b', " "];
    }
    cord::print.stored[newln];
    let 'words' := ["a", "b", "c"];
    for perm 'w' in lend 'words' {
    }
    cord::print.stored["last word ", 'w', newln];
}
