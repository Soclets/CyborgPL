fn count <T: any> [lent 'items': list[<T>]] -> int32 {
    let 'n' := 0;
    for 'item' in lend 'items' {
        change 'n' = 'n' plus 1;
    }
    return 'n';
}

MAIN {
    let 'grid' := [[1, 2], [3, 4]];
    cord::print.useful['grid', newln];
    for 'row' in lend 'grid' {
        cord::print.useful[count[lend 'row'], newln];
    }
    cord::print.useful[count[["a", "b", "c"]], newln];
    let 'one' := [7,];
    cord::print.useful['one', " ", count[lend 'one'], newln];
}
