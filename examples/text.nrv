MAIN {
    let 's' := "héllo 👨‍👩‍👧 wörld";

    # a text has no single length — say which unit (decided 2026-09-20)
    cord::print.useful[str.bytes[lend 's'], " bytes, ", str.points[lend 's'], " points, ", str.graphemes[lend 's'], " graphemes", newln];

    # walking a text says the unit too
    let 'vowels' := 0;
    for 'g' in str.each.grapheme[lend 's'] {
        if 'g' equal_to `o` or 'g' equal_to `e` { change 'vowels' = 'vowels' plus 1; }
    }
    cord::print.useful['vowels', " vowels", newln];

    # the toolbox is std's
    let 'words' := cord::str.split[lend 's', at " "];
    cord::print.useful[list.length[lend 'words'], " words; first is ", 'words'[pos 1], newln];
    cord::print.useful[cord::str.upper[lend 's'], newln];
    cord::print.useful[cord::str.contains[lend 's', part "wör"], " ", cord::str.starts_with[lend 's', part "hé"], newln];
    let 'third' := cord::str.at.grapheme[lend 's', pos 3] otherwise `?`;
    let 'family' := cord::str.at.grapheme[lend 's', pos 7] otherwise `?`;
    cord::print.useful['third', " ", 'family', newln];
    let 'where' := cord::str.find.grapheme[lend 's', part "wör"] otherwise 0;
    cord::print.useful["wör starts at grapheme ", 'where', newln];
    let 'head' := cord::str.slice.grapheme[lend 's', from pos 1, to pos 5] otherwise str.empty;
    cord::print.useful['head', newln];
    cord::print.useful[cord::str.join[lend 'words', between "_"], newln];
}
