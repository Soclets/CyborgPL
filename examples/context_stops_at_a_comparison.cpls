# The type a value is stored into stops at a comparison, as it stops at a call: a `bool`
# holds the comparison's answer, and its operands take their width from each other (2026-09-23).
MAIN {
    'w': uint32 = 3;
    'b': bool = (5 -~ 'w') > 1;          # a uint32 subtraction, 'w' says so, not a bool one
    'c': bool = 1 < (0 -~ 'w');          # wraps to 4294967293
    'n': uint64 = 5;
    'd': bool = 'n' > (0 -~ 1);          # but the other side sizes it: 0 -~ 1 wraps in uint64
    std::print.useful.stdout['b', " ", 'c', " ", 0 -~ 'w', " ", 'd', \n];
}
