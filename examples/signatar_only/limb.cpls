# No std listed: no operators and no printing (owner, 2026-10-06). Functions, `let`, `if`,
# structs, `match`, and.then / or.else (Signatar's, since they skip their right side) still work.

struct Point {
    x: int32
    y: int32
}

enum Light {
    lit
    dark
}

fn ready [] --> bool {
    return true;
}

fn origin [] --> Point {
    return Point[x = 0, y = 0];
}

MAIN {
    let 'p' := origin[];
    let 'l' := Light.lit;
    if ready[] and.then false {
        let 'unused': int32 = 1;
    }
    match 'l' {
        lit { }
        dark { }
    }
}

# a fixed array and a text literal are Signatar's too (owner, 2026-10-06)
fn greeting [] --> str.utf8 {
    return "hi";
}

fn three [] --> array[int32] {
    return [1, 2, 3,];
}

# std's `exit` is out of reach without std, so this Limb's own `exit` is the only one (2026-10-06)
fn exit [] { }

fn stop [] {
    exit[];
}
