# Command-line arguments, as C hands them over (owner, 2026-09-29: "low-level shit, decided"): MAIN may
# take 'argc' and 'argv', the program's name first, each word NUL-ended, a null pointer after the last.
# Reading them is C's world, so it is nocheck; a friendly list will be written in CyborgPL on top.
# examples/args.args holds the words the test passes: apples, 3, hello world.
MAIN ['argc': int32, 'argv': ptr[ptr[uint8]]] {
    std::print.stdout["argc = ", 'argc', \n];
    mut 'i': int32 = 1;
    while 'i' < 'argc' {
        nocheck 'word' := ptr.read[ptr.at['argv', 'i']];
        mut 'k': int32 = 0;
        mut 'bytes': list[uint8] = [];
        loop {
            nocheck 'b' := ptr.read[ptr.at['word', 'k']];
            if 'b' == 0 { break; }
            list.append[lend.mut 'bytes', 'b'];
            change 'k' = 'k' + 1;
        }
        'text' := to.str.utf8['bytes'] otherwise "(not UTF-8)";      # bytes into text (owner, 2026-09-30)
        std::print.stdout["argument ", 'i', ": ", 'text', \n];
        change 'i' = 'i' + 1;
    }
    nocheck 'end' := ptr.read[ptr.at['argv', 'argc']];
    std::print.stdout["argv[argc] is null: ", ptr.is_null['end'], \n];
}
