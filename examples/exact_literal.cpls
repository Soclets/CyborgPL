# `*0.1` means "exactly this" (owner, 2026-10-02): a decimal literal marked `*` is a deci; a plain one
# is a bin, meaning bin64's answer. Under `:=` the oracle makes it a deci64; Precog picks the width.
MAIN {
    let 'price' := *19.99;
    let 'tenth' := *0.1;
    let 'total' := 'tenth' + *0.2;              # exactly 0.3
    let 'half': deci32 = *0.5;                  # a typed deci takes it at its width
    let 'speed' := 0.1;                         # a bin
    std::print.stdout['price', " ", 'total', " ", 'half', " ", 'speed', \n];
}
