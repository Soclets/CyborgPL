# What the base was slimmed into (owner, 2026-10-07), each from the core this Limb lists: testing
# (TAS), `brain16` (AI), `int128` and the other widths (WSMW), `deci` (Money), Unicode text
# (UniTect), the case marks (CAPS); range types are ASP's.
case.insensitive [fn];

fn Halve ['n': int128] -> int128 {
    return 'n' div.floor 2;
}

test fn halves [] {
    must halve[10] equal_to 5;
}

MAIN {
    let 'b': brain16 = 0.5;
    let 'w': not_std.uint4 = 9;
    let 'price': deci64 = 19.99;
    let 'g': char.grapheme = `ก็`;
    let 'age': int32[0, 150] = 42;
    print.useful[HALVE[1000000000000000000000], " ", 'b', " ", 'w', " ", 'price', " ", 'g', " ", 'age', newln];
}
