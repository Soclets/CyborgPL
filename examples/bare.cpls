# `pub bare`: other Limbs may write `pow[…]` without `mathstuff::` (owner, 2026-09-23).
# `pub` says who can see it, `bare` says how they write it. Inside its own Limb a name
# is bare already, so in one Limb this runs as if the word were not there.
pub bare fn pow ['base': int64, 'exp': uint8] -> int64 {
    let mut 'r': int64 = 1;
    for 'i' in range[1, 'exp'] {
        'r' = 'r' x 'base';
    }
    return 'r';
}
MAIN {
    std::printu.stdout[pow[2, 10], \n];
}
