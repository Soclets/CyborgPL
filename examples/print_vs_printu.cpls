MAIN {
    let 'x': bin64 = 0.1;
    std::print.stdout['x', \n];
    std::printu.stdout['x', \n];
    let 'y': bin16 = 1000;
    std::printu.stdout['y', \n];
    let 'big' := 1_000_000 x 1_000_000;
    std::print.stdout['big', \n];
    let 's' := "x is " ++ 'x';
    std::print.stdout['s', \n];
    std::printu.stdout['s', \n];
    std::printu.stdout["x is ", 'x', \n];
}
