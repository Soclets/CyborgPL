# In a list literal, a bare number takes its family from the other items (owner, 2026-09-30: a):
# the 1 here is a bin, like the 2.5 beside it. With `:=`, Precog still picks list or array and the width.
MAIN {
    'xs' := [1, 2.5];
    'ys': list[bin64] = [2.5, 1];
    std::print.useful.stdout['xs', \n];
    std::print.useful.stdout['ys', \n];
    # and it stays a bin when used: 1 + 2.5 x 2.0
    std::print.useful.stdout['xs'[1] + ('xs'[2] x 2.0), \n];
    # beside a deci, a bare number is a deci
    'q': deci64 = 0.5;
    'ds' := [1, 'q'];
    std::print.useful.stdout['ds'[1] + 'ds'[2], \n];
}
