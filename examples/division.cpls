MAIN {
    # floor division and the mathematician's mod.floor (decided 2026-09-20)
    std::print.useful.stdout[7 div.floor 2, " ", 7 mod.floor 2, \n];
    std::print.useful.stdout[-7 div.floor 2, " ", -7 mod.floor 2, \n];        # -4 and 1: the clock never goes negative
    std::print.useful.stdout[7 div.floor -2, " ", 7 mod.floor -2, \n];        # -4 and -1: the result has the divisor's sign
    let 'hour' := -1;
    std::print.useful.stdout[('hour' mod.floor 12) plus 1, \n];         # an hour before 1 o'clock is 12
    # hardware truncation, by name, when a C library's answer must match bit for bit
    std::print.useful.stdout[(-7 div.trunc 2), " ", (-7 mod.trunc 2), \n];
}
