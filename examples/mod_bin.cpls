# `mod` on a bin takes the divisor's sign, as on integers and decis (owner, 2026-10-02: a), so an
# angle stays 0 to 360; C's `fmod` (the dividend's sign) is `std::mod.trunc`, by name.
MAIN {
    let 'angle': bin64 = -370.0;
    let 'turn': bin64 = 360.0;
    let 'a': bin64 = 7.5;
    let 'b': bin64 = -2.0;
    let 'h': brain16 = -5.0;
    let 'k': brain16 = 3.0;
    std::print.useful.stdout['angle' mod 'turn', " ", 'a' mod 'b', " ", 'h' mod 'k', \n];
    std::print.useful.stdout[std::mod.trunc['angle', 'turn'], " ", std::mod.trunc['a', 'b'], \n];
}
