# Text into ASCII fails `not_ascii` unless every character is ASCII (owner, 2026-09-30: "`otherwise`
# exists"). Into utf16 or utf32 it never fails, and from ASCII text there is nothing to fail.
MAIN {
    'plain': str.utf8 = "hello";
    'accented': str.utf8 = "héllo";
    'a' := to.str.ascii['plain'] otherwise "?";
    'b' := to.str.ascii['accented'] otherwise "not ascii";
    std::print.stdout['a', \n, 'b', \n];
    's': str.ascii = "abc";
    'c' := to.str.ascii['s'];
    'w' := to.str.utf16['accented'];
    std::print.stdout['c', " ", 'w', \n];
}
