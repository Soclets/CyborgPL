# Plain math (+ - x xx) is exact, and checked where the value lands: a typed declaration,
# a `change`, an argument, a return (owner, 2026-09-23). In between, the one limit is
# the machine's 64 bits. Wrapping (+~ -~ x~ xx~) wraps at the size of its values.
# tests/reject/overflow_lands.cpls and overflow_past_64_bits.cpls are the two that fail.
MAIN {
    let 'small': int16 = 5;
    let 'big': int64 = (20000 + 20000) + 'small';    # 40005: the true answer, and it fits int64
    let 's': int16 = 30000;
    let 'twice': int64 = 's' + 's';                   # 60000, though no int16 holds it
    let 'tiny': int8 = (100 + 100) - 150;             # 50: the 200 in between is fine
    let 'v': int8 = 112;
    std::print.useful.stdout['big', " ", 'twice', " ", 'tiny', " ", 'v' > ('v' + 'v'), \n];   # 224 compared as 224
    let 'u': uint8 = 5;
    let 'below' := 'u' - 10;                          # -5: `:=` takes a type that holds it
    let 'x': uint32 = 4000000000;
    let 'h': uint64 = 'x' +~ 'x';                     # wraps at uint32, 'x''s size: 3705032704
    let 'a': int8 = 100;
    let 'b': int16 = 1000;
    let 'w' := to.int16['a' + 'b'] +~ 1;            # a mix of sizes wraps where you say: 1101
    std::print.useful.stdout['below', " ", 'h', " ", 'w', \n];
}
