fn twice [immut 'n': int32] -> int32 {
    return 'n' x 2;
}

MAIN {
    'plain' := 1;
    change 'plain' = 'plain' + 1;
    mut 'counter' := 0;
    change 'counter' = 'counter' + 1;
    immut 'limit': int32 = 10;
    std::print.useful.stdout['plain', " ", 'counter', " ", 'limit', " ", twice['limit'], \n];
}
