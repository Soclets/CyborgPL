# Collections (owner, 2026-10-13): a function and its dot narrowings written in one block. The main
# function carries the collection's name (no `fn`), a member with its own body is reached as
# `greet.loud`, and a preset, a member that only fills some of the main function's arguments, is one
# line: `greet.hi['who']` is `greet[lend 'who', "hi", 1]`. Private here, so no `pub` and no `bare.` mark;
# a `pub collection` makes every member public under its one `bare.` mark.
collection greet {
    greet [lent 'who': str.utf8, 'word': str.utf8, 'times': int32[min 1, max 5]] -> str.utf8 or fail[too_long] {
        if str.bytes[lend 'who'] > 20 { fail too_long; }
        let 'out' := "";
        for 'i' from 1 to 'times' by 1 {
            change 'out' = 'out' ++ 'word' ++ ", ";
        }
        return 'out' ++ 'who';
    }

    hi ['word' = "hi", 'times' = 1];
    cheer ['word' = "hooray", 'times' = 3];
    loud [lent 'who': str.utf8] -> str.utf8 { return cord::str.upper[lend 'who']; }
}

# A template (owner, 2026-10-13) makes members whose names follow a pattern. It loops with the usual
# `for` forms over values known before building, its first line `named` works out each member's name
# like text, and `synapse generate` (here `oracle --generate`) writes what it makes into this file,
# under the `#generated_N_lines_below` marker. The build only reads that part, and refuses it when it
# no longer matches the template; it is never edited by hand.
const 'big' := 100;

collection scale {
    scale ['x': int32, 'by': int32] -> int32 { return 'x' times 'by'; }
    for 'n' in [2, 10, 'big'] {
        named "times_" ++ to.stored.str.utf8['n'];
        ['x': int32] -> int32 { return 'x' times 'n'; }
    }
    #generated_3_lines_below
    times_2 ['x': int32] -> int32 { return 'x' times 2; }
    times_10 ['x': int32] -> int32 { return 'x' times 10; }
    times_100 ['x': int32] -> int32 { return 'x' times 'big'; }
    for 'n' from 1 to 3 by 1 {
        named "up_" ++ to.stored.str.utf8['n'];
        ['x': int32] -> int32 { return 'x' plus 'n'; }
    }
    #generated_3_lines_below
    up_1 ['x': int32] -> int32 { return 'x' plus 1; }
    up_2 ['x': int32] -> int32 { return 'x' plus 2; }
    up_3 ['x': int32] -> int32 { return 'x' plus 3; }
}

# A template may loop over types; a type's name is text in `named`.
collection zero {
    for 'T' in [int16, int64] {
        named "of_" ++ 'T';
        [] -> 'T' { return 0; }
    }
    #generated_2_lines_below
    of_int16 [] -> int16 { return 0; }
    of_int64 [] -> int64 { return 0; }
}

MAIN {
    let 'name' := "Ann";
    let 'a' := greet[lend 'name', "hello", 2] otherwise "?";
    let 'b' := greet.hi[lend 'name'] otherwise "?";
    let 'c' := greet.cheer[lend 'name'] otherwise "?";
    cord::print.useful['a', newln, 'b', newln, 'c', newln, greet.loud[lend 'name'], newln];
    let 'long' := "a name much longer than twenty bytes";
    let 'd' := greet.hi[lend 'long'] otherwise "too long";
    cord::print.useful['d', newln];
    cord::print.useful[scale[7, 3], " ", scale.times_2[7], " ", scale.times_10[7], " ", scale.times_100[7], " ", scale.up_3[7], " ", zero.of_int64[], newln];
}
