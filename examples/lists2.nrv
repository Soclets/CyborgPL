fn sum [lent 'items': list[int32]] -> int32 {
    let 'total' := 0;
    for 'n' in lend 'items' {
        change 'total' = 'total' plus 'n';
    }
    return 'total';
}

MAIN {
    let 'xs': list[int32] = [10, 20, 30];
    cord::print.useful["first ", 'xs'[pos 1], ", last ", 'xs'[pos 3], newln];
    let 'n' := list.length[lend 'xs'];
    cord::print.useful["length ", 'n', newln];
    list.append[lend.mut 'xs', 40];
    list.remove[lend.mut 'xs', pos 1];
    cord::print.useful['xs', " length ", list.length[lend 'xs'], newln];
    cord::print.useful["sum ", sum[lend 'xs'], newln];
    for 'i' in range[from 1, to list.length[lend 'xs'], by 1] {
        cord::print.useful['xs'[pos 'i'], " "];
    }
    cord::print.stored[newln];
    let 'days': array[str.utf8] = ["mon", "tue"];
    cord::print.stored['days'[pos 2], " of ", array.length[lend 'days'], newln];
    let 'grid' := [[1, 2], [3, 4]];
    cord::print.useful['grid'[pos 2], newln];
    for perm 'i' in range[from 1, to list.length[lend 'xs'], by 1] {
        if 'xs'[pos 'i'] equal_to 30 { break; }
    }
    change 'xs'[pos 'i'] = 33;
    cord::print.useful['xs', newln];
}
