# A Limb gives its operators a precedence (owner, 2026-10-03): `precedence.low_first` counts level 1
# as the loosest (good practice), each level says how a chain reads, and a language operator in a
# level pins it where that operator is. std's `pow` binds above a negative, right pair first.
struct Vec { x: bin64  y: bin64 }

precedence.low_first {
    level.when_chained.refused 1 { equal_to ~= }
    level.when_chained.left_first 2 { plus }
    level.when_chained.left_first 3 { times  dot }
    level.when_chained.left_first 4 { scale }
}

op dot ['a': Vec, 'b': Vec] -> bin64 {
    return ('a'.x times 'b'.x) plus ('a'.y times 'b'.y);
}

op scale ['a': Vec, 'k': bin64] -> Vec {
    return Vec[x = 'a'.x times 'k', y = 'a'.y times 'k'];
}

op ~= ['a': bin64, 'b': bin64] -> bool {
    return ('a' minus 'b') < 0.000001 and ('b' minus 'a') < 0.000001;
}

MAIN {
    let 'u' := Vec[x = 1.0, y = 2.0];
    let 'v' := Vec[x = 3.0, y = 4.0];
    let 'd' := 'u' dot 'v' plus 1.0;          # ('u' dot 'v') plus 1.0
    let 'w' := 'u' scale 2.0 dot 'v';         # ('u' scale 2.0) dot 'v'
    let 'ok' := 'd' ~= 12.0;
    stdkit::print.useful['d', " ", 'w', " ", 'ok', newln];
    stdkit::print.useful[2 pow 3 plus 1, " ", 2 pow 3 pow 2, " ", -2 pow 2, " ", 2 times 3 pow 2, newln];
}
