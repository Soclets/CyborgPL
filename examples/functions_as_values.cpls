# Functions as values (design/functions-as-values.md, 2026-09-21).
struct Locker { number: int32  owner: str.utf8 }

fn by_number [lent 'a': Locker, lent 'b': Locker] -> bool { return 'a'.number < 'b'.number; }
fn by_owner  [lent 'a': Locker, lent 'b': Locker] -> bool { return str.bytes[lend 'a'.owner] < str.bytes[lend 'b'.owner]; }

# a function that takes a function: the type is the signature without the names
fn first_by [lent 'xs': list[Locker], 'less': fn[lent Locker, lent Locker] -> bool] -> str.utf8 {
    'best' := 1;
    for 'i' in range[2, list.length[lend 'xs']] {
        if 'less'[lend 'xs'[pos 'i'], lend 'xs'[pos 'best']] { change 'best' = 'i'; }
    }
    'winner' := lend 'xs'[pos 'best'];
    return copy 'winner'.owner;
}

fn keep [lent 'xs': list[int32], 'test': fn[int32] -> bool] -> list[int32] {
    'out': list[int32] = [];
    for 'x' in lend 'xs' { if 'test'['x'] { list.append[lend.mut 'out', 'x']; } }
    return give 'out';
}

MAIN {
    'lockers' := [Locker[number = 7, owner = "Cy"], Locker[number = 2, owner = "Ann"], Locker[number = 5, owner = "Bo"]];
    std::print.stdout[first_by[lend 'lockers', by_number], \n];          # a named function, as a value: its bare name
    std::print.stdout[first_by[lend 'lockers', by_owner], \n];

    'f' := by_number;                                                 # held in a variable
    std::printu.stdout['f'[lend 'lockers'[pos 1], lend 'lockers'[pos 2]], \n];   # called: 'f'[…]

    'limit' := 60;
    'scores' := [72, 40, 95, 55];
    'passing' := keep[lend 'scores', fn ['s': int32] -> bool with [lend 'limit'] { return 's' >== 'limit'; }];
    std::printu.stdout['passing', \n];

    'evens' := keep[lend 'scores', fn ['s': int32] -> bool { return ('s' mod 2) == 0; }];   # captures nothing
    std::printu.stdout['evens', \n];
}
