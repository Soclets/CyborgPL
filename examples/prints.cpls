# The two prints. Both are std's; the base language has no print.
MAIN {
    let 'name' := "Ann";
    let 'count' := 6;
    let 'x': bin64 = 0.1;

    # print: any values, each in its stored form, nothing between
    std::print.stdout["x is ", 'x', \n];

    # printu: the same, each in its useful form
    std::printu.stdout["x is ", 'x', \n];

    # a joined text is already text: print and printu agree on it
    let 'line' := 'name' ++ " scored " ++ to.str.utf8['count'];
    std::print.stdout['line', \n];
    std::printu.stdout['line', \n];

    # stderr
    std::printu.stderr["warning: ", 'count', " is low", \n];
}
