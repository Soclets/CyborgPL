# The two prints. Both are std's; the base language has no print.
MAIN {
    'name' := "Ann";
    'count' := 6;
    'x': bin64 = 0.1;

    # print: any values, each in its stored form, nothing between
    std::print.stdout["x is ", 'x', \n];

    # print.useful: the same, each in its useful form
    std::print.useful.stdout["x is ", 'x', \n];

    # a joined text is already text: print and print.useful agree on it
    'line' := 'name' ++ " scored " ++ to.str.utf8['count'];
    std::print.stdout['line', \n];
    std::print.useful.stdout['line', \n];

    # stderr
    std::print.useful.stderr["warning: ", 'count', " is low", \n];
}
