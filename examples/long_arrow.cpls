# `->` is another spelling of `->`, wherever `->` goes, and `<-` of `<-` (owner, 2026-10-03).
fn double ['n': int32] -> int32 { return 'n' times 2; }
fn apply ['v': int32, 'f': fn[int32] -> int32] -> int32 { return 'f'['v']; }
MAIN {
    stdkit::print.useful[double[4], " ", apply[5, double], newln];
    stdkit::print.weird.useful <- "weird: " <- double[2] <- newln;
}
