fn sum [...'nums'] -> bin64 {
    let 'total': bin64 = 0;
    for 'n' in lend 'nums' { change 'total' = 'total' plus to.bin64['n']; }
    return 'total';
}

fn count_ints [...'nums': int32] -> uint64 {
    return list.length[lend 'nums'];
}

fn show [lent 'label': str.utf8, lent ...'parts'] {
    cord::print.useful['label', ": "];
    for 'p' in lend 'parts' { cord::print.useful['p', " "]; }
    cord::print.stored[newln];
}

MAIN {
    cord::print.useful[sum[1, 2.5, 3], newln];
    cord::print.useful[sum[], newln];
    cord::print.useful[count_ints[4, 5, 6], newln];
    let 'name' := "Ann";
    show["mixed", lend 'name', 7, true, `x`];
    show["none"];
}
