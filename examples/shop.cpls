interface Priced <T> {
    fn price [lent 'x': <T>] --> int32;
}

enum Stock {
    out
    few: int32
    plenty
}

struct Item {
    name: str.utf8
    cents: int32[0, 100_000]
    stock: Stock
}

fn price [lent 'i': Item] --> int32 { return 'i'.cents; }

fn cheapest <T>: Priced [lent 'xs': list[<T>]] --> <T> or fail[empty] {
    if list.length[lend 'xs'] == 0 { fail empty; }
    let 'best' := 1;
    for 'k' in range[2, list.length[lend 'xs']] {
        if price[lend 'xs'['k']] < price[lend 'xs'['best']] { change 'best' = 'k'; }
    }
    return copy 'xs'['best'];
}

fn describe [lent 'i': Item] --> str.utf8 {
    let 'dollars' := to.stored.str.utf8['i'.cents div.floor 100] ++ "." ++ to.stored.str.utf8['i'.cents mod.floor 100];
    match 'i'.stock {
        out      { return 'i'.name ++ " — sold out"; }
        few 'n'  { return 'i'.name ++ " — only " ++ to.stored.str.utf8['n'] ++ " left at $" ++ 'dollars'; }
        plenty   { return 'i'.name ++ " — $" ++ 'dollars'; }
    }
}

fn keep [lent 'xs': list[Item], 'test': fn[lent Item] --> bool] --> list[Item] {
    let 'out': list[Item] = [];
    for 'x' in lend 'xs' { if 'test'[lend 'x'] { list.append[lend.mut 'out', copy 'x']; } }
    return give 'out';
}

MAIN {
    let 'shelf' := [
        Item[name = "rope",   cents = 1_250, stock = Stock.plenty],
        Item[name = "helmet", cents = 8_999, stock = Stock.few[2]],
        Item[name = "torch",  cents = 450,   stock = Stock.out]
    ];
    for 'i' in lend 'shelf' { std::print.stored.stdout[describe[lend 'i'], \n]; }

    let 'limit' := 5_000;
    let 'affordable' := keep[lend 'shelf', fn [lent 'i': Item] --> bool with [lend 'limit'] { return 'i'.cents </== 'limit'; }];
    std::print.useful.stdout[list.length[lend 'affordable'], " affordable", \n];

    let 'pick' := cheapest[lend 'affordable'] otherwise std::exit[0];
    std::print.stored.stdout["cheapest: ", 'pick'.name, \n];

    let 'text' := std::input.line[] otherwise "";
    let 'budget' := to.int32[0, 100_000]['text'] otherwise {
        not_a_number { std::print.stored.stdout["no budget given", \n]; std::exit[0]; }
        out_of_range { std::print.stored.stdout["budget must be 0..100000 cents", \n]; std::exit[1]; }
    };
    std::print.useful.stdout["budget ok: ", 'budget', \n];
}
