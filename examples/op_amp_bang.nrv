# `&` and `!` are free to declare as custom operators, as `*`, `^`, `%` and `|` are (`operators.md`).
# What MTM's removal (owner, 2026-10-07) took away is their old meanings: `&'x'` for `lend 'x'` and
# `! 'x'` for `not 'x'`, still refused, naming the word to write. Between two values, declared, they are
# operators like any other.
struct Range {
    lo: int32
    hi: int32
}

# the overlap of two ranges
op & ['a': Range, 'b': Range] -> Range {
    let 'lo' := 'a'.lo;
    if 'b'.lo > 'lo' { change 'lo' = 'b'.lo; }
    let 'hi' := 'a'.hi;
    if 'b'.hi < 'hi' { change 'hi' = 'b'.hi; }
    return Range[lo = 'lo', hi = 'hi'];
}

# a over b: how many times b fits in a
op ! ['a': int32, 'b': int32] -> int32 { return 'a' div.floor 'b'; }

MAIN {
    let 'x' := Range[lo = 1, hi = 10];
    let 'y' := Range[lo = 5, hi = 20];
    let 'both' := 'x' & 'y';
    cord::print.useful['both'.lo, " to ", 'both'.hi, newln];
    cord::print.useful[(17 ! 5), newln];
    cord::print.useful[not true, newln];
}
