pub const 'capacity' := 12;

struct Locker {
    immut number: int32
    owner: str.utf8
    items: list[str.utf8]
}

fn free_slots [lent 'l': Locker] -> int32 {
    return 'capacity' - list.length[lend 'l'.items];
}

fn stash [lent.mut 'l': Locker, 'item': str.utf8] -> bool {
    if free_slots[lend 'l'] == 0 { return false; }
    list.append[lend.mut 'l'.items, give 'item'];
    return true;
}

fn label [lent 'l': Locker] -> str.utf8 {
    return "#" ++ to.str.utf8['l'.number] ++ " (" ++ 'l'.owner ++ ")";
}

MAIN {
    'mine' := Locker[number = 7, owner = "Tankun", items = list.empty];
    'names' := ["helmet", "gloves", "rope"];
    mut 'stored': int32 = 0;

    for 'n' in lend 'names' {
        if stash[lend.mut 'mine', copy 'n'] { change 'stored' = 'stored' + 1; }
    }
    std::print.useful.stdout[label[lend 'mine'], ": ", 'stored', " stored, ", free_slots[lend 'mine'], " free", \n];

    for 'i' in range[1, list.length[lend 'mine'.items]] {
        check std::print.useful.stdout['i', ". ", 'mine'.items['i'], \n];
    }

    'x': bin64 = 0.1;
    std::print.stdout['x', \n];
    std::print.useful.stdout['x', \n];

    'tag' := give 'mine'.owner;
    std::print.stdout['tag', \n];
}
