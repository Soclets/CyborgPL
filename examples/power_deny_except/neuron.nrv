# Powers (owner, 2026-10-07): this Neuron lists `c_calls`, and the program denies every C call except
# `write`, so its one call to `write` builds. No cord; CNC for C, and `vouch` for the `no_check`.

extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

MAIN {
    let 'text' := "allowed
";
    no_check let 'n' := write[1, lend 'text', 8];
}
