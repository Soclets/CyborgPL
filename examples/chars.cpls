# char conversions (decided 2026-09-21): code by name, text ↔ char and unit ↔ unit as failing conversions.
MAIN {
    'a' := `A`;
    std::print.useful.stdout[char.code['a'], \n];                        # 65 — the number under it
    'seven' := to.int32[to.str.utf8[`7`]] otherwise -1;        # 7 — a digit's value is a text parse
    std::print.useful.stdout['seven', \n];
    'b' := char.point.from_code[66] otherwise `?`;
    'bad' := char.point.from_code[1_114_112] otherwise `?`;    # past the last code point: not_a_char
    std::print.useful.stdout['b', 'bad', \n];                            # B?
    'one' := to.char.point["Z"] otherwise `?`;                 # text of exactly one point
    'two' := to.char.point["ZZ"] otherwise `?`;                # not_one_char
    std::print.useful.stdout['one', 'two', \n];                          # Z?
    'g': char.grapheme = `é`;
    'p' := to.char.point['g'] otherwise `?`;                   # this é is one point: fine
    'y' := to.char.byte['p'] otherwise `?`;                    # é is two bytes: not_one_byte
    std::print.useful.stdout['p', 'y', \n];                              # é?
    'up' := to.char.grapheme[`x`];                             # up never loses anything: no otherwise
    std::print.useful.stdout[to.str.utf8['up'] ++ "!", \n];               # x!
}
