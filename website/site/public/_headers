/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A page's data (React Router's .data files) changes only when the site is deployed. Kept
# for 5 minutes, then refreshed in the background for a day, so switching tabs never waits
# on the network after the first visit (owner: switching felt slow).
/*.data
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Content-Type: text/x-script; charset=utf-8

# Every example whole, which the Examples grid loads in the background: like the .data files.
/examples-full.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# The icons' names carry a hash of the drawing, so they never change under the same name.
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# The fixed-name fallbacks browsers ask for on their own: checked again after 5 minutes.
/favicon.ico
  Cache-Control: public, max-age=300
/favicon.svg
  Cache-Control: public, max-age=300

# Security, on every page (owner, 2026-10-10: "how do I make nerve-lang.com secure"). Cloudflare
# adds HSTS itself. The site loads nothing from anywhere else, so everything is limited to itself;
# inline scripts and styles stay allowed, since the loading screen, the theme switch, React
# Router's page data and the highlighted code are inline. No other site may frame these pages.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
