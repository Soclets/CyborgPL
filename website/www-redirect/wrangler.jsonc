// www.nerve-lang.com → nerve-lang.com, path and query kept. A separate Worker so the
// main site stays static-only (free and unlimited); only www visits run code.
{
  "name": "nerve-www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "www.nerve-lang.com", "custom_domain": true }]
}
