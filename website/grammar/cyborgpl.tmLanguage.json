              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "keyword.other.precedence.cyborgpl"
            },
            "4": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "5": {
              "name": "keyword.other.precedence.cyborgpl"
            }
          }
        },
        {
          "include": "#number"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.cyborgpl"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.cyborgpl"
            }
          },
          "patterns": [
            {
              "include": "#precedence-levels"
            }
          ]
        },
        {
          "comment": "Inside a level, every word names an operator.",
          "name": "keyword.operator.word.custom.cyborgpl",
          "match": "\\b[a-z_][A-Za-z0-9_.]*\\b"
        },
        {
          "comment": "…and every run of symbols does too.",
          "name": "keyword.operator.custom.cyborgpl",
          "match": "[!%&*+\\-/<>=?@^|~]+"
        }
      ]
    },
    "precedence-block": {
      "comment": "A Limb's operator precedence (2026-10-03): `precedence.low_first { … }` or `precedence.high_first { … }`.",
      "begin": "\\b(precedence)(\\.)(low_first|high_first)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.cyborgpl"
        },
        "2": {
          "name": "punctuation.accessor.cyborgpl"
        },
        "3": {
          "name": "keyword.other.precedence.cyborgpl"
        },
        "4": {
          "name": "punctuation.section.braces.begin.cyborgpl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.cyborgpl"
        }
      },
      "patterns": [
        {
          "include": "#precedence-levels"
        }
      ]
    }
  }
