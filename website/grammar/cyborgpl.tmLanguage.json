{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cyborgpl",
  "displayName": "CyborgPL",
  "scopeName": "source.cyborgpl",
  "fileTypes": [
    "cpls"
  ],
  "aliases": [
    "cpls"
  ],
  "patterns": [
    {
      "include": "#strict"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#asm-block"
    },
    {
      "include": "#text"
    },
    {
      "include": "#character"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#newline-piece"
    },
    {
      "include": "#unit"
    },
    {
      "include": "#number"
    },
    {
      "include": "#precedence-block"
    },
    {
      "include": "#enum-body"
    },
    {
      "include": "#check-tier"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#failure-name"
    },
    {
      "include": "#generic"
    },
    {
      "include": "#bound"
    },
    {
      "include": "#type"
    },
    {
      "include": "#field"
    },
    {
      "include": "#struct-name"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#case-arm"
    },
    {
      "include": "#call"
    },
    {
      "include": "#lifetime"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#module-path"
    },
    {
      "include": "#word-operator"
    },
    {
      "include": "#function-ref"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "#wl comments out the whole line, code before it included.",
          "name": "comment.line.number-sign.whole-line.cyborgpl",
          "match": "^.*?#wl.*$"
        },
        {
          "comment": "#Nl covers N lines counting this one; #Nld this line plus N more. Only the opening line can be matched line-wise.",
          "name": "comment.line.number-sign.multi.cyborgpl",
          "match": "#\\d+ld?\\b.*$"
        },
        {
          "name": "comment.line.number-sign.cyborgpl",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.cyborgpl"
            }
          }
        }
      ]
    },
    "asm-block": {
      "comment": "inline.ASM { … } is taken verbatim to the matching brace.",
      "name": "meta.embedded.asm.cyborgpl",
      "begin": "\\b(inline)(\\.)(ASM)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.inline.cyborgpl"
        },
        "2": {
          "name": "punctuation.accessor.cyborgpl"
        },
        "3": {
          "name": "keyword.other.asm.cyborgpl"
        },
        "4": {
          "name": "punctuation.section.braces.begin.cyborgpl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.cyborgpl"
        }
      },
      "contentName": "meta.embedded.block.asm"
    },
    "text": {
      "comment": "A text literal is exactly its characters; only \\\" and \\\\ escape. A backslash before anything else is literal.",
      "name": "string.quoted.double.cyborgpl",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.cyborgpl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.cyborgpl"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.cyborgpl",
          "match": "\\\\[\"\\\\]"
        }
      ]
    },
    "character": {
      "comment": "`c` — one character.",
      "name": "string.quoted.other.character.cyborgpl",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.cyborgpl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.cyborgpl"
        }
      }
    },
    "variable": {
      "comment": "Every variable name is quoted: 'x'. It cannot span lines.",
      "name": "variable.other.cyborgpl",
      "match": "'[^'\\n]+'",
      "captures": {
        "0": {
          "name": "variable.other.cyborgpl"
        }
      }
    },
    "newline-piece": {
      "comment": "The newline is a bare \\n outside any string — a value, not an escape.",
      "name": "constant.character.newline.cyborgpl",
      "match": "\\\\n"
    },
    "number": {
      "patterns": [
        {
          "comment": "`*0.1` — \"exactly this\", a deci (2026-10-02). The * belongs to the number.",
          "name": "constant.numeric.exact.cyborgpl",
          "match": "\\*\\d[\\d_]*(?:\\.\\d[\\d_]*)?\\b"
        },
        {
          "comment": "_ groups digits; , never does. A fraction needs a digit on both sides.",
          "name": "constant.numeric.decimal.cyborgpl",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.cyborgpl",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "comment": "A language named after a dot (2026-10-02): `extern.C`, `layout.C`, `inline.S` / `inline.ASM`, `inline.MSL`. Not a struct type.",
          "match": "\\b(extern|layout|inline)(\\.)(C|S|ASM|MSL)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "keyword.declaration.language.cyborgpl"
            }
          }
        },
        {
          "comment": "A custom operator, or an operator handed over as a value: `op dot [...]`, `op <+>`, `op div.floor`.",
          "match": "\\b(op)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|[!%&*+\\-/<>=?@^|~]+)",
          "captures": {
            "1": {
              "name": "keyword.declaration.operator.cyborgpl"
            },
            "2": {
              "name": "entity.name.function.operator.cyborgpl"
            }
          }
        },
        {
          "comment": "fn name [params] --> type",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.cyborgpl"
            },
            "2": {
              "name": "entity.name.function.cyborgpl"
            }
          }
        },
        {
          "comment": "struct / enum / interface declare a type's bare name.",
          "match": "\\b(struct|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.cyborgpl"
            },
            "2": {
              "name": "entity.name.type.cyborgpl"
            }
          }
        },
        {
          "comment": "module and limb declare a namespace.",
          "match": "\\b(module|limb)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.cyborgpl"
            },
            "2": {
              "name": "entity.name.namespace.cyborgpl"
            }
          }
        },
        {
          "comment": "MAIN is the entry point.",
          "name": "entity.name.function.main.cyborgpl",
          "match": "\\bMAIN\\b"
        }
      ]
    },
    "failure-name": {
      "comment": "A failure is named after `fail`, both in a signature (`--> T or fail[empty]`) and where it is raised (`fail empty;`).",
      "patterns": [
        {
          "match": "\\b(fail)\\s*(\\[)([^\\]]*)(\\])",
          "captures": {
            "1": {
              "name": "keyword.control.failure.cyborgpl"
            },
            "2": {
              "name": "punctuation.section.brackets.cyborgpl"
            },
            "3": {
              "name": "entity.name.tag.failure.cyborgpl"
            },
            "4": {
              "name": "punctuation.section.brackets.cyborgpl"
            }
          }
        },
        {
          "match": "\\b(fail)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.failure.cyborgpl"
            },
            "2": {
              "name": "entity.name.tag.failure.cyborgpl"
            }
          }
        }
      ]
    },
    "generic": {
      "patterns": [
        {
          "comment": "A generic blank in angle brackets, optionally constrained by an interface: `<T>`, `<T: Ordered>`.",
          "match": "(<)([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.generic.begin.cyborgpl"
            },
            "2": {
              "name": "entity.name.type.generic.cyborgpl"
            },
            "3": {
              "name": "punctuation.separator.type.cyborgpl"
            },
            "4": {
              "name": "entity.name.type.interface.cyborgpl"
            },
            "5": {
              "name": "punctuation.definition.generic.end.cyborgpl"
            }
          }
        },
        {
          "comment": "A generic's bound after its brackets (2026-10-02): `<T>: any`, `<T>: Ordered`.",
          "match": "(?<=>)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.cyborgpl"
            },
            "2": {
              "patterns": [
                {
                  "include": "#type"
                },
                {
                  "include": "#struct-name"
                }
              ]
            }
          }
        },
        {
          "comment": "`|` separates a bound from lifetime groups: `<T>: any | @x`.",
          "name": "punctuation.separator.lifetimes.cyborgpl",
          "match": "\\|(?=\\s*@)"
        }
      ]
    },
    "struct-name": {
      "comment": "Structs, enums and interfaces are named in PascalCase in the examples; functions are snake_case. A bare capitalised word is therefore a type — including where one is built (`Locker[…]`) or narrowed (`Status.empty`).",
      "name": "entity.name.type.cyborgpl",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "field": {
      "comment": "A struct field or enum case names itself with a bare word before `:`; variables are quoted, so there is no clash.",
      "patterns": [
        {
          "comment": "A struct field or enum case names itself with a bare word before `:`; variables are quoted, so there is no clash.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.other.member.declaration.cyborgpl"
            },
            "2": {
              "name": "punctuation.separator.type.cyborgpl"
            }
          }
        },
        {
          "comment": "A field label when a struct is built: `Locker[number = 1]`. A bare word before a single `=`; assignments name a quoted variable instead.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?![=>])",
          "captures": {
            "1": {
              "name": "variable.other.member.cyborgpl"
            },
            "2": {
              "name": "keyword.operator.assignment.cyborgpl"
            }
          }
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "comment": "Rust's number names, aliases for CyborgPL's (2026-10-02): i8–i128, u8–u128, f16 f32 f64; and the brain float, brain16 / bfloat16 / bf16.",
          "name": "support.type.numeric.cyborgpl",
          "match": "\\b(?:[iu](?:8|16|32|64|128)|f(?:16|32|64)|brain16|bfloat16|bf16)\\b"
        },
        {
          "comment": "Nonstandard widths, such as !std_int24, !std_u4 and !std_uint256.",
          "name": "support.type.numeric.cyborgpl",
          "match": "(?<![A-Za-z0-9_])!std_(?:u?int|[iu])[1-9][0-9]*\\b"
        },
        {
          "comment": "Widths are explicit: int/uint 8–128, bin 16–64, deci 32–128.",
          "name": "support.type.numeric.cyborgpl",
          "match": "\\b(?:u?int(?:8|16|32|64|128)|bin(?:16|32|64)|deci(?:32|64|128))\\b"
        },
        {
          "comment": "Text and character types are never bare: str.utf8, char.point.",
          "match": "\\b(str)(\\.)(utf8|utf16|utf32|ascii)\\b",
          "captures": {
            "1": {
              "name": "support.type.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "support.type.narrowing.cyborgpl"
            }
          }
        },
        {
          "match": "\\b(char)(\\.)(point|grapheme|byte)\\b",
          "captures": {
            "1": {
              "name": "support.type.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "support.type.narrowing.cyborgpl"
            }
          }
        },
        {
          "match": "\\b(map)(\\.)(ordered|unordered)\\b",
          "captures": {
            "1": {
              "name": "support.type.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "support.type.narrowing.cyborgpl"
            }
          }
        },
        {
          "match": "\\b(ptr)(\\.)(mut)\\b",
          "captures": {
            "1": {
              "name": "support.type.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "support.type.narrowing.cyborgpl"
            }
          }
        },
        {
          "comment": "A library call through a built-in type is one dotted name up to its brackets: list.length[…], str.each.grapheme[…], simd.load.some[…].",
          "match": "\\b(str|char|list|array|seq|map|simd|channel|ptr)(\\.)([a-z_][A-Za-z0-9_]*(?:\\.[a-z_][A-Za-z0-9_]*)*)(?=\\s*\\[)",
          "captures": {
            "1": {
              "name": "support.type.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "entity.name.function.cyborgpl"
            }
          }
        },
        {
          "name": "support.type.cyborgpl",
          "match": "\\b(?:bool|str|char|list|array|seq|map|simd|channel|ptr|any)\\b",
          "comment": "The bare built-in types; `any` accepts every type (2026-10-02)."
        },
        {
          "comment": "A type written after `:` or `-->` that is none of the above is a struct in this module.",
          "match": "(?:(:)|(-->))\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.cyborgpl"
            },
            "2": {
              "name": "keyword.operator.arrow.cyborgpl"
            },
            "3": {
              "name": "entity.name.type.cyborgpl"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "comment": "A loop's modifiers come right after `for`, the strongest first: `for !c seq 'i' in …`, `for para 'x' in …` (2026-09-30). `seq` here is a word, not the type.",
          "match": "\\b(for)(\\s+!c\\b)?(\\s+(?:seq|para)\\b)?",
          "captures": {
            "1": {
              "name": "keyword.control.cyborgpl"
            },
            "2": {
              "name": "storage.modifier.cyborgpl"
            },
            "3": {
              "name": "storage.modifier.cyborgpl"
            }
          }
        },
        {
          "comment": "`test fn name [] { … }` and its assertions (2026-09-29): `must`, `must.fail` (something fails; `.reason` names which), `must.stop` (a check site fires).",
          "match": "\\b(test)(?=\\s+fn\\b)|\\b(must(?:\\.fail|\\.stop)?)\\b(?:(\\.)([a-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.other.test.cyborgpl"
            },
            "2": {
              "name": "keyword.other.test.cyborgpl"
            },
            "3": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "4": {
              "name": "entity.name.tag.failure.cyborgpl"
            }
          }
        },
        {
          "comment": "Ownership verbs, at the call site.",
          "name": "keyword.other.ownership.cyborgpl",
          "match": "\\b(?:give|copy|lend|lent)(?:\\.mut)?\\b"
        },
        {
          "comment": "#strict labels a range's bounds (2026-09-27): range[from 1, to 4, by 1].",
          "name": "keyword.other.range.label.cyborgpl",
          "match": "(?<=\\[|,\\s)(?:from|to|by)\\b(?=\\s)"
        },
        {
          "comment": "`change` marks every assignment; `let` introduces a binding.",
          "name": "keyword.other.change.cyborgpl",
          "match": "\\bchange\\b"
        },
        {
          "comment": "`!$` in front: the name cannot be shadowed. `!mut` is `immut` (2026-09-25). `!c` on a `for`: no cheating, every round runs (2026-09-30).",
          "name": "storage.modifier.cyborgpl",
          "match": "!\\$|!mut\\b|!c\\b"
        },
        {
          "comment": "`&` and `&mut` are lend / lend.mut, and lent / lent.mut on a parameter.",
          "name": "keyword.other.ownership.cyborgpl",
          "match": "&(?:mut\\b)?"
        },
        {
          "comment": "Failures in signatures, handled with `otherwise`.",
          "name": "keyword.control.failure.cyborgpl",
          "match": "\\b(?:fail|otherwise)\\b"
        },
        {
          "name": "keyword.control.cyborgpl",
          "match": "\\b(?:if|else|loop|while|for|in|break|continue|return|giveS|match|whichever|concur)\\b",
          "comment": "`giveS` is a `#strict` match arm's value (2026-09-29; the capital S keeps it apart from `give`)."
        },
        {
          "name": "keyword.declaration.cyborgpl",
          "match": "\\b(?:pub\\.limb|let|fn|struct|enum|interface|module|limb|const|pub|op|extern|layout|inline|asm|ASM)\\b",
          "comment": "`pub.limb` is `pub` narrowed: visible across the limb."
        },
        {
          "name": "storage.modifier.cyborgpl",
          "match": "\\b(?:mut|immut|temp|perm|satisfies|from|to(?!\\.)|with|size|align)\\b",
          "comment": "`to` before a dot is a conversion (to.int32[…]), matched as a call."
        },
        {
          "comment": "`pos` marks a position, in `#strict` files only (removed elsewhere 2026-09-27): 'xs'[pos 1].",
          "name": "keyword.other.position.cyborgpl",
          "match": "\\bpos\\b"
        },
        {
          "name": "keyword.other.range.cyborgpl",
          "match": "\\brange\\b"
        },
        {
          "name": "constant.language.boolean.cyborgpl",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "comment": "Retired, still reserved so the error can point at the new spelling: var/func and gives (now giveS).",
          "name": "invalid.deprecated.cyborgpl",
          "match": "\\b(?:var|func|gives)\\b"
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "comment": "A capitalised name reached through a module is a type: `counter.Count`, `counter.Count[n = 1]`.",
          "match": "(\\.)([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "2": {
              "name": "entity.name.type.cyborgpl"
            }
          }
        },
        {
          "comment": "Limb path: std::print.stdout[…]. The :: is a Limb boundary.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)((?:[A-Za-z_][A-Za-z0-9_]*)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "entity.name.namespace.cyborgpl"
            },
            "2": {
              "name": "punctuation.separator.namespace.cyborgpl"
            },
            "3": {
              "name": "entity.name.function.cyborgpl"
            }
          }
        },
        {
          "comment": "A conversion: to.int32[…], to.str.utf8[…].",
          "match": "\\b(to)(\\.)((?:[A-Za-z_][A-Za-z0-9_]*)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.conversion.cyborgpl"
            },
            "2": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "3": {
              "name": "support.type.cyborgpl"
            }
          }
        },
        {
          "comment": "Calls use brackets, never parentheses: add[1, 2].",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\[)",
          "captures": {
            "1": {
              "name": "entity.name.function.cyborgpl"
            }
          }
        },
        {
          "comment": "A bare lowercase segment between dots, after a bare word, is a module: counter.inner.twice[…]. A quoted variable's field chain starts with ' and is left to the narrowing rule.",
          "match": "(?<=[A-Za-z0-9_])(\\.)([a-z_][A-Za-z0-9_]*)(?=\\.[a-z_])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "2": {
              "name": "entity.name.namespace.cyborgpl"
            }
          }
        },
        {
          "comment": "A dotted name called with brackets is a function: `counter.bump[…]`, `map.remove[…]`.",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\[)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "2": {
              "name": "entity.name.function.cyborgpl"
            }
          }
        },
        {
          "comment": "A dot narrows: 'xs'.length, str.utf8, lend.mut.",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.cyborgpl"
            },
            "2": {
              "name": "variable.other.member.cyborgpl"
            }
          }
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "comment": "Bitwise: the boolean words narrowed with .bit, plus xor/shl/shr. No precedence — parenthesise.",
          "name": "keyword.operator.bitwise.cyborgpl",
          "match": "\\b(?:and\\.bit|or\\.bit|xor|shl|shr|not\\.bit)\\b"
        },
        {
          "comment": "Arithmetic operators are words; .wrap requests wrapping, and div/mod name their rounding. `and.then` / `or.else` stop early.",
          "name": "keyword.operator.word.cyborgpl",
          "match": "\\b(?:and\\.then|or\\.else|(?:plus|minus|times|pow)(?:\\.wrap)?|(?:div|mod)\\.(?:floor|ceil|trunc|near)(?:\\.wrap)?|and|or|not)\\b"
        },
        {
          "comment": "$ marks a shadowing declaration and sits on the operator.",
          "name": "keyword.operator.assignment.shadow.cyborgpl",
          "match": "\\$(?::=|=)"
        },
        {
          "comment": ":= infers the best type; = needs the type written.",
          "name": "keyword.operator.assignment.infer.cyborgpl",
          "match": ":="
        },
        {
          "name": "keyword.operator.arrow.cyborgpl",
          "match": "-->|<--|<->|->|<-"
        },
        {
          "comment": "A custom operator in brackets, in use: `'u' <+> 'v'`. Not a comparison around a plus.",
          "name": "keyword.operator.custom.cyborgpl",
          "match": "<[!%&*+\\-/?@^|~]+>"
        },
        {
          "comment": "++ joins text.",
          "name": "keyword.operator.join.cyborgpl",
          "match": "\\+\\+"
        },
        {
          "comment": "Comparison: == !== < > and </== >/== (less / greater, or equal; 2026-09-29).",
          "name": "keyword.operator.comparison.cyborgpl",
          "match": "!==|</==|>/==|==|<|>"
        },
        {
          "comment": "Retired spellings; `/` is now a named division and `<==` / `>==` are `</==` / `>/==`.",
          "name": "invalid.deprecated.cyborgpl",
          "match": "<==|>==|(?<![!%&*+\\-/<>=?@^|~])/(?![!%&*+\\-/<>=?@^|~])"
        },
        {
          "comment": "Retired since 2026-10-03: `+` is `plus`, and `+~` / `-~` are `plus.wrap` / `minus.wrap`.",
          "name": "invalid.deprecated.cyborgpl",
          "match": "\\+~?|-~"
        },
        {
          "comment": "A negative keeps the `-` sign; binary arithmetic uses words.",
          "name": "keyword.operator.arithmetic.cyborgpl",
          "match": "-(?!~)"
        },
        {
          "name": "keyword.operator.assignment.cyborgpl",
          "match": "(?<![!%&*+\\-/<>=?@^|~])=(?![!%&*+\\-/<>=?@^|~])",
          "comment": "A lone `=`: a written type's value, a change, or a field label. A longer run is an operator."
        },
        {
          "comment": "A maximal run of operator characters is one operator: the language's own, or a custom `op`.",
          "name": "keyword.operator.custom.cyborgpl",
          "match": "[!%&*+\\-/<>=?@^|~]+"
        },
        {
          "comment": "A variadic parameter.",
          "name": "keyword.operator.variadic.cyborgpl",
          "match": "\\.\\.\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.cyborgpl",
          "match": "::"
        },
        {
          "name": "punctuation.separator.type.cyborgpl",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.cyborgpl",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.cyborgpl",
          "match": ","
        },
        {
          "name": "punctuation.accessor.cyborgpl",
          "match": "\\."
        },
        {
          "name": "punctuation.section.brackets.cyborgpl",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.cyborgpl",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.cyborgpl",
          "match": "[()]"
        }
      ]
    },
    "enum-body": {
      "comment": "Inside `enum Name { … }` every bare word is a case; a case with a payload is written `some: <T>`, and in a `layout.c enum` a case is given its number: `a = 65`.",
      "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>]*>)?\\s*(?:(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.cyborgpl"
        },
        "2": {
          "name": "entity.name.type.enum.cyborgpl"
        },
        "3": {
          "patterns": [
            {
              "include": "#generic"
            }
          ]
        },
        "4": {
          "name": "punctuation.separator.type.cyborgpl"
        },
        "5": {
          "patterns": [
            {
              "include": "#type"
            },
            {
              "include": "#struct-name"
            }
          ]
        },
        "6": {
          "name": "punctuation.section.braces.begin.cyborgpl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.cyborgpl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#generic"
        },
        {
          "include": "#type"
        },
        {
          "include": "#struct-name"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.other.enummember.cyborgpl"
            },
            "2": {
              "name": "punctuation.separator.type.cyborgpl"
            }
          }
        },
        {
          "name": "variable.other.enummember.cyborgpl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "include": "#number"
        },
        {
          "comment": "`layout.c enum Key { a = 65 }`: each case's number (2026-09-27).",
          "name": "keyword.operator.assignment.cyborgpl",
          "match": "="
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "case-arm": {
      "comment": "An arm of `match` or of an `otherwise { … }` handler names an enum case or a failure: a bare word, optionally binding a quoted variable, before `{`. Keywords that open a block (`else`, `loop`, `concur`…) are matched earlier and win. A word straight after a value is an operator position (`'a' and 'b' {`), never an arm, so that position is excluded.",
      "match": "(?<!['\\)\\]\\d] )\\b(?!(?:plus|minus|times|pow|div|mod|and|or|not|xor|shl|shr)\\b)([a-z_][A-Za-z0-9_]*)(?:\\s+('[^'\\n]+'))?\\s*(?=\\{)",
      "captures": {
        "1": {
          "name": "variable.other.enummember.cyborgpl"
        },
        "2": {
          "name": "variable.other.cyborgpl"
        }
      }
    },
    "unit": {
      "comment": "A unit after a number: durations (`5 seconds`, `1500 millis`) and a text bound's unit (`[1, 40 graphemes]`). Lists are oracle/src/parser.rs DURATION_UNITS and the text-bound units.",
      "match": "(?<=\\d)\\s+(nanos?|micros?|millis?|seconds?|minutes?|hours?|bytes|points|graphemes)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.unit.cyborgpl"
        }
      }
    },
    "bound": {
      "comment": "`min` / `max` as an open end of a ranged type: `int32[1, max]`, `int32[min, 100]`.",
      "patterns": [
        {
          "match": "(?<=\\[)\\s*(min)\\b(?=\\s*,)",
          "captures": {
            "1": {
              "name": "constant.language.bound.cyborgpl"
            }
          }
        },
        {
          "match": "(?<=,)\\s*(max)\\b(?=\\s*\\])",
          "captures": {
            "1": {
              "name": "constant.language.bound.cyborgpl"
            }
          }
        }
      ]
    },
    "word-operator": {
      "comment": "A bare word between two values is a custom infix operator: `'u' dot 'v'`. Keywords at the same place (`in`) are matched earlier and win.",
      "match": "(?<=['\\)\\]\\d] )([a-z_][A-Za-z0-9_]*)(?=\\s+['\\(\\d\\[])",
      "captures": {
        "1": {
          "name": "keyword.operator.word.custom.cyborgpl"
        }
      }
    },
    "module-path": {
      "comment": "A lowercase bare word before `.` is a module: `counter.Count`, `counter.inner.twice`. The parser enforces lowercase module names. Built-in types before a dot (`str.utf8`, `map.remove`) are matched earlier.",
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\.[A-Za-z_'])",
      "captures": {
        "1": {
          "name": "entity.name.namespace.cyborgpl"
        }
      }
    },
    "function-ref": {
      "comment": "Variables are always quoted, so a bare lowercase word left over is a function named as a value: `first_by[…, by_number]`, `let 'f' := by_number;`.",
      "name": "entity.name.function.reference.cyborgpl",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    },
    "strict": {
      "comment": "`#strict` (2026-09-27), once at the top of a file: the file writes out its reasons. It is not a comment — a comment's # is followed by a space or a comment form.",
      "name": "keyword.other.directive.strict.cyborgpl",
      "match": "#strict\\b"
    },
    "check-tier": {
      "comment": "The check tiers. NO_FUCKING_CHECKS (2026-09-27) also trusts the numbers C hands back.",
      "name": "keyword.other.check.cyborgpl",
      "match": "\\b(?:check|nocheck|NO_FUCKING_CHECKS)\\b"
    },
    "lifetime": {
      "comment": "`@x` names a lifetime group on a returned borrow, `--> lent@x T`.",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.lifetime.cyborgpl"
        },
        "2": {
          "name": "storage.modifier.lifetime.cyborgpl"
        }
      }
    },
    "precedence-levels": {
      "patterns": [
        {
          "include": "#comment"
