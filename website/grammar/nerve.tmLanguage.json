{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nerve",
  "displayName": "Nerve",
  "scopeName": "source.nerve",
  "fileTypes": [
    "zv",
    "zg",
    "nrv",
    "nrp"
  ],
  "aliases": [
    "cpls"
  ],
  "patterns": [
    {
      "include": "#strict"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#asm-block"
    },
    {
      "include": "#text"
    },
    {
      "include": "#character"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#newline-piece"
    },
    {
      "include": "#unit"
    },
    {
      "include": "#number"
    },
    {
      "include": "#precedence-block"
    },
    {
      "include": "#enum-body"
    },
    {
      "include": "#check-tier"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#failure-name"
    },
    {
      "include": "#generic"
    },
    {
      "include": "#bound"
    },
    {
      "include": "#empty-value"
    },
    {
      "include": "#type"
    },
    {
      "include": "#field"
    },
    {
      "include": "#struct-name"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#case-arm"
    },
    {
      "include": "#call"
    },
    {
      "include": "#lifetime"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#module-path"
    },
    {
      "include": "#word-operator"
    },
    {
      "include": "#register"
    },
    {
      "include": "#function-ref"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "#wl comments out the whole line, code before it included.",
          "name": "comment.line.number-sign.whole-line.nerve",
          "match": "^.*?#wl.*$"
        },
        {
          "comment": "#Nl covers N lines counting this one; #Nld this line plus N more. Only the opening line can be matched line-wise.",
          "name": "comment.line.number-sign.multi.nerve",
          "match": "#\\d+ld?\\b.*$"
        },
        {
          "name": "comment.line.number-sign.nerve",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.nerve"
            }
          }
        }
      ]
    },
    "asm-block": {
      "comment": "inline.ASM { … } runs to the matching brace; inside, the assembly is coloured as assembly: instructions, registers, numbers, labels and comments (ARM64 and x86-64).",
      "name": "meta.embedded.asm.nerve",
      "begin": "\\b(inline)(\\.)(ASM)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.inline.nerve"
        },
        "2": {
          "name": "punctuation.accessor.nerve"
        },
        "3": {
          "name": "keyword.other.asm.nerve"
        },
        "4": {
          "name": "punctuation.section.braces.begin.nerve"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.nerve"
        }
      },
      "contentName": "meta.embedded.block.asm",
      "patterns": [
        {
          "name": "comment.line.asm.nerve",
          "match": "(?://|;|#(?![0-9-])).*$"
        },
        {
          "match": "^\\s*([A-Za-z_.][\\w.]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.label.nerve"
            },
            "2": {
              "name": "punctuation.separator.nerve"
            }
          }
        },
        {
          "match": "(?:^|(?<=\\{))\\s*([a-z][a-z0-9.]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.instruction.nerve"
            }
          }
        },
        {
          "name": "variable.language.register.nerve",
          "match": "\\b(?:[xwvqdsbh](?:[12]?[0-9]|3[01])|sp|wsp|xzr|wzr|lr|fp|pc|r[a-d]x|r[sd]i|r[sb]p|r(?:[89]|1[0-5])[dwb]?|e[a-d]x|e[sd]i|e[sb]p|[a-d][lhx])\\b"
        },
        {
          "name": "constant.numeric.integer.nerve",
          "match": "#?-?\\b(?:0x[0-9A-Fa-f]+|[0-9]+)\\b"
        },
        {
          "name": "punctuation.separator.comma.nerve",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.nerve",
          "match": "[\\[\\]]"
        }
      ]
    },
    "text": {
      "comment": "A text literal is exactly its characters; only \\\" and \\\\ escape. A backslash before anything else is literal.",
      "name": "string.quoted.double.nerve",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nerve"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nerve"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nerve",
          "match": "\\\\[\"\\\\]"
        }
      ]
    },
    "character": {
      "comment": "`c` — one character.",
      "name": "string.quoted.other.character.nerve",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nerve"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nerve"
        }
      }
    },
    "variable": {
      "comment": "Every variable name is quoted: 'x'. It cannot span lines.",
      "name": "variable.other.nerve",
      "match": "'[^'\\n]+'",
      "captures": {
        "0": {
          "name": "variable.other.nerve"
        }
      }
    },
    "newline-piece": {
      "patterns": [
        {
          "comment": "`newln`, the newline as a value outside any text (2026-10-07).",
          "name": "constant.character.newline.nerve",
          "match": "\\bnewln\\b"
        },
        {
          "comment": "A bare `\\n` outside text was the newline's old spelling; it is `newln` since 2026-10-07.",
          "name": "invalid.deprecated.nerve",
          "match": "\\\\n"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "`*0.1` — \"exactly this\", a deci (2026-10-02). The * belongs to the number.",
          "name": "constant.numeric.exact.nerve",
          "match": "\\*\\d[\\d_]*(?:\\.\\d[\\d_]*)?\\b"
        },
        {
          "comment": "_ groups digits; , never does. A fraction needs a digit on both sides.",
          "name": "constant.numeric.decimal.nerve",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.nerve",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "comment": "`shadow 'x' := 2;` makes a new variable under an old name (2026-10-08), in `let`'s place.",
          "name": "keyword.declaration.nerve",
          "match": "\\bshadow\\b"
        },
        {
          "comment": "A language named after a dot (2026-10-02): `extern.C`, `layout.C`, `inline.S` / `inline.ASM`, `inline.MSL`. Not a struct type.",
          "match": "\\b(extern|layout|inline)(\\.)(C|ASM|LL|MSL|S|Assembly)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "keyword.declaration.language.nerve"
            }
          }
        },
        {
          "comment": "A custom operator, or an operator handed over as a value: `op dot [...]`, `op <+>`, `op div.floor`.",
          "match": "\\b(op)\\s+([\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*|[!%&*+\\-/<>=?@^|~]+)",
          "captures": {
            "1": {
              "name": "keyword.declaration.operator.nerve"
            },
            "2": {
              "name": "entity.name.function.operator.nerve"
            }
          }
        },
        {
          "comment": "fn name [params] --> type",
          "match": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.nerve"
            },
            "2": {
              "name": "entity.name.function.nerve"
            }
          }
        },
        {
          "comment": "struct / enum / interface declare a type's bare name.",
          "match": "\\b(struct|enum|interface)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.nerve"
            },
            "2": {
              "name": "entity.name.type.nerve"
            }
          }
        },
        {
          "comment": "module and limb declare a namespace.",
          "match": "\\b(module|limb)\\s+([\\p{Ll}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.nerve"
            },
            "2": {
              "name": "entity.name.namespace.nerve"
            }
          }
        },
        {
          "comment": "MAIN is the entry point.",
          "name": "entity.name.function.main.nerve",
          "match": "\\bMAIN\\b"
        }
      ]
    },
    "failure-name": {
      "comment": "A failure is named after `fail`, both in a signature (`--> T or fail[empty]`) and where it is raised (`fail empty;`).",
      "patterns": [
        {
          "match": "\\b(fail)\\s*(\\[)([^\\]]*)(\\])",
          "captures": {
            "1": {
              "name": "keyword.control.failure.nerve"
            },
            "2": {
              "name": "punctuation.section.brackets.nerve"
            },
            "3": {
              "name": "entity.name.tag.failure.nerve"
            },
            "4": {
              "name": "punctuation.section.brackets.nerve"
            }
          }
        },
        {
          "match": "\\b(fail)\\s+([\\p{Ll}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.failure.nerve"
            },
            "2": {
              "name": "entity.name.tag.failure.nerve"
            }
          }
        }
      ]
    },
    "generic": {
      "patterns": [
        {
          "comment": "A generic blank in angle brackets, optionally constrained by an interface: `<T>`, `<T: Ordered>`.",
          "match": "(<)([\\p{L}_][\\p{L}\\p{N}_]*)(?:\\s*(:)\\s*([\\p{L}_][\\p{L}\\p{N}_]*))?(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.generic.begin.nerve"
            },
            "2": {
              "name": "entity.name.type.generic.nerve"
            },
            "3": {
              "name": "punctuation.separator.type.nerve"
            },
            "4": {
              "name": "entity.name.type.interface.nerve"
            },
            "5": {
              "name": "punctuation.definition.generic.end.nerve"
            }
          }
        },
        {
          "comment": "A generic's bound after its brackets (2026-10-02): `<T>: any`, `<T>: Ordered`.",
          "match": "(?<=>)\\s*(:)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.nerve"
            },
            "2": {
              "patterns": [
                {
                  "include": "#type"
                },
                {
                  "include": "#struct-name"
                }
              ]
            }
          }
        },
        {
          "comment": "`|` separates a bound from lifetime groups: `<T>: any | @x`.",
          "name": "punctuation.separator.lifetimes.nerve",
          "match": "\\|(?=\\s*@)"
        }
      ]
    },
    "struct-name": {
      "comment": "Structs, enums and interfaces are named in PascalCase in the examples; functions are snake_case. A bare capitalised word is therefore a type — including where one is built (`Locker[…]`) or narrowed (`Status.empty`).",
      "name": "entity.name.type.nerve",
      "match": "\\b\\p{Lu}[\\p{L}\\p{N}_]*\\b"
    },
    "field": {
      "comment": "A struct field or enum case names itself with a bare word before `:`; variables are quoted, so there is no clash.",
      "patterns": [
        {
          "comment": "A struct field or enum case names itself with a bare word before `:`; variables are quoted, so there is no clash.",
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.other.member.declaration.nerve"
            },
            "2": {
              "name": "punctuation.separator.type.nerve"
            }
          }
        },
        {
          "comment": "A field label when a struct is built: `Locker[number = 1]`. A bare word before a single `=`; assignments name a quoted variable instead.",
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(=)(?![=>])",
          "captures": {
            "1": {
              "name": "variable.other.member.nerve"
            },
            "2": {
              "name": "keyword.operator.assignment.nerve"
            }
          }
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "comment": "An enum's case through its type: `Aisle.fresh`, `Status.empty` (a call, `Ticket.next[…]`, is a function).",
          "match": "(?<![.'\\p{L}\\p{N}_])(\\p{Lu}[\\p{L}\\p{N}_]*)(\\.)([\\p{Ll}_][\\p{L}\\p{N}_]*)\\b(?!\\s*\\[)",
          "captures": {
            "1": {
              "name": "entity.name.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "variable.other.enummember.nerve"
            }
          }
        },
        {
          "comment": "C's types, each C's size on the machine built for (2026-10-12): `C.int`, `C.long`, `C.size_t`, `C.long_double`.",
          "match": "(?<![.\\p{L}\\p{N}_])(C)(\\.)([\\p{Ll}_][\\p{L}\\p{N}_]*)\\b",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "support.type.numeric.nerve"
            }
          }
        },
        {
          "comment": "The base's `optional` (2026-10-09): `optional[int32]`, and its two cases, `optional.none` and `optional.value[…]`.",
          "match": "\\b(optional)(\\.)(none|value)\\b(?!\\s*\\[)",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "variable.other.enummember.nerve"
            }
          }
        },
        {
          "comment": "Rust's number names, aliases for Nerve's (2026-10-02): i8–i128, u8–u128, f16 f32 f64; and the brain float, brain16 / bfloat16 / bf16.",
          "name": "support.type.numeric.nerve",
          "match": "\\b(?:[iu](?:8|16|32|64|128)|f(?:16|32|64)|brain16|bfloat16|bf16)\\b"
        },
        {
          "comment": "Integers of any other width, \"not standard\" (2026-10-07): `not_std.int24`, `not_std.u4`, `not_std.uint256`.",
          "match": "\\b(not_std)(\\.)((?:u?int|[iu])[1-9][0-9]*)\\b",
          "captures": {
            "1": {
              "name": "support.type.numeric.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "support.type.numeric.nerve"
            }
          }
        },
        {
          "comment": "Their old spellings, `!std_int24` and `!std.int24`.",
          "name": "invalid.deprecated.nerve",
          "match": "(?<![A-Za-z0-9_])!std[_.](?:u?int|[iu])[1-9][0-9]*\\b"
        },
        {
          "comment": "Widths are explicit: int/uint 8–128, bin 16–64, deci 32–128.",
          "name": "support.type.numeric.nerve",
          "match": "\\b(?:u?int(?:8|16|32|64|128)|bin(?:16|32|64)|deci(?:32|64|128))\\b"
        },
        {
          "comment": "Text and character types are never bare: str.utf8, char.point.",
          "match": "\\b(str)(\\.)(utf8|utf16|utf32|ascii)\\b",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "support.type.narrowing.nerve"
            }
          }
        },
        {
          "match": "\\b(char)(\\.)(point|grapheme|byte)\\b",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "support.type.narrowing.nerve"
            }
          }
        },
        {
          "match": "\\b(map)(\\.)(ordered|unordered)\\b",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "support.type.narrowing.nerve"
            }
          }
        },
        {
          "match": "\\b(ptr)(\\.)(mut)\\b",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "support.type.narrowing.nerve"
            }
          }
        },
        {
          "comment": "A library call through a built-in type is one dotted name up to its brackets: list.length[…], str.each.grapheme[…], simd.load.some[…].",
          "match": "\\b(str|char|list|array|seq|map|simd|channel|ptr|optional)(\\.)([\\p{Ll}_][\\p{L}\\p{N}_]*(?:\\.[\\p{Ll}_][\\p{L}\\p{N}_]*)*)(?=\\s*\\[)",
          "captures": {
            "1": {
              "name": "support.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "entity.name.function.nerve"
            }
          }
        },
        {
          "name": "support.type.nerve",
          "match": "\\b(?:bool|str|char|list|array|seq|map|simd|channel|ptr|any|duration|optional)\\b",
          "comment": "The bare built-in types; `any` accepts every type (2026-10-02); `duration` is std's, written bare."
        },
        {
          "comment": "A type written after `:` or `-->` that is none of the above is a struct in this module.",
          "match": "(?:(:)|(->))\\s*(\\p{Lu}[\\p{L}\\p{N}_]*)(?![.\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.nerve"
            },
            "2": {
              "name": "keyword.operator.arrow.nerve"
            },
            "3": {
              "name": "entity.name.type.nerve"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "comment": "`exactly 19.99`: an exact deci (2026-10-14), the word for the prefix `*`.",
          "name": "keyword.other.exactly.nerve",
          "match": "\\bexactly\\b"
        },
        {
          "comment": "Files included while building, each a const's value (2026-10-12): `incl.bytes[…]`, `incl.str.utf8[…]`, `incl.str.utf16.low_first[…]`; and C headers, through CNC: `incl.C.system[\"stdio.h\"]`, `incl.C[\"vendor/mylib.h\"]`.",
          "match": "\\b(incl)(\\.)(?:(C)(?:(\\.)(system))?\\b|(bytes)\\b|(str(?:\\.[a-z0-9_]+)*))",
          "captures": {
            "1": {
              "name": "keyword.control.import.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "keyword.declaration.language.nerve"
            },
            "4": {
              "name": "punctuation.accessor.nerve"
            },
            "5": {
              "name": "keyword.control.import.nerve"
            },
            "6": {
              "name": "support.type.nerve"
            },
            "7": {
              "name": "support.type.nerve"
            }
          }
        },
        {
          "comment": "`size.of[T]`: its argument is a type, even a C struct's lowercase name (`size.of[tm]`).",
          "match": "\\b(size)(\\.)(of)(\\[)([\\p{L}_][\\p{L}\\p{N}_]*)(\\])",
          "captures": {
            "1": {
              "name": "storage.modifier.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "entity.name.function.nerve"
            },
            "4": {
              "name": "punctuation.section.brackets.nerve"
            },
            "5": {
              "name": "entity.name.type.nerve"
            },
            "6": {
              "name": "punctuation.section.brackets.nerve"
            }
          }
        },
        {
          "comment": "A C enum's case through its lowercase name (2026-10-12): `color.BLUE`, `level_t.LOW`.",
          "match": "(?<![.'\\p{L}\\p{N}_])([\\p{Ll}_][\\p{L}\\p{N}_]*)(\\.)([A-Z][A-Z0-9_]*)\\b(?![\\p{Ll}])",
          "captures": {
            "1": {
              "name": "entity.name.type.nerve"
            },
            "2": {
              "name": "punctuation.accessor.nerve"
            },
            "3": {
              "name": "variable.other.enummember.nerve"
            }
          }
        },
        {
          "comment": "std's print written bare (std is `bare.optional`): `print.useful[…]`, `print.weird.useful <- …`, `print.useful.stdout[…]`.",
          "match": "\\b(print(?:\\.(?:useful|stored|weird|format|stdout|stderr|auto_newln))+)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.nerve"
            }
          }
        },
        {
          "comment": "`is` gives a case its value (2026-10-07): `paid { is \"free\"; }`.",
          "name": "keyword.control.nerve",
          "match": "\\bis\\b"
        },
        {
          "comment": "`my.` is the root of this Limb's own paths: `my.'scale'`, and `my.to[]`, a function a keyword's name can't reach otherwise (2026-10-06).",
          "match": "\\b(my)(\\.)(?:([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\[))?",
