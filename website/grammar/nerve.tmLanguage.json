    },
    "check-tier": {
      "patterns": [
        {
          "comment": "The check tiers: `check`, `no_check` (2026-10-07), and NO_FUCKING_CHECKS, which also trusts the numbers C hands back.",
          "name": "keyword.other.check.nerve",
          "match": "\\b(?:check|no_check|NO_FUCKING_CHECKS)\\b"
        },
        {
          "comment": "`nocheck` and `!check` are `no_check` since 2026-10-07.",
          "name": "invalid.deprecated.nerve",
          "match": "\\bnocheck\\b|!check\\b"
        }
      ]
    },
    "lifetime": {
      "comment": "`@x` names a lifetime group on a returned borrow, `--> lent@x T`.",
      "match": "(@)([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.lifetime.nerve"
        },
        "2": {
          "name": "storage.modifier.lifetime.nerve"
        }
      }
    },
    "precedence-levels": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "comment": "The old `level.when_chained.left_first 2` (spellings.zv).",
          "name": "invalid.deprecated.nerve",
          "match": "\\blevel\\.when_chained(?:\\.[a-z_]+)?\\b"
        },
        {
          "match": "\\b(level)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.precedence.nerve"
            }
          }
        },
        {
          "name": "keyword.other.precedence.nerve",
          "match": "\\b(?:left_first|right_first|refused)\\b"
        },
        {
          "name": "punctuation.separator.comma.nerve",
          "match": ","
        },
        {
          "include": "#number"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.nerve"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.nerve"
            }
          },
          "patterns": [
            {
              "include": "#precedence-levels"
            }
          ]
        },
        {
          "comment": "Inside a level, every word names an operator.",
          "name": "keyword.operator.word.custom.nerve",
          "match": "\\b[a-z_][A-Za-z0-9_.]*\\b"
        },
        {
          "comment": "…and every run of symbols does too.",
          "name": "keyword.operator.custom.nerve",
          "match": "[!%&*+\\-/<>=?@^|~]+"
        }
      ]
    },
    "precedence-block": {
      "comment": "A Limb's operator precedence (2026-10-03): `precedence.low_first { … }` or `precedence.high_first { … }`.",
      "begin": "\\b(precedence)(\\.)(low_first|high_first)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.nerve"
        },
        "2": {
          "name": "punctuation.accessor.nerve"
        },
        "3": {
          "name": "keyword.other.precedence.nerve"
        },
        "4": {
          "name": "punctuation.section.braces.begin.nerve"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.nerve"
        }
      },
      "patterns": [
        {
          "include": "#precedence-levels"
        }
      ]
    },
    "register": {
      "comment": "A register an inline block reads or writes: `with ['n' -> rax, 'n' <- rax]`.",
      "match": "(?<=->\\s|<-\\s)([a-z][a-z0-9]*)\\b(?=\\s*[,\\]])",
      "captures": {
        "1": {
          "name": "variable.language.register.nerve"
        }
      }
    },
    "empty-value": {
      "comment": "An empty text, map or list (2026-10-14: `str.empty`, as `map.empty`).",
      "match": "\\b(str|map|list)(\\.)(empty)\\b",
      "captures": {
        "1": {
          "name": "support.type.nerve"
        },
        "2": {
          "name": "punctuation.accessor.nerve"
        },
        "3": {
          "name": "constant.language.empty.nerve"
        }
      }
    }
  }
}
