spellings::table[
    keywords = [
        "fn", "let", "shadow", "change", "is", "return", "if", "else", "loop", "while", "for", "in", "break", "continue",
        "give", "copy", "lend", "lent", "op", "check", "no_check", "no_cheat", "NO_FUCKING_CHECKS", "true", "false", "mut", "immut",
        "temp", "perm", "range", "seq", "para", "list", "array", "map", "simd", "channel", "concur", "whichever", "from",
        "struct", "pub", "const", "module", "kit", "not_std", "my", "on", "fail", "otherwise", "to", "extern", "layout",
        "ptr", "size", "align", "incl", "collection", "inline", "asm", "ASM", "enum", "match", "interface", "satisfies",
        "xor", "shl", "shr", "with", "test", "must", "exactly", "percent",
    ],
    retired = ["var", "func"],
    capitals = ["MAIN", "NO_FUCKING_CHECKS", "ASM", "C", "LL", "MSL"],
    old = [
        spellings::old[written = "limb.", write = ["my.",], since = "2026-10-06", where = "special"],
        spellings::old[written = "+~", write = ["plus.wrap",], since = "2026-10-03", where = "special"],
        spellings::old[written = "-~", write = ["minus.wrap",], since = "2026-10-03", where = "special"],
        spellings::old[written = "x~", write = ["times.wrap",], since = "2026-10-03", where = "special"],
        spellings::old[written = "xx~", write = ["pow.wrap",], note = "std's operator", since = "2026-10-03", where = "special"],
        spellings::old[written = "\"\"", write = ["str.empty",], since = "2026-10-14", where = "special"],
        spellings::old[written = "level.when_chained", write = ["level 2 { plus, minus } left_first",], since = "2026-10-14", where = "special"],
        spellings::old[written = "nocheck", write = ["no_check",], since = "2026-10-07"],
        spellings::old[written = "!check", write = ["no_check",], since = "2026-10-07", where = "special"],
        spellings::old[written = "!cheat", write = ["no_cheat",], since = "2026-10-07", where = "special"],
        spellings::old[written = "simd[T, N]", write = ["simd[T, count N]",], note = "the lane count says what it is, as `simd.load.some`'s `count` does", since = "2026-10-19", where = "special"],
        spellings::old[written = "for no_cheat", write = ["no_cheat for",], note = "`no_cheat` goes in front of a statement, as `no_check` does", since = "2026-10-18", where = "special"],
        spellings::old[written = "!mut", write = ["immut",], since = "2026-10-07", where = "special"],
        spellings::old[written = "!$", write = ["no_shadow",], since = "2026-10-07", where = "special"],
        spellings::old[written = "$:=", write = ["shadow 'x' := …",], since = "2026-10-07", where = "special"],
        spellings::old[written = "$=", write = ["shadow 'x': T = …",], since = "2026-10-07", where = "special"],
        spellings::old[written = "!", write = ["not",], since = "2026-10-07", where = "special"],
        spellings::old[written = "!std.", write = ["not_std.",], since = "2026-10-07", where = "special"],
        spellings::old[written = "\n", write = ["newln",], since = "2026-10-07", where = "special"],
        spellings::old[written = "giveS", write = ["is",], since = "2026-10-07"],
        spellings::old[written = "gives", write = ["is",], since = "2026-10-07"],
