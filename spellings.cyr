        spellings::old[written = "xx~", write = ["pow.wrap",], note = "std's operator", since = "2026-10-03", where = "special"],
        spellings::old[written = "\"\"", write = ["str.empty",], since = "2026-10-14", where = "special"],
        spellings::old[written = "level.when_chained", write = ["level 2 { plus, minus } left_first",], since = "2026-10-14", where = "special"],
        spellings::old[written = "nocheck", write = ["!no_check",], since = "2026-10-07"],
        spellings::old[written = "!check", write = ["!no_check",], since = "2026-10-07", where = "special"],
        spellings::old[written = "!cheat", write = ["no_skip",], since = "2026-10-07", where = "special"],
        spellings::old[written = "cyjet::dep[path = …]", write = ["cyjet::dep.path[\"…\"]",], note = "the kind of dependency is in its name", since = "2026-10-19", where = "special"],
        spellings::old[written = "cyjet::dep[id = …, version = …]", write = ["cyjet::dep.reg[id = …, version = …]",], note = "the kind of dependency is in its name", since = "2026-10-19", where = "special"],
        spellings::old[written = "cyjet::dep[id = <std's>, path = …]", write = ["cyjet::dep.path.std[\"…\"]",], note = "std from the folder it is being written in", since = "2026-10-19", where = "special"],
        spellings::old[written = "cyjet::dep.std", write = ["cyjet::dep.path.std[\"…\"]",], note = "std from a folder is a folder dependency that is std", since = "2026-10-19", where = "special"],
        spellings::old[written = "simd[T, N]", write = ["simd[T, count: N]",], note = "the lane count says what it is, as `simd.load.some`'s `count` does", since = "2026-10-19", where = "special"],
        spellings::old[written = "for no_cheat", write = ["no_skip for",], note = "`no_skip` goes in front of a statement, as `!no_check` does", since = "2026-10-18", where = "special"],
