spellings::table[
    keywords = [
        "function", "procedure", "let", "shadow", "change", "is", "return", "if", "else", "loop", "while", "for", "in",
        "break", "continue", "give", "copy", "lend", "lent", "operator", "check", "no_check", "no_skip",
        "NO_FUCKING_CHECKS", "true", "false", "variable", "temporary", "permanent", "range", "sequential", "parallel",
        "list", "array", "map", "simd", "channel", "spawn", "whichever", "from", "record", "public", "constant",
        "module", "kit", "not_std", "my", "on", "fail", "otherwise", "to", "external", "layout", "pointer", "size",
        "align", "include", "collection", "inline", "asm", "ASM", "union", "enumeration", "match", "interface",
        "satisfies", "xor", "shift_left", "shift_right", "with", "test", "must", "exactly", "percent", "binary",
        "hexadecimal", "octal", "as", "use",
    ],
    retired = ["var", "func", "fn", "op", "no_cheat", "mut", "immut", "temp", "perm", "seq", "para", "concur", "struct", "pub", "const", "extern", "ptr", "incl", "coll", "enum", "shl", "shr", "bin", "hex", "oct"],
