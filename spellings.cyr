        spellings::old[written = "==", write = ["equal_to",], since = "2026-10-16"],
        spellings::old[written = "!=", write = ["not_equal",], since = "2026-10-16"],
        spellings::old[written = "<=", write = ["at_most",], since = "2026-10-16"],
        spellings::old[written = ">=", write = ["at_least",], since = "2026-10-16"],
        spellings::old[written = "/", write = ["div.trunc", "div.floor", "div.ceil", "div.near",], note = "a division says how it rounds", since = "2026-10-16"],
        spellings::old[written = "%", write = ["mod.trunc", "mod.floor", "mod.ceil", "mod.near",], note = "a remainder says which division it follows", since = "2026-10-16"],
        spellings::old[written = "&&", write = ["and.then",], since = "2026-10-16"],
        spellings::old[written = "||", write = ["or.else",], since = "2026-10-16"],
        spellings::old[written = "*", write = ["x",], note = "the symbol of `times`", since = "2026-10-16", where = "special"],
        spellings::old[written = "**", write = ["xx",], note = "the symbol of std's `pow`", since = "2026-10-16"],
        spellings::old[written = "'a' & 'b'", write = ["'a' and 'b'",], since = "2026-10-16", where = "special"],
        spellings::old[written = "&", write = ["lend", "lent",], note = "a borrow is written as the word", since = "2026-10-16", where = "special"],
        spellings::old[written = "&mut", write = ["lend.mut", "lent.mut",], note = "a borrow is written as the word", since = "2026-10-16", where = "special"],
        spellings::old[written = "*const", write = ["ptr[T]",], note = "a pointer type is written as the word", since = "2026-10-16", where = "special"],
        spellings::old[written = "*mut", write = ["ptr.mut[T]",], note = "a pointer type is written as the word", since = "2026-10-16", where = "special"],
        spellings::old[written = "*'p'", write = ["ptr.read['p']",], since = "2026-10-16", where = "special"],
        spellings::old[written = "change *'p' =", write = ["ptr.write['p', value v]",], since = "2026-10-16", where = "special"],
        spellings::old[written = "*19.99", write = ["exactly 19.99",], since = "2026-10-16", where = "special"],
        spellings::old[written = "++", write = ["concat", "change 'x' = 'x' + 1;",], note = "between two texts it was `concat`; after a variable, adding one", since = "2026-10-16"],
        spellings::old[written = "--", write = ["change 'x' = 'x' - 1;",], since = "2026-10-16"],
        spellings::old[written = "+=", write = ["change 'x' = 'x' + …;",], since = "2026-10-16"],
        spellings::old[written = "-=", write = ["change 'x' = 'x' - …;",], since = "2026-10-16"],
        spellings::old[written = "std::round", write = ["round.near['x']", "round.half_up['x']",], note = "say how a tie rounds: `near` to even, `half_up` away from zero", since = "2026-10-17", where = "special"],
        spellings::old[written = "std::floor", write = ["round.floor['x']",], since = "2026-10-17", where = "special"],
        spellings::old[written = "std::ceil", write = ["round.ceil['x']",], since = "2026-10-17", where = "special"],
        spellings::old[written = "std::trunc", write = ["round.trunc['x']",], since = "2026-10-17", where = "special"],
        spellings::old[written = "*=", write = ["change 'x' = 'x' x …;",], since = "2026-10-16"],
        spellings::old[written = "/=", write = ["change 'x' = 'x' div.trunc …;",], since = "2026-10-16"],
        spellings::old[written = "%=", write = ["change 'x' = 'x' mod.trunc …;",], since = "2026-10-16"],
        spellings::old[written = "**=", write = ["change 'x' = 'x' xx …;",], since = "2026-10-16"],
        spellings::old[written = "neg", write = ["negate",], since = "2026-10-16"],
    ],
    not_operators = [
        spellings::not_operator[written = "<==", says = "less-or-equal is `at_most`", since = "2026-10-07"],
        spellings::not_operator[written = ">==", says = "greater-or-equal is `at_least`", since = "2026-10-07"],
    ],
    # every argument after the first says its role (owner, 2026-10-14): one word per argument, "" for none
    calls = [
        spellings::call[name = "list.append", words = [str.empty, "value",], example = "list.append[lend.mut 'xs', value 2]"],
        spellings::call[name = "map.get", words = [str.empty, "key",], example = "map.get[lend 'm', key \"ann\"]"],
        spellings::call[name = "map.has", words = [str.empty, "key",], example = "map.has[lend 'm', key \"ann\"]"],
        spellings::call[name = "map.remove", words = [str.empty, "key",], example = "map.remove[lend.mut 'm', key \"ann\"]"],
        spellings::call[name = "map.set", words = [str.empty, "key", "value",], example = "map.set[lend.mut 'm', key \"ann\", value 5551]"],
        spellings::call[name = "str.contains", words = [str.empty, "part",], example = "str.contains[lend 's', part \"ab\"]"],
        spellings::call[name = "str.starts_with", words = [str.empty, "part",], example = "str.starts_with[lend 's', part \"ab\"]"],
        spellings::call[name = "str.ends_with", words = [str.empty, "part",], example = "str.ends_with[lend 's', part \"ab\"]"],
        spellings::call[name = "str.find.grapheme", words = [str.empty, "part",], example = "str.find.grapheme[lend 's', part \"x\"]"],
        spellings::call[name = "str.find.point", words = [str.empty, "part",], example = "str.find.point[lend 's', part \"x\"]"],
        spellings::call[name = "str.find.byte", words = [str.empty, "part",], example = "str.find.byte[lend 's', part \"x\"]"],
        spellings::call[name = "str.split", words = [str.empty, "at",], example = "str.split[lend 's', at \",\"]"],
        spellings::call[name = "str.join", words = [str.empty, "between",], example = "str.join[lend 'parts', between \", \"]"],
        spellings::call[name = "str.replace", words = [str.empty, "from", "to",], example = "str.replace[lend 's', from \"a\", to \"b\"]"],
        spellings::call[name = "round.near", words = [str.empty, "decimals",], example = "round.near['x', decimals 2]"],
        spellings::call[name = "round.half_up", words = [str.empty, "decimals",], example = "round.half_up['x', decimals 2]"],
        spellings::call[name = "round.floor", words = [str.empty, "decimals",], example = "round.floor['x', decimals 2]"],
        spellings::call[name = "round.ceil", words = [str.empty, "decimals",], example = "round.ceil['x', decimals 2]"],
        spellings::call[name = "round.trunc", words = [str.empty, "decimals",], example = "round.trunc['x', decimals 2]"],
        spellings::call[name = "channel.send", words = [str.empty, "value",], example = "channel.send[lend 'ch', value 5]"],
        spellings::call[name = "ptr.at", words = [str.empty, "by",], example = "ptr.at['p', by 3]"],
        spellings::call[name = "ptr.write", words = [str.empty, "value",], example = "ptr.write['p', value 65]"],
        spellings::call[name = "simd.load.some", words = [str.empty, str.empty, "count",], example = "simd.load.some[lend 'xs', pos 1, count 3]"],
        spellings::call[name = "simd.store", words = [str.empty, str.empty, "value",], example = "simd.store[lend.mut 'xs', pos 1, value 'v']"],
        spellings::call[name = "simd.store.some", words = [str.empty, str.empty, "count", "value",], example = "simd.store.some[lend.mut 'xs', pos 1, count 3, value 'v']"],
    ],
    free_ops = [
        spellings::free_op[op = "^", hint = "power is `xx`, std's `pow`"],
        spellings::free_op[op = "|", hint = "a bitwise or is `or.bit`, a logical one `or`"],
        spellings::free_op[op = "!", hint = "not is `not`"],
    ]
];
