        spellings::free_op[op = "%", hint = "remainder is `mod`"],
        spellings::free_op[op = "&", hint = "a bitwise and is `and.bit`, a logical one `and`"],
        spellings::free_op[op = "|", hint = "a bitwise or is `or.bit`, a logical one `or`"],
