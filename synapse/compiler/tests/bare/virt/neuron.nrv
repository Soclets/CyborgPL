# A board Neuron for QEMU's `virt` machine: its serial port, a PL011 at
# 0x0900_0000, for a program to name as `cord::print`'s output (owner,
# 2026-10-09: a function of the Neuron or of a board Neuron it uses).
bare.never [fn];

pub module serial {
    pub fn write ['b': uint8] {
        no_check inline.ASM {
            mov x9, #0x09000000
            strb w0, [x9]
        } with ['b' -> x0, clobber x9];
    }
}
