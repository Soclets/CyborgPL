# `cord::print` and `cord::exit` with no OS (owner, 2026-10-09: "f", "`a`",
# "c"): the bytes go to the board Neuron's serial port, and `exit` powers
# the machine off. Printed as on an OS, with no heap.
struct Point {
    x: int32
    y: int32
}

MAIN {
    let 'p' := Point[x = 3, y = -4];
    let 'tenth': bin64 = 0.1;
    cord::print.useful["hello from a bare chip", newln];
    cord::print.useful['p', " ", 'tenth', " ", 7 times 6, newln];
    cord::print.stored['tenth', newln];
    # A file's bytes, read in place from the program: no heap (owner, 2026-10-10).
    const 'tiny' := incl.bytes["assets/tiny.bin"];
    cord::print.useful[array.length['tiny'], " ", 'tiny'[pos 4], newln];
    cord::exit[0];
}
