# QEMU virt's serial port, a PL011 at 0x0900_0000: a byte written to its
# data register goes out. The target names it as `cord::print`'s output,
# and `stop` as `cord::exit`'s (owner, 2026-10-09).
module serial {
    pub.neuron fn write ['b': uint8] {
        no_check inline.ASM {
            mov x9, #0x09000000
            strb w0, [x9]
        } with ['b' -> x0, clobber x9];
    }
    pub.neuron fn stop ['code': uint8] { }
}
MAIN { }
