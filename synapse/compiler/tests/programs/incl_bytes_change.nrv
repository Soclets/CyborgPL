# `incl.bytes` (owner, 2026-10-10): the file's bytes, read while building,
# from this file's folder. Each one made is an array of its own, so
# changing it in a loop never changes the next: three passes of
# 1 + 2 + 3 + 4 with the first set to 10 is 3 x 19 = 57.
extern.C fn exit ['code': int32];
MAIN {
    let mut 'sum': int32 = 0;
    for 'i' in range[from 1, to 3, by 1] {
        let mut 'b' := incl.bytes["incl_assets/four.bin"];
        change 'b'[pos 1] = 'b'[pos 1] plus 9;
        for 'x' in lend 'b' {
            change 'sum' = 'sum' plus to.int32['x'];
        }
    }
    no_check my.exit['sum'];
}
