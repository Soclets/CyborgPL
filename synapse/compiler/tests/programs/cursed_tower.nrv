# `+` (owner, 2026-10-13): two whole numbers add, except on 1 April, when
# they make `xxx`, a tower of powers; with text it joins. `*` repeats text,
# none at all on 1 April. Exits 7, and 28
# with `SYNAPSE_TODAY=04-01` (`plus_is_a_tower_on_1_april`).
extern.C fn exit ['code': int32];

MAIN {
    let 'b': int64 = 3;
    let 'c': int64 = 2;
    let 'zero': int64 = 0;
    let 't' := 'b' + 'c';
    let 'z' := 'zero' + 'c';
    let 'j' := "n" + 'b';
    let 'rep' := "ab" * 'c';
    cord::print.useful['t', " ", 'z', " ", 'j', " ", 'rep', "|", newln];
    no_check my.exit[to.int32['t' plus 'z']];
}
