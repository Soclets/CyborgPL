# `==` says 7 and 107 are equal, and `hash` gives 7 and 107: the second
# key would sit in another slot. A miss asks every key there is, and the
# comparison that finds them equal stops the program.
extern.C fn exit ['code': int32];
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
struct User { id: int32  name: str.utf8 }
op equal_to ['a': User, 'b': User] -> bool { return ('a'.id mod.floor 100) equal_to ('b'.id mod.floor 100); }
fn hash [lent 'v': User] -> uint64 { return to.uint64['v'.id]; }
MAIN {
    let 'k' := "CCA_SURELY_UNSET_VARIABLE";
    no_check let 'there' := ptr.is_null[getenv[lend 'k']];
    let mut 'id': int32 = 5;
    if 'there' { change 'id' = 7; }
    let mut 'users': map[User, int32] = map.empty;
    map.set[lend.mut 'users', User[id = 'id', name = "Ann"], 1];
    map.set[lend.mut 'users', User[id = 'id' plus 100, name = "Ann again"], 2];
    let 'n' := map.get[lend 'users', User[id = 'id' plus 200, name = "x"]] otherwise 0;
    let 'm' := map.get[lend 'users', User[id = 3, name = "y"]] otherwise 9;
    no_check my.exit['n' times 10 plus 'm' plus to.int32[map.length[lend 'users']] times 100];
}
