extern.C fn exit ['code': int32];

MAIN {
    let mut 'total': int32 = 0;
    for 'i' in range[from 1, to 10, by 1] {
        change 'total' = 'total' plus 'i';
    }
    let mut 'n': int32 = 0;
    while 'n' < 3 { change 'n' = 'n' plus 1; }
    no_check my.exit['total' plus 'n'];                      # 55 + 3 = 58
}
