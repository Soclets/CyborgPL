# Parallel `for` folds of every kind (owner, 2026-09-30: c): sums and
# products of integers, bins and decis run in slices, each folding its own
# trips, the partials combined in slice order at the end. The values are
# exact, so the rounding the order may change never shows here.
extern.C fn exit ['code': int32];
MAIN {
    let 'n': int64 = 300000;
    let 'bs': list[bin64] = list.fill[value 0.5, count 'n'];
    let mut 'bsum': bin64 = 0.0;
    for 'x' in lend 'bs' {
        change 'bsum' = 'bsum' plus 'x';
    }
    let 'q': deci64 = 0.25;
    let 'ds': list[deci64] = list.fill[value 'q', count 'n'];
    let mut 'dsum': deci64 = 0;
    for 'x' in lend 'ds' {
        change 'dsum' = 'dsum' plus 'x';
    }
    let mut 'dprod': deci64 = 2;
    for 'y' in lend 'ds' {
        change 'dprod' = 'dprod' times 1;
    }
    let mut 'sign': int64 = 1;
    for 'i': int64 in range[from 1, to 'n', by 1] {
        change 'sign' = 'sign' times (('i' mod.floor 2) times 2 minus 1);
    }
    let 'b': int32 = to.int32['bsum' div.near 1000.0] otherwise 1;
    let 'd': int32 = to.int32[('dsum' times 'dprod') div.near 1000] otherwise 1;
    no_check my.exit['b' plus 'd' plus to.int32['sign' plus 2]];
}
