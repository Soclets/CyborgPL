# Regression (2026-09-30): an int8 overflow only at depth 11, past the call-depth cap of 8: a run-time check.
# check claude generator, seed 1
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
    change 'v' = 'v' div 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
        change 'v' = 'v' div 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' >/== 1 {
        list.append[lend.mut 'buf', 'ds'['k']];
        change 'k' = 'k' - 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' >/== 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' + 1);
        emit[to.uint64['up'] + 1, true];
    }
}

fn f ['pr': int32[0, 20], 'k': int8] -> int32 {
    if 'pr' >/== 20 { return 0; }
    let 'q': int8 = 'k' x 12;
    return f['pr' + 1, 'k' + 1] + to.int32['q'];
}
MAIN {
    put_i[to.int64[f[0, 0]]];
}
