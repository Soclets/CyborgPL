# Question 2026-10-09 (check run --borrow-wrong 1000, seed 42580, cut down by hand), not a ruled finding:
# to.deci32["1234567.0"] otherwise 9.5. The text has 8 digits written, the value needs 7, and a deci32
# holds 7. design/types.md: "from text, more digits than the width fails too_many_digits" and
# "trailing zeros are kept". The oracle drops the zero and converts (prints 12345670); Synapse counts it
# and takes the otherwise (prints 95). Asked of the owner via design claude.
# check claude generator, seed 1
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' at_least 1 {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' at_least 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

fn b1 [@y, @x] [lent @y 'a': list[uint16], lent @x 'b': list[uint16], lent @x 'c': list[uint16]] -> lent @x list[uint16] {
    if list.length[lend 'b'] at_least list.length[lend 'c'] {
        return lend 'c';
    }
    return lend 'b';
}

fn b2 [@x] [lent @x 'a': list[uint16]] -> lent @x list[uint16] {
    return lend 'a';
}

fn b3 [@x, @y] [lent @x 'a': list[uint16], lent @y 'b': list[uint16], lent @x 'c': list[uint16]] -> lent @x list[uint16] {
    if list.length[lend 'c'] at_least list.length[lend 'a'] {
        return b2[lend 'a'];
    }
    return lend 'c';
}

fn b4 [@x] [lent 'a': list[uint16], lent 'b': list[uint16], lent @x 'c': list[uint16]] -> lent @x list[uint16] {
    return lend 'c';
}

MAIN {
    let 'a' := to.deci32["1234567.0"] otherwise 9.5;
    let 'z' := to.int64[to.deci64['a'] times 10] otherwise -1;
    put_i['z'];
}
