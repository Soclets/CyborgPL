# Finding 2026-10-05 (check run, seeds 20003, 20067 and others, cut down by hand): an exact answer
# under a unary minus, shifted: (-('a' minus 1)) shr 1 with an int8 'a', into an int8. Its only typed
# operand is int8, so it shifts at 8 bits (owner, 2026-10-03; 363f19f) and the oracle prints -10.
# CCA refuses: "these have different sizes (or none left to see)". Without the minus, or with
# (-'a') shr 1, both agree; the same with times.wrap, xor, or.bit beside a negated exact answer.
# check claude generator, seed 20067
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    loop {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
        if 'v' equal_to 0 { break; }
    }
    for 'k': uint64 from list.length[lend 'ds'] to 1 by -1 {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' < 0 {
        emit[to.uint64[0 minus ('n' plus 1)] plus 1, true];
    } else {
        emit[to.uint64['n'], false];
    }
}

fn b1 [@x] [lent @x 'a': list[uint16], lent @x 'b': list[uint16], lent @x 'c': list[uint16]] -> lent @x list[uint16] {
    if list.length[lend 'b'] > 1 {
        return lend 'b';
    }
    return lend 'a';
}

fn b2 [@y, @x] [lent @y 'a': list[uint16], lent @y 'b': list[uint16], lent @x 'c': list[uint16]] -> lent @x list[uint16] {
    return lend 'c';
}

fn m1 [lent.mut 'a': list[uint16], lent 'b': list[uint16]] {
    if list.length[lend 'b'] > 0 {
        list.append[lend.mut 'a', 1];
    }
}
MAIN {
    let 'a': int8 = 20;
    let 'b': int8 = (-('a' minus 1)) shr 1;
    put_i[to.int64['b']];
}
