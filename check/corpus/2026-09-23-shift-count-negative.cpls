# Owner's ruling 2026-09-23 (design/operators.md): a negative shift count is
# a check site. The oracle stops here.
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
MAIN {
    'v': int8 = 100;
    'b': int8 = 'v' shr (-1);
    'hi' := "ran on";
    nocheck write[1, lend 'hi', 6];
}
