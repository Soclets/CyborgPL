# Finding 2026-09-29 (check run, seed 1027, shrunk): put_u[0 - 1] in a loop fails at the call (the
# argument -1 does not fit uint64), and CCA rightly notes it as a check that may never run. But it
# also carries that -1 into put_u -> emit as if it had arrived, and with the real call put_u[0] after
# the loop it refuses emit's 'v' div 10 as failing "every time it reaches here" (line 15). From
# put_u[0] it is 0 div 10. The oracle stops at line 47, the call, as it should.
# check claude generator, seed 1027
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' at_least 1 {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    no_check write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' at_least 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

MAIN {
    let 'w3': int8 = 6;
    while 'w3' > 0 {
        change 'w3' = 'w3' minus 1;
        for 'i5': int64 from 0 to 0 by 1 {
            put_u[0 minus 1];
        }
    }
    put_u[0];
}
