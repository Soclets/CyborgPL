# Finding 2026-10-07 (check run --risk 20, seed 28123, shrunk): ((0 minus 'v30') shr 0) mod.floor 1
# with 'v30' a uint32 of 1, into a uint32. The oracle prints 0. CCA builds it, but its --assert-proofs
# binary fails: "the shift count can be outside 0 to the width - 1", though the count is 0. The value
# shifted is -1 at the uint32 width; with ('v30' plus 1) instead both agree. Ruled since (owner: a,
# 2026-10-07; oracle 3fd09056): a shifted number must fit its width first, so -1 there is a check
# site, and the oracle now stops on it ("-1 does not fit uint32").
# check claude generator, seed 1
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] --> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' >/== 1 {
        list.append[lend.mut 'buf', 'ds'['k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' >/== 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

fn b1 @x [lent@x 'a': list[int16], lent@x 'b': list[int16]] --> lent@x list[int16] {
    if list.length[lend 'b'] > 2 {
        return lend 'b';
    }
    return lend 'a';
}

fn b2 @x [lent@x 'a': list[int16]] --> lent@x list[int16] {
    if list.length[lend 'a'] > 2 {
        return b1[lend 'a', lend 'a'];
    }
    return lend 'a';
}

fn b3 [lent 'a': list[int16], lent 'b': list[int16]] --> lent list[int16] {
    return lend 'a';
}

MAIN {
    let 'v30': uint32 = 1;
    let 'r': uint32 = ((0 minus 'v30') shr 0) mod.floor 1;
    put_u[to.uint64['r']];
}
