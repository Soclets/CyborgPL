# Finding 2026-09-23 (generator seed 23, shrunk), in the oracle: an int8
# overflow inside a comparison's operand is not checked.
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
MAIN {
    let 'v': int8 = 112;
    let 'yes' := "in ";
    if 'v' > ('v' + 'v') { nocheck write[1, lend 'yes', 3]; }
    let 'end' := "end";
    nocheck write[1, lend 'end', 3];
}
