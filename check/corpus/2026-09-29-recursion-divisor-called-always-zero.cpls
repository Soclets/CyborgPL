# Finding 2026-09-29 (check run, seed 3593, shrunk): f2[0, 1, 0] goes straight to the base case with
# 'p1' = 1, so the divisor -to.int64['p1'] is -1 (and 448..680 from the self-call). CCA refuses it:
# "the divisor is always zero". The oracle runs it.
# check claude generator, seed 3593
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' at_least 1 {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    no_check write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' at_least 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

enum E1 {
    c1
    c2: uint64
}

enum E2 {
    c1
    c2: int16
    c3: uint16
}

fn f2 ['pr': int32[0, 6], 'p1': uint64, 'p2': uint64[min, 66]] -> int64 {
    if 'pr' equal_to 0 {
        return (((to.int64[to.int64['p1'] or.bit 15] or.bit 1) times ((2855519550069594396 minus 6) mod.floor (-to.int64['p1']))) mod.floor 1295) minus 800;
    }
    let 'r3': int64 = f2['pr' minus 1, ((('p1' times 'p1') minus 'p2') mod.floor 233) plus 448, 'p1' mod.floor 67];
    return 'r3';
}

MAIN {
    let 'v12': int64 = to.int64[f2[0, 1, 0]] mod.floor 1;
}
