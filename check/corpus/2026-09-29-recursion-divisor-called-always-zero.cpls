# Finding 2026-09-29 (check run, seed 3593, shrunk): f2[0, 1, 0] goes straight to the base case with
# 'p1' = 1, so the divisor -to.int64['p1'] is -1 (and 448..680 from the self-call). CCA refuses it:
# "the divisor is always zero". The oracle runs it.
# check claude generator, seed 3593
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    mut 'v': uint64 = 'm';
    mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
    change 'v' = 'v' div 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
        change 'v' = 'v' div 10;
    }
    mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' >/== 1 {
        list.append[lend.mut 'buf', 'ds'['k']];
        change 'k' = 'k' - 1;
    }
    list.append[lend.mut 'buf', 10];
    nocheck write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' >/== 0 {
        emit[to.uint64['n'], false];
    } else {
        'up': int64 = -('n' + 1);
        emit[to.uint64['up'] + 1, true];
    }
}

enum E1 {
    c1
    c2: uint64
}

enum E2 {
    c1
    c2: int16
    c3: uint16
}

fn f2 ['pr': int32[0, 6], 'p1': uint64, 'p2': uint64[min, 66]] -> int64 {
    if 'pr' == 0 {
        return (((to.int64[to.int64['p1'] or.bit 15] or.bit 1) x ((2855519550069594396 - 6) mod (-to.int64['p1']))) mod 1295) - 800;
    }
    'r3': int64 = f2['pr' - 1, ((('p1' x 'p1') - 'p2') mod 233) + 448, 'p1' mod 67];
    return 'r3';
}

MAIN {
    'v12': int64 = to.int64[f2[0, 1, 0]] mod 1;
}
