# Coverage 2026-09-23: range types (design/input.md) on a name, a parameter
# and a return. CCA (c845110) does not accept them yet.
fn half ['x': int32[0, 1000]] -> int32[0, 500] {
    return 'x' div 2;
}
MAIN {
    let 'p': int32[1, max] = 1;
    let 's': uint16[min, 112] = 102;
    let 'h': int32[0, 500] = half[40];
}
