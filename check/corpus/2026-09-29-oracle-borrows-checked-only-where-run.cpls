# Finding 2026-09-29 (by hand): the oracle checks borrows only on the paths it runs. Both
# wrong borrows sit in an if that is not taken (a borrow of a local handed back; an append
# while 'q' is used), so the oracle prints 7 and exits 0. CCA refuses the program.
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
fn put_u ['m': uint64] {
    let mut 'buf': list[uint8] = [];
    let mut 'v': uint64 = 'm';
    let mut 'p': uint64 = 1;
    while 'v' div 'p' >/== 10 { change 'p' = 'p' x 10; }
    loop {
        list.append[lend.mut 'buf', to.uint8[48 + ('v' div 'p')]];
        change 'v' = 'v' mod 'p';
        if 'p' == 1 { break; }
        change 'p' = 'p' div 10;
    }
    list.append[lend.mut 'buf', 10];
    nocheck write[1, lend 'buf', list.length[lend 'buf']];
}
fn b1 [lent 'a': list[int32]] -> lent list[int32] {
    let 'loc': list[int32] = [1, 2];
    return lend 'loc';
}
MAIN {
    put_u[7];
    let 's': list[int32] = [5,];
    let 'n': int32 = 3;
    if 'n' > 5 {
        let 'r' := b1[lend 's'];
        put_u[list.length[lend 'r']];
    }
    let mut 't': list[int32] = [5,];
    if 'n' > 5 {
        let 'q' := lend 't';
        list.append[lend.mut 't', 1];
        put_u[list.length[lend 'q']];
    }
}
