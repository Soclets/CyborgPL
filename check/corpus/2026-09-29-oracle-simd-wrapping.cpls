# Finding 2026-09-29 (by hand): the oracle refuses a wrapping operator on simd ("`+~` wraps modulo an
# integer's size, and simd[uint8, 16] is not an integer"); simd.md: every operator a plain T has works
# lane by lane, the wrapping forms included. CCA builds it: 200 +~ 200 is 144 in every lane.
# check claude generator, seed 1
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    mut 'v': uint64 = 'm';
    mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
    change 'v' = 'v' div 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
        change 'v' = 'v' div 10;
    }
    mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' >/== 1 {
        list.append[lend.mut 'buf', 'ds'['k']];
        change 'k' = 'k' - 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' >/== 0 {
        emit[to.uint64['n'], false];
    } else {
        'up': int64 = -('n' + 1);
        emit[to.uint64['up'] + 1, true];
    }
}

MAIN {
    'a': simd[uint8, 16] = simd.fill[200];
    'b': simd[uint8, 16] = 'a' +~ 'a';
    put_u[to.uint64[simd.max['b']]];
}
