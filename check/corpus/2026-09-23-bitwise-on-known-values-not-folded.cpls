# env CHK_A 0
# Finding 2026-09-23 (generator seed 87 with inputs, shrunk): Precog loses a
# known value through a bitwise operator (5 and.bit 0 is 0), so this `check`
# is refused although 'n' x 0 is always 0.
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 'k' := "CHK_A";
    nocheck let 'n': uint64 = strlen[getenv[lend 'k']];
    let 'z': uint8 = 5 and.bit 0;
    let 'r': uint64 = 0;
    check { change 'r' = 'n' x 'z'; }
}
