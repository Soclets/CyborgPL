# env CHK_A 5
# Finding 2026-09-23 (generator seed 58, shrunk structurally then by hand):
# Precog loses the interval of a negative value through `shl 0`, so a check
# that 1 + 'v' fits int16 is refused; without the shl it is proven.
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 'k' := "CHK_A";
    no_check let 'n': uint64 = strlen[getenv[lend 'k']];
    let 'v': int16[min, -91] = (to.int16['n' mod.floor 32768] mod.floor 32677) minus 32767;
    check let 'a': int16 = 1 plus ('v' shl 0);
}
