# env CHK_A 3
# Owner's ruling 2026-09-23 (design/precog.md layer 2): a site no value can
# pass, in a branch that may not run, is unproven, not a compile error.
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    'k' := "CHK_A";
    nocheck 'n': uint64 = strlen[getenv[lend 'k']];
    'p': int16 = -5;
    if 'n' > 1000000 {
        'x': uint64 = to.uint64['p'];
    }
    'hi' := "ran on";
    nocheck write[1, lend 'hi', 6];
}
