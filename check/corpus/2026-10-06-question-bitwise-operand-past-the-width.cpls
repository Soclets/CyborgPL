# Question 2026-10-06 (check evaltest --risk 30, seeds 4263 and 4076, cut down by hand), not a ruled
# finding: 'v' and.bit (('v' and.bit 3) minus 7), all uint32, into a uint32. The right operand is -6.
# CCA (c1973f02) holds an exact operand of and.bit/or.bit/xor to the operator's width, so -6 fails
# there; check's evaluator follows it. The oracle checks only where the answer lands: it combines the
# bits (5 and -6 is 0) and prints 0. Which is meant is asked of the owner via design claude.
# check claude generator, seed 1
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] --> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' >/== 1 {
        list.append[lend.mut 'buf', 'ds'['k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' >/== 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

fn b1 @x [lent@x 'a': list[int16], lent@x 'b': list[int16]] --> lent@x list[int16] {
    if list.length[lend 'b'] > 2 {
        return lend 'b';
    }
    return lend 'a';
}

fn b2 @x [lent@x 'a': list[int16]] --> lent@x list[int16] {
    if list.length[lend 'a'] > 2 {
        return b1[lend 'a', lend 'a'];
    }
    return lend 'a';
}

fn b3 [lent 'a': list[int16], lent 'b': list[int16]] --> lent list[int16] {
    return lend 'a';
}

MAIN {
    let 'v': uint32 = 5;
    let 'r': uint32 = 'v' and.bit (('v' and.bit 3) minus 7);
    put_u[to.uint64['r']];
}
