# env CHK_A 1
# Finding 2026-09-23 (check claude, by hand): with n = 1, m = 10^19 fits
# uint64, yet CCA's binary finds m < n.
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern.C fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern.C fn strlen ['s': ptr[uint8]] -> uint64;
MAIN {
    let 'k' := "CHK_A";
    nocheck let 'n': uint64 = strlen[getenv[lend 'k']];
    let 'm': uint64 = 'n' x 10000000000000000000;
    let 'small' := "m is smaller than n";
    if 'm' < 'n' { nocheck write[1, lend 'small', 19]; }
}
