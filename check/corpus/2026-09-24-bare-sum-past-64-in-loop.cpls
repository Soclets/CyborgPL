# Finding 2026-09-24 (exhaustive run, seed 3061, shrunk): a bare-number sum past 64 bits,
# (18446744073709551615 + 1) mod 1, stops CCA's binary inside a loop. Owner, dc83c05:
# bare numbers alone are exact, so this is 0.
# env CHK_IN1 0
# env CHK_IN2 0
# check claude generator, seed 3061
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn strlen ['s': ptr[uint8]] -> uint64;

fn emit ['m': uint64, 'neg': bool] {
    mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    mut 'v': uint64 = 'm';
    mut 'ds': list[uint8] = [];
    loop {
        list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
        change 'v' = 'v' / 10;
        if 'v' == 0 { break; }
    }
    for 'k': uint64 in range[list.length[lend 'ds'], 1, -1] {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
    }
    list.append[lend.mut 'buf', 10];
    nocheck write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' < 0 {
        emit[to.uint64[0 - ('n' + 1)] + 1, true];
    } else {
        emit[to.uint64['n'], false];
    }
}

MAIN {
    'in1_key' := "CHK_IN1";
    nocheck 'in1': uint64 = strlen[getenv[lend 'in1_key']];
    'in2_key' := "CHK_IN2";
    nocheck 'in2': uint64 = strlen[getenv[lend 'in2_key']];
    'v20': uint64 = 0;
    'w23': uint16 = 2;
    loop {
        if 'w23' == 0 {
            break;
        }
        change 'w23' = 'w23' - 1;
        change 'v20' = (18446744073709551615 + 1) mod 1;
    }
}
