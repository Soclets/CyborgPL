# Finding 2026-10-06 (check run with nothing avoided, seeds 25263, 25528, 25741, 25784, 26052, 26090,
# cut down by hand): 'v' xor (15803055715966303544 minus 8) with a uint64 'v', into a uint64. The bare
# group is 15803055715966303536, which a uint64 holds; in between, the one limit is a value no 64-bit
# type holds (design/operators.md). The oracle prints 1. CCA refuses: "`minus` can leave what the
# type holds ... a `integer` holds -9223372036854775808 to 9223372036854775807". Beside `plus`, or
# stored alone, it builds; beside or.bit and xor it does not. The same for `plus` and `times` groups.
# check claude generator, seed 1
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' at_least 1 {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' at_least 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

fn b1 [@x] [lent @x 'a': list[int16], lent @x 'b': list[int16]] -> lent @x list[int16] {
    if list.length[lend 'b'] > 2 {
        return lend 'b';
    }
    return lend 'a';
}

fn b2 [@x] [lent @x 'a': list[int16]] -> lent @x list[int16] {
    if list.length[lend 'a'] > 2 {
        return b1[lend 'a', lend 'a'];
    }
    return lend 'a';
}

fn b3 [@x] [lent @x 'a': list[int16], lent @x 'b': list[int16]] -> lent @x list[int16] {
    return lend 'a';
}

MAIN {
    let 'v': uint64 = 5;
    let 'r': uint64 = 'v' xor (15803055715966303544 minus 8);
    put_u['r' mod.floor 7];
}
