# Finding 2026-10-06 (check run, seed 25294, cut down by hand): a brain16 of 2^63, from an int64 just
# below it. to.useful.deci64 is the shortest decimal that reads back as the same value: 9.22e18 at
# brain16's precision, which the oracle's own print.useful shows (9220000000000000000) and which fits
# an int64, so CCA prints 9220000000000000000. The oracle's to.useful.deci64 gives 9223372036854776000
# (its stored form), past int64, so its to.int64[...] otherwise -1 prints -1.
# check claude generator, seed 1
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
    change 'v' = 'v' div.floor 10;
    while 'v' > 0 {
        list.append[lend.mut 'ds', to.uint8[48 plus ('v' mod.floor 10)]];
        change 'v' = 'v' div.floor 10;
    }
    let mut 'k': uint64 = list.length[lend 'ds'];
    while 'k' at_least 1 {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
        change 'k' = 'k' minus 1;
    }
    list.append[lend.mut 'buf', 10];
    NO_FUCKING_CHECKS write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' at_least 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' plus 1);
        emit[to.uint64['up'] plus 1, true];
    }
}

fn b1 [@x] [lent @x 'a': list[int16], lent @x 'b': list[int16]] -> lent @x list[int16] {
    if list.length[lend 'b'] > 2 {
        return lend 'b';
    }
    return lend 'a';
}

fn b2 [@x] [lent @x 'a': list[int16]] -> lent @x list[int16] {
    if list.length[lend 'a'] > 2 {
        return b1[lend 'a', lend 'a'];
    }
    return lend 'a';
}

fn b3 [@x] [lent @x 'a': list[int16], lent @x 'b': list[int16]] -> lent @x list[int16] {
    return lend 'a';
}

MAIN {
    let 'v': int64 = 9223372036854775803;
    let 'w' := to.brain16['v'];
    let 'd' := to.useful.deci64['w'];
    let 'z' := to.int64['d'] otherwise -1;
    put_i['z'];
}
