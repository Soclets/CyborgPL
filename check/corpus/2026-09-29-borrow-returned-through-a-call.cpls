# Finding 2026-09-29 (by hand): a function hands back the borrow another call handed it,
# return first[lend 'a']. The oracle runs it (prints 2); CCA refuses it (`second` hands back
# a borrow: `return lend 'a';`, of one of its `lent` parameters). 46faa74: a returned borrow
# comes from a lent parameter in its group, and this one does, through first.
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
fn put_u ['m': uint64] {
    let mut 'buf': list[uint8] = [];
    let mut 'v': uint64 = 'm';
    let mut 'p': uint64 = 1;
    while 'v' div 'p' >/== 10 { change 'p' = 'p' x 10; }
    loop {
        list.append[lend.mut 'buf', to.uint8[48 + ('v' div 'p')]];
        change 'v' = 'v' mod 'p';
        if 'p' == 1 { break; }
        change 'p' = 'p' div 10;
    }
    list.append[lend.mut 'buf', 10];
    nocheck write[1, lend 'buf', list.length[lend 'buf']];
}

fn first [lent 'a': list[int32]] -> lent list[int32] { return lend 'a'; }
fn second [lent 'a': list[int32]] -> lent list[int32] { return first[lend 'a']; }

MAIN {
    let 's': list[int32] = [1, 2, 3];
    let 'r' := second[lend 's'];
    put_u[to.uint64['r'[2]]];
}
