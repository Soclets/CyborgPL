# Finding 2026-09-23 (generator seed 316, shrunk structurally): a check CCA refuses,
# 'divisor can be zero' on not.bit 'v2' with 'v2' in [-102, -96] across two loops.
# Fixed 2026-09-23 in CCA 0279bf8 (layer 2 widened at every busy block; no range for not.bit).
# env CHK_IN1 0
# env CHK_IN2 0
# check claude generator, seed 316
extern fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] -> int64;
extern fn getenv ['name': ptr[uint8]] -> ptr[uint8];
extern fn strlen ['s': ptr[uint8]] -> uint64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'ds': list[uint8] = [];
    loop {
        list.append[lend.mut 'ds', to.uint8[48 + ('v' mod 10)]];
        'v' = 'v' / 10;
        if 'v' == 0 { break; }
    }
    for 'k': uint64 in range[list.length[lend 'ds'], 1, -1] {
        list.append[lend.mut 'buf', 'ds'[pos 'k']];
    }
    list.append[lend.mut 'buf', 10];
    nocheck write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' >== 0 {
        emit[to.uint64['n'], false];
    } else {
        let 'up': int64 = -('n' + 1);
        emit[to.uint64['up'] + 1, true];
    }
}

MAIN {
    let 'in1_key' := "CHK_IN1";
    nocheck let 'in1': uint64 = strlen[getenv[lend 'in1_key']];
    let 'in2_key' := "CHK_IN2";
    nocheck let 'in2': uint64 = strlen[getenv[lend 'in2_key']];
    let immut 'v1': int64 = to.int64['in1' mod 9223372036854775808];
    let 'v2': int8 = (to.int8[('v1' mod 256) - 128] mod 7) - 102;
    let mut 'w3': int16 = 7;
    while 'w3' > 0 {
        'w3' = 'w3' - 1;
        for 'i4': uint16 in range[29, 3, -3] {
            check 'v2' = ((((126 or.bit 'v2') / (not.bit 'v2')) shl 6) mod 7) - 102;
        }
    }
}
