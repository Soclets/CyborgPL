# Finding 2026-10-05 (check run, seed 18003, cut down by hand): a deci128 holding 1e400 converted
# with `to.deci32['a'] otherwise -180.0`. A deci32 cannot hold it, so the conversion fails and the
# `otherwise` gives -180.0: the oracle prints -180000. The CCA binary stops instead: "check: the
# value is past what a `deci32` holds".
# check claude generator, seed 18003
extern.C fn write ['fd': int32, 'buf': ptr[uint8], 'len': uint64] --> int64;

fn emit ['m': uint64, 'neg': bool] {
    let mut 'buf': list[uint8] = [];
    if 'neg' { list.append[lend.mut 'buf', 45]; }
    let mut 'v': uint64 = 'm';
    let mut 'p': uint64 = 1;
    while 'v' div.floor 'p' >/== 10 {
        change 'p' = 'p' times 10;
    }
    loop {
        list.append[lend.mut 'buf', to.uint8[48 plus ('v' div.floor 'p')]];
        change 'v' = 'v' mod.floor 'p';
        if 'p' == 1 { break; }
        change 'p' = 'p' div.floor 10;
    }
    list.append[lend.mut 'buf', 10];
    nocheck write[1, lend 'buf', list.length[lend 'buf']];
}

fn put_u ['n': uint64] {
    emit['n', false];
}

fn put_i ['n': int64] {
    if 'n' < 0 {
        emit[to.uint64[0 minus ('n' plus 1)] plus 1, true];
    } else {
        emit[to.uint64['n'], false];
    }
}

MAIN {
    let 'a' := to.deci128["1e400"] otherwise -21.363;
    let 'b' := to.deci32['a'] otherwise -180.0;
    let 'z' := to.int64['b' times 1000] otherwise -1;
    put_i['z'];
}
