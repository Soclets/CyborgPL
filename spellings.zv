        spellings::old[written = "cord", write = ["std",], since = "2026-10-15"],
        spellings::old[written = "stdkit", write = ["std",], since = "2026-10-09"],
        spellings::old[written = "limb", write = ["strike",], since = "2026-10-09"],
        spellings::old[written = "neuron", write = ["strike",], since = "2026-10-15"],
        spellings::old[written = "cca::", write = ["ricochet::",], since = "2026-10-09", where = "special"],
        spellings::old[written = "kin::", write = ["ricochet::",], since = "2026-10-15", where = "special"],
        spellings::old[written = "cores", write = ["plugins",], since = "2026-10-09", where = "special"],
        spellings::old[written = "lobes", write = ["plugins",], since = "2026-10-15", where = "special"],
        spellings::old[written = "kin::Core", write = ["ricochet::plugin",], since = "2026-10-09", where = "special"],
        spellings::old[written = "case.insensitive", write = ["case.any",], since = "2026-10-10", where = "special"],
        spellings::old[written = "case.sensitive", write = ["case.exact",], since = "2026-10-10", where = "special"],
        spellings::old[written = "kin::Manifest", write = ["ricochet::manifest",], since = "2026-10-13", where = "special"],
        spellings::old[written = "kin::Target", write = ["ricochet::target",], since = "2026-10-13", where = "special"],
        spellings::old[written = "kin::Dep", write = ["ricochet::dep",], since = "2026-10-13", where = "special"],
        spellings::old[written = "kin::Lobe", write = ["ricochet::plugin",], since = "2026-10-13", where = "special"],
        spellings::old[written = "kin::Power", write = ["ricochet::power",], since = "2026-10-13", where = "special"],
        spellings::old[written = "kin::Installed", write = ["ricochet::installed",], since = "2026-10-13", where = "special"],
    ],
    not_operators = [
        spellings::not_operator[written = "<==", says = "less-or-equal is `at_most`", since = "2026-10-07"],
        spellings::not_operator[written = ">==", says = "greater-or-equal is `at_least`", since = "2026-10-07"],
    ],
    # every argument after the first says its role (owner, 2026-10-14): one word per argument, "" for none
    calls = [
        spellings::call[name = "list.append", words = [str.empty, "value",], example = "list.append[lend.mut 'xs', value 2]"],
        spellings::call[name = "map.get", words = [str.empty, "key",], example = "map.get[lend 'm', key \"ann\"]"],
        spellings::call[name = "map.has", words = [str.empty, "key",], example = "map.has[lend 'm', key \"ann\"]"],
        spellings::call[name = "map.remove", words = [str.empty, "key",], example = "map.remove[lend.mut 'm', key \"ann\"]"],
        spellings::call[name = "map.set", words = [str.empty, "key", "value",], example = "map.set[lend.mut 'm', key \"ann\", value 5551]"],
        spellings::call[name = "str.contains", words = [str.empty, "part",], example = "str.contains[lend 's', part \"ab\"]"],
        spellings::call[name = "str.starts_with", words = [str.empty, "part",], example = "str.starts_with[lend 's', part \"ab\"]"],
        spellings::call[name = "str.ends_with", words = [str.empty, "part",], example = "str.ends_with[lend 's', part \"ab\"]"],
        spellings::call[name = "str.find.grapheme", words = [str.empty, "part",], example = "str.find.grapheme[lend 's', part \"x\"]"],
        spellings::call[name = "str.find.point", words = [str.empty, "part",], example = "str.find.point[lend 's', part \"x\"]"],
        spellings::call[name = "str.find.byte", words = [str.empty, "part",], example = "str.find.byte[lend 's', part \"x\"]"],
        spellings::call[name = "str.split", words = [str.empty, "at",], example = "str.split[lend 's', at \",\"]"],
        spellings::call[name = "str.join", words = [str.empty, "between",], example = "str.join[lend 'parts', between \", \"]"],
        spellings::call[name = "str.replace", words = [str.empty, "from", "to",], example = "str.replace[lend 's', from \"a\", to \"b\"]"],
        spellings::call[name = "channel.send", words = [str.empty, "value",], example = "channel.send[lend 'ch', value 5]"],
        spellings::call[name = "ptr.at", words = [str.empty, "by",], example = "ptr.at['p', by 3]"],
        spellings::call[name = "ptr.write", words = [str.empty, "value",], example = "ptr.write['p', value 65]"],
        spellings::call[name = "simd.load.some", words = [str.empty, str.empty, "count",], example = "simd.load.some[lend 'xs', pos 1, count 3]"],
        spellings::call[name = "simd.store", words = [str.empty, str.empty, "value",], example = "simd.store[lend.mut 'xs', pos 1, value 'v']"],
        spellings::call[name = "simd.store.some", words = [str.empty, str.empty, "count", "value",], example = "simd.store.some[lend.mut 'xs', pos 1, count 3, value 'v']"],
    ],
    free_ops = [
        spellings::free_op[op = "^", hint = "power is std's `pow`"],
        spellings::free_op[op = "|", hint = "a bitwise or is `or.bit`, a logical one `or`"],
        spellings::free_op[op = "!", hint = "not is `not`"],
    ]
];
